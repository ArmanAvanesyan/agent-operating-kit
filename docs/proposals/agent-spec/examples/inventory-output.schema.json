{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Illustrative exploration inventory output",
  "type": "object",
  "required": [
    "scope",
    "entrypoints",
    "evidence",
    "limitations"
  ],
  "properties": {
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
