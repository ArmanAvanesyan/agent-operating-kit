{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aok.example/proposals/agent-spec/common.schema.json",
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "description"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "ref",
        "required"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "read",
            "write"
          ],
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "denied",
                "allowlist"
              ]
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "secrets": {
          "type": "object",
          "properties": {
            "mode": {
              "const": "references-only"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "externalMutations": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "denied",
                "explicit-authorization"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "properties": {
            "default": {
              "const": "deny"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision": {
                    "enum": [
                      "allow",
                      "require-authorization",
                      "deny"
                    ]
                  },
                  "enforcementOwner": {
                    "enum": [
                      "native",
                      "executor"
                    ]
                  }
                },
                "required": [
                  "action",
                  "resource",
                  "decision",
                  "enforcementOwner"
                ],
                "additionalProperties": false
              },
              "uniqueItems": true
            }
          },
          "required": [
            "default",
            "rules"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "filesystem",
        "network",
        "secrets",
        "externalMutations",
        "actions"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "field",
        "source",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
