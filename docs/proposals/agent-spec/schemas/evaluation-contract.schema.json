{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aok.example/proposals/agent-spec/evaluation-contract.schema.json",
  "title": "PROPOSED AOK evaluation-contract",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "aok/v1alpha1"
    },
    "kind": {
      "const": "EvaluationContract"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "taskPacket": {
            "type": "string",
            "minLength": 1
          },
          "datasetRevision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "taskPacket",
          "datasetRevision"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "unit",
          "direction",
          "threshold"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not-run",
              "passed",
              "failed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "profile",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "agent",
    "profiles",
    "fixtures",
    "metrics",
    "repetitions",
    "acceptance",
    "results"
  ],
  "additionalProperties": false
}
