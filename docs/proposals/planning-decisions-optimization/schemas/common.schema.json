{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aok.example/proposals/planning-decisions-optimization/common.schema.json",
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "description"
      ],
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verifierRef": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "verifierRef",
        "required"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplans": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxAttempts",
        "maxReplans",
        "timeoutSeconds"
      ],
      "additionalProperties": false
    }
  }
}
