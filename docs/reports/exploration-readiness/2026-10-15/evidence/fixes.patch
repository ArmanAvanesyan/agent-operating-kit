diff --git a/skills/project-exploration/scripts/structure.py b/skills/project-exploration/scripts/structure.py
index e8d1cfb..4f88f6f 100644
--- a/skills/project-exploration/scripts/structure.py
+++ b/skills/project-exploration/scripts/structure.py
@@ -8,0 +9 @@ import os
+import re
@@ -76,0 +78,18 @@ def run_bounded(argv: list[str], cwd: str, timeout: float = 10,
+def source_suffix(path: Path) -> str:
+    """Recognize extensionless Python/shell entrypoints without executing them."""
+    suffix = path.suffix.lower()
+    if suffix in SOURCE_EXTENSIONS:
+        return suffix
+    if suffix or path.name.startswith('.'):
+        raise ValueError('select a supported source file, not configuration or secrets')
+    with path.open('rb') as source:
+        first_line = source.readline(256)
+    if first_line.startswith(b'#!'):
+        interpreter = first_line.decode('utf-8', errors='replace')
+        if re.search(r'(?:/|\s)python(?:[0-9]+(?:\.[0-9]+)*)?(?:\s|$)', interpreter):
+            return '.py'
+        if re.search(r'(?:/|\s)(?:bash|sh)(?:\s|$)', interpreter):
+            return '.sh'
+    raise ValueError('extensionless source requires a recognized Python or shell shebang')
+
+
@@ -88,2 +107,2 @@ def selected_file(root: Path, relative: str, max_bytes: int) -> Path:
-    if not path.is_file() or path.suffix.lower() not in SOURCE_EXTENSIONS:
-        raise ValueError('select a supported source file, not configuration or secrets')
+    if not path.is_file():
+        raise ValueError('select a regular source file')
@@ -91,0 +111 @@ def selected_file(root: Path, relative: str, max_bytes: int) -> Path:
+    source_suffix(path)
@@ -116 +136 @@ def query(root: Path, relative: str, mode: str, pattern: str | None = None,
-        staged = Path(directory) / ('input' + path.suffix)
