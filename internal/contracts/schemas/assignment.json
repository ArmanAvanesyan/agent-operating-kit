{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aok.invalid/operational/assignment.json",
  "title": "PROPOSED AOK assignment",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "aok/v1alpha1"
    },
    "kind": {
      "const": "AgentAssignment"
    },
    "agent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Agent"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "taskPacket": {
      "type": "string",
      "minLength": 1
    },
    "executionProfile": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ExecutionProfile"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "$ref": "https://aok.invalid/operational/common.schema.json#/$defs/parameters"
    },
    "outputs": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "OutputContract"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            }
          },
          "required": [
            "kind",
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "$ref": "https://aok.invalid/operational/common.schema.json#/$defs/parameters"
        }
      },
      "required": [
        "contract"
      ],
      "additionalProperties": false
    },
    "permissionRestrictions": {
      "$ref": "https://aok.invalid/operational/common.schema.json#/$defs/permissions"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "agent",
    "taskPacket",
    "executionProfile",
    "inputs",
    "outputs",
    "metadata"
  ],
  "additionalProperties": false
}
