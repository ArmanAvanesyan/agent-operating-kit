{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aok.invalid/operational/execution-profile.json",
  "title": "PROPOSED AOK execution-profile",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "aok/v1alpha1"
    },
    "kind": {
      "const": "ExecutionProfile"
    },
    "metadata": {
      "$ref": "https://aok.invalid/operational/common.schema.json#/$defs/metadata"
    },
    "client": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "interface": {
          "enum": [
            "cli",
            "app",
            "api"
          ]
        },
        "versionConstraint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "adapter",
        "interface"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "provider-default",
                "effort",
                "budget",
                "model-variant",
                "disabled"
              ]
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "budgetTokens": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "effort"
                  }
                }
              },
              "then": {
                "required": [
                  "effort"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "budget"
                  }
                }
              },
              "then": {
                "required": [
                  "budgetTokens"
                ]
              }
            }
          ]
        },
        "generation": {
          "type": "object",
          "properties": {
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "topP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "selector",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "unsupportedSettings": {
          "const": "error"
        }
      },
      "required": [
        "unsupportedSettings"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxCost": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "const": "USD"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "EnvironmentProfile"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            }
          },
          "required": [
            "kind",
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "client",
    "model",
    "compatibility",
    "environment"
  ],
  "additionalProperties": false
}
