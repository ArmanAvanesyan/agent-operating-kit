{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aok.invalid/operational/output-contract.json",
  "title": "PROPOSED AOK output-contract",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "aok/v1alpha1"
    },
    "kind": {
      "const": "OutputContract"
    },
    "metadata": {
      "$ref": "https://aok.invalid/operational/common.schema.json#/$defs/metadata"
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "markdown",
              "json",
              "text"
            ]
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "requiredSections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "format",
          "destination",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "evidenceReferences": {
          "enum": [
            "must-resolve",
            "not-required"
          ]
        },
        "missingRequiredDeliverable": {
          "const": "fail"
        }
      },
      "required": [
        "evidenceReferences",
        "missingRequiredDeliverable"
      ],
      "additionalProperties": false
    },
    "resultSchema": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "deliverables",
    "validation",
    "resultSchema"
  ],
  "additionalProperties": false
}
