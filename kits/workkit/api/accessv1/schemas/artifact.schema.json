{
  "$id": "https://workkit.example/spec/access/v1/artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "executable": {
      "type": "string"
    },
    "executableSha256": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "maxBytes": {
      "type": "integer"
    },
    "platform": {
      "type": "string"
    },
    "redirectOrigins": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "sha256": {
      "type": "string"
    },
    "toolId": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "versionOutput": {
      "type": "string"
    }
  },
  "required": [
    "redirectOrigins",
    "executableSha256",
    "toolId",
    "toolVersion",
    "platform",
    "url",
    "sha256",
    "format",
    "executable",
    "maxBytes",
    "versionOutput"
  ],
  "type": "object"
}
