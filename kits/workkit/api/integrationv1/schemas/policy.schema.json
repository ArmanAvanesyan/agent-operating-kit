{
  "$id": "https://workkit.example/spec/workkit-integration/v1/policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedPurposes": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "expiresAt": {
      "type": "string"
    },
    "issuers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "publicKey"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "captureBytes": {
          "type": "integer"
        },
        "cycleSeconds": {
          "type": "integer"
        },
        "inboxBytes": {
          "type": "integer"
        },
        "items": {
          "type": "integer"
        },
        "jitterSeconds": {
          "type": "integer"
        },
        "maxHints": {
          "type": "integer"
        },
        "maxOperations": {
          "type": "integer"
        },
        "pollSeconds": {
          "type": "integer"
        },
        "processSeconds": {
          "type": "integer"
        },
        "requestSeconds": {
          "type": "integer"
        },
        "requests": {
          "type": "integer"
        },
        "responseBytes": {
          "type": "integer"
        }
      },
      "required": [
        "pollSeconds",
        "jitterSeconds",
        "processSeconds",
        "cycleSeconds",
        "requestSeconds",
        "requests",
        "items",
        "responseBytes",
        "captureBytes",
        "maxOperations",
        "maxHints",
        "inboxBytes"
      ],
      "type": "object"
    },
    "notBefore": {
      "type": "string"
    },
    "revokedIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "routes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": [
        "object",
        "null"
      ]
    },
    "store": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "kind",
        "path",
        "id",
        "namespace",
        "owner"
      ],
      "type": "object"
    },
    "version": {
      "const": "workkit-integration/v1"
    }
  },
  "required": [
    "limits",
    "routes",
    "version",
    "kind",
    "notBefore",
    "expiresAt",
    "issuers",
    "revokedIds",
    "allowedPurposes",
    "store"
  ],
  "type": "object"
}
