{
  "$id": "https://workkit.example/spec/native/v1/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "disposition": {
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "callId": {
            "type": "string"
          },
          "data": {},
          "id": {
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          },
          "scope": {
            "additionalProperties": false,
            "properties": {
              "assignmentSha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "attemptId": {
                "type": "string"
              },
              "deployment": {
                "type": "string"
              },
              "fence": {
                "type": "string"
              },
              "host": {
                "enum": [
                  "codex",
                  "claude-code",
                  "cursor",
                  "opencode",
                  "antigravity"
                ],
                "type": "string"
              },
              "hostVersion": {
                "type": "string"
              },
              "mappingSha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "mode": {
                "enum": [
                  "native-only",
                  "managed"
                ],
                "type": "string"
              },
              "origin": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "principal": {
                "type": "string"
              },
              "profileSha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "protocol": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              },
              "workspace": {
                "type": "string"
              }
            },
            "required": [
              "host",
              "hostVersion",
              "protocol",
              "deployment",
              "origin",
              "principal",
              "workspace",
              "sessionId",
              "owner",
              "assignmentSha256",
              "profileSha256",
              "mappingSha256",
              "mode"
            ],
            "type": "object"
          },
          "sequence": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sequence",
          "observedAt",
          "scope",
          "type",
          "data"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "CapturedNativeEvidence"
      ]
    },
    "observedAt": {
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "assignmentSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "deployment": {
          "type": "string"
        },
        "fence": {
          "type": "string"
        },
        "host": {
          "enum": [
            "codex",
            "claude-code",
            "cursor",
            "opencode",
            "antigravity"
          ],
          "type": "string"
        },
        "hostVersion": {
          "type": "string"
        },
        "mappingSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "mode": {
          "enum": [
            "native-only",
            "managed"
          ],
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "profileSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "hostVersion",
        "protocol",
        "deployment",
        "origin",
        "principal",
        "workspace",
        "sessionId",
        "owner",
        "assignmentSha256",
        "profileSha256",
        "mappingSha256",
        "mode"
      ],
      "type": "object"
    },
    "version": {
      "const": "workkit-native/v1"
    }
  },
  "required": [
    "version",
    "kind",
    "scope",
    "observedAt",
    "complete",
    "events"
  ],
  "type": "object"
}
