{
  "$id": "https://workkit.example/spec/operations/v1/capability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticationMode": {
      "type": "string"
    },
    "concurrency": {
      "type": "string"
    },
    "configurationSha256": {
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "fieldRoles": {
      "additionalProperties": {
        "type": "string"
      },
      "type": [
        "object",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "observedAt": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "qualification": {
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "basePath": {
          "type": "string"
        },
        "containerId": {
          "type": "string"
        },
        "deploymentSha256": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "origin",
        "basePath",
        "tenantId",
        "containerId",
        "apiVersion",
        "deploymentSha256",
        "principal"
      ],
      "type": "object"
    },
    "supported": {
      "type": "boolean"
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "authMode": {
          "type": "string"
        },
        "executableSha256": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version",
        "executableSha256",
        "principal",
        "authMode"
      ],
      "type": "object"
    },
    "version": {
      "const": "workkit-operations/v1"
    }
  },
  "required": [
    "fieldRoles",
    "authenticationMode",
    "configurationSha256",
    "transport",
    "version",
    "kind",
    "scope",
    "operation",
    "supported",
    "concurrency",
    "qualification",
    "observedAt",
    "evidence"
  ],
  "type": "object"
}
