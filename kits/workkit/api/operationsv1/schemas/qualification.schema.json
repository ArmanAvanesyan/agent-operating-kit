{
  "$id": "https://workkit.example/spec/operations/v1/qualification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizationGranted": {
      "const": false
    },
    "diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "message",
          "severity"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "executionReady": {
      "const": false
    },
    "implementationSha256": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "provided": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": [
        "object",
        "null"
      ]
    },
    "required": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "basePath": {
          "type": "string"
        },
        "containerId": {
          "type": "string"
        },
        "deploymentSha256": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "origin",
        "basePath",
        "tenantId",
        "containerId",
        "apiVersion",
        "deploymentSha256",
        "principal"
      ],
      "type": "object"
    },
    "status": {
      "type": "string"
    },
    "version": {
      "const": "workkit-operations/v1"
    }
  },
  "required": [
    "version",
    "kind",
    "scope",
    "operation",
    "implementationSha256",
    "required",
    "provided",
    "status",
    "diagnostics",
    "authorizationGranted",
    "executionReady"
  ],
  "type": "object"
}
