{
  "$id": "https://workkit.example/spec/setup/v1/mapping-context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "destinationContainerId": {
      "type": "string"
    },
    "destinationSha256": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "mappingSha256": {
      "type": "string"
    },
    "requiredFields": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
