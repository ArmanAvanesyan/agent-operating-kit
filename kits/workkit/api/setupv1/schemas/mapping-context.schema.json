    "sourceContainerId": {
      "type": "string"
    },
    "sourceSha256": {
      "type": "string"
    },
    "version": {
      "const": "workkit-setup/v1"
    }
  },
  "required": [
    "version",
    "kind",
    "mappingSha256",
    "sourceSha256",
    "destinationSha256",
