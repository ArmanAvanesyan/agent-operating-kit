{
  "$id": "https://workkit.example/spec/setup/v1/policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedScopes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "basePath": {
            "type": "string"
          },
          "containerId": {
            "type": "string"
          },
          "deploymentSha256": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "origin",
          "basePath",
          "tenantId",
          "containerId",
          "apiVersion",
          "deploymentSha256",
          "principal"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "expiresAt": {
      "type": "string"
    },
    "issuers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "publicKey"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "maxAgeSeconds": {
      "type": "integer"
    },
    "notBefore": {
      "type": "string"
    },
    "revokedIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "version": {
      "const": "workkit-setup/v1"
    }
  },
  "required": [
    "version",
    "kind",
    "notBefore",
    "expiresAt",
    "maxAgeSeconds",
    "issuers",
    "revokedIds",
    "allowedScopes"
  ],
  "type": "object"
}
