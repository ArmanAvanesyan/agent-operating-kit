{
  "$id": "https://workkit.example/spec/sync/v1/sync-invocation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "enrollment": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          }
        },
        "required": [
          "plan",
          "policy",
          "enrollment",
          "output"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "planSha256": {
      "type": "string"
    },
    "version": {
      "const": "workkit-sync/v1"
    }
  },
  "required": [
    "version",
    "kind",
    "planSha256",
    "operations"
  ],
  "type": "object"
}
