{
  "$id": "https://workkit.example/spec/sync/v1/sync-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baselines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confirmedOperationId": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "destination": {
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "boolean"
              },
              "value": {}
            },
            "required": [
              "present",
              "value"
            ],
            "type": "object"
          },
          "field": {
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "boolean"
              },
              "value": {}
            },
            "required": [
              "present",
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "correlationId",
          "field",
          "source",
          "destination",
          "confirmedOperationId"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "completedWatermark": {
      "type": "string"
    },
    "initialized": {
      "type": "boolean"
    },
    "kind": {
      "type": "string"
    },
    "paused": {
      "type": "boolean"
    },
    "pendingPlanSha256": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "routeSha256": {
      "type": "string"
    },
    "unresolved": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "version": {
      "const": "workkit-sync/v1"
    }
  },
  "required": [
    "version",
    "kind",
    "routeSha256",
    "revision",
    "initialized",
    "paused",
    "baselines",
    "pendingPlanSha256",
    "completedWatermark",
    "unresolved"
