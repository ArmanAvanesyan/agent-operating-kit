{
  "$id": "https://workkit.example/spec/workkit-sync/v2/sync-resolution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choices": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "choice": {
            "type": "string"
          },
          "conflictId": {
            "type": "string"
          }
        },
        "required": [
          "conflictId",
          "choice"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": [
        "array",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "planSha256": {
      "type": "string"
    },
    "version": {
      "const": "workkit-sync/v2"
    }
  },
  "required": [
    "version",
    "kind",
    "planSha256",
    "choices"
  ],
  "type": "object"
}
