{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workkit.example/spec/v1alpha1/sync-checkpoint.schema.json",
  "title": "SyncCheckpoint",
  "description": "Proposed structural contract; semantic validation and authority are separate.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "workkit/v1alpha1"
    },
    "kind": {
      "const": "SyncCheckpoint"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "routeSha256": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/sha"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/asset"
        },
        "correlations": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/asset"
        },
        "watermark": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "observedAt": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/time"
        }
      },
      "required": [
        "routeSha256",
        "cursor",
        "baseline",
        "correlations",
        "watermark",
        "complete",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
