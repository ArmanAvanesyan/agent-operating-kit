{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workkit.example/spec/v1alpha1/toolchain-lock.schema.json",
  "title": "ToolchainLock",
  "description": "Proposed structural contract; semantic validation and authority are separate.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "workkit/v1alpha1"
    },
    "kind": {
      "const": "ToolchainLock"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "toolId": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/sha"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/time"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "toolId",
        "version",
        "platform",
        "executable",
        "sha256",
        "source",
        "observedAt",
        "extensions"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
