{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workkit.example/spec/v1alpha1/toolchain-policy.schema.json",
  "title": "ToolchainPolicy",
  "description": "Proposed structural contract; semantic validation and authority are separate.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "workkit/v1alpha1"
    },
    "kind": {
      "const": "ToolchainPolicy"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "versionConstraint": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": [
                  "existing",
                  "user",
                  "system"
                ]
              }
            },
            "required": [
              "id",
              "source",
              "versionConstraint",
              "scope"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "allowCommunity": {
          "type": "boolean"
        }
      },
      "required": [
        "tools",
        "allowCommunity"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
