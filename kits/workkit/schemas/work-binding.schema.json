{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workkit.example/spec/v1alpha1/work-binding.schema.json",
  "title": "WorkBinding",
  "description": "Proposed structural contract; semantic validation and authority are separate.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "workkit/v1alpha1"
    },
    "kind": {
      "const": "WorkBinding"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "connectionRef": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/ref"
        },
        "mappingRef": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/ref"
        },
        "scope": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/scope"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "verified",
            "stale",
            "blocked"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "satisfied",
                  "missing",
                  "mismatched",
                  "unknown"
                ]
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/asset"
          }
        }
      },
      "required": [
        "connectionRef",
        "mappingRef",
        "scope",
        "status",
        "checks",
        "evidence"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
