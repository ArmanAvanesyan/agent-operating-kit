{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workkit.example/spec/v1alpha1/workspace.schema.json",
  "title": "Workspace",
  "description": "Proposed structural contract; semantic validation and authority are separate.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "workkit/v1alpha1"
    },
    "kind": {
      "const": "Workspace"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/ref"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/ref"
          }
        },
        "syncRoutes": {
          "type": "array",
          "items": {
            "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/ref"
          }
        },
        "nativeProfiles": {
          "type": "array",
          "items": {
            "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/ref"
          }
        }
      },
      "required": [
        "connections",
        "bindings",
        "syncRoutes",
        "nativeProfiles"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://workkit.example/spec/v1alpha1/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
