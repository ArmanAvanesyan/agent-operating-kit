# Homebrew formula template for Agent Operating Kit (`aok`).
# Regenerated by scripts/packaging/generate-from-release.sh from GitHub Release
# SHA256SUMS / index.json.
class Aok < Formula
  desc "Cross-tool agent operating kit CLI"
  homepage "https://github.com/ArmanAvanesyan/agent-operating-kit"
  version "{{VERSION}}"
  license "MIT"

  on_arm do
    url "{{DARWIN_ARM64_URL}}"
    sha256 "{{DARWIN_ARM64_SHA256}}"
  end

  on_intel do
    url "{{DARWIN_AMD64_URL}}"
    sha256 "{{DARWIN_AMD64_SHA256}}"
  end

  def install
    binary = Hardware::CPU.arm? ? "aok-#{version}-darwin-arm64" : "aok-#{version}-darwin-amd64"
    bin.install binary => "aok"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/aok version")
  end
end
