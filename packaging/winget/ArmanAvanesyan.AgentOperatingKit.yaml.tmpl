# winget manifest package (single-file style template).
# Split into Version/Installer/Locale manifests when opening a winget-pkgs PR.
# Placeholders: {{VERSION}} {{WINDOWS_AMD64_URL}} {{WINDOWS_AMD64_SHA256}} {{PUBLISHER}} {{PACKAGE_ID}}
PackageIdentifier: {{PACKAGE_ID}}
PackageVersion: {{VERSION}}
PackageLocale: en-US
Publisher: {{PUBLISHER}}
PublisherUrl: https://github.com/ArmanAvanesyan/agent-operating-kit
PackageName: Agent Operating Kit
PackageUrl: https://github.com/ArmanAvanesyan/agent-operating-kit
License: MIT
ShortDescription: Cross-tool agent operating kit CLI (aok)
Moniker: aok
Tags:
  - cli
  - agents
  - codex
Installers:
  - Architecture: x64
    InstallerType: portable
    InstallerUrl: {{WINDOWS_AMD64_URL}}
    InstallerSha256: {{WINDOWS_AMD64_SHA256}}
    Commands:
      - aok
ManifestType: singleton
ManifestVersion: 1.6.0
