{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/attempt-reference-check.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "attempt-reference-check"
    },
    "reference": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "environment": {
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "task_id",
        "worker",
        "revision",
        "tree",
        "environment"
      ],
      "additionalProperties": false
    },
    "live_lease_verified": {
      "const": false
    },
    "managed_finish_supported": {
      "enum": [
        false,
        null
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "reference",
    "live_lease_verified",
    "managed_finish_supported"
  ],
  "additionalProperties": false
}
