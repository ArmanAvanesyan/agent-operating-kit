{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/backlog-plan.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "backlog-plan"
    },
    "repository": {
      "type": "string"
    },
    "github_repository": {
      "type": "string"
    },
    "baseline_revision": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "implementation",
              "research",
              "adr",
              "roadmap"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "expected"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issue_number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "action": {
            "enum": [
              "create",
              "update",
              "reuse"
            ]
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "title",
          "summary",
          "acceptance_criteria",
          "evidence",
          "depends_on",
          "issue_number",
          "action",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "repository",
    "github_repository",
    "baseline_revision",
    "snapshot_sha256",
    "sources",
    "items",
    "plan_sha256"
  ],
  "additionalProperties": false
}
