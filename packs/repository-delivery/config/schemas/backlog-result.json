{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/backlog-result.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "backlog-result"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "github_repository": {
      "type": "string"
    },
    "issues": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "plan_sha256",
    "github_repository",
    "issues"
  ],
  "additionalProperties": false
}
