{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/checkpoint.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "checkpoint"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "inventory"
        },
        "repository": {
          "type": "string"
        },
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          }
        },
        "status_base64": {
          "type": "string"
        },
        "worktrees_base64": {
          "type": "string"
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "repository",
        "head",
        "branch",
        "refs",
        "status_base64",
        "worktrees_base64",
        "ignored"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "missing"
              }
            },
            "required": [
              "path",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "file"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            },
            "required": [
              "path",
              "type",
              "sha256",
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "symlink"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "type",
              "sha256",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "included_ignored": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "excluded_ignored": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "inventory",
    "files",
    "included_ignored",
    "excluded_ignored",
    "artifacts"
  ],
  "additionalProperties": false
}
