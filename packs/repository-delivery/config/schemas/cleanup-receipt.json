{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/cleanup-receipt.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "cleanup-receipt"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "plan_sha256",
    "completed"
  ],
  "additionalProperties": false
}
