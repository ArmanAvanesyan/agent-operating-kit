{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/comparison.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "comparison"
    },
    "repository": {
      "type": "string"
    },
    "baseline_revision": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "state": {
            "enum": [
              "identical",
              "modified",
              "deleted",
              "local-only",
              "local-missing"
            ]
          }
        },
        "required": [
          "path",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "repository",
    "baseline_revision",
    "snapshot_sha256",
    "files"
  ],
  "additionalProperties": false
}
