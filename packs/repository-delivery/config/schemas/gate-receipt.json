{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/gate-receipt.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "gate-receipt"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "git": {
          "type": "string"
        },
        "selected_variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "platform",
        "python",
        "git",
        "selected_variables"
      ],
      "additionalProperties": false
    },
    "source_unchanged": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "returncode": {
            "type": "integer"
          },
          "timed_out": {
            "type": "boolean"
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "argv",
          "returncode",
          "timed_out",
          "stdout_sha256",
          "stderr_sha256",
          "duration_seconds"
        ],
        "additionalProperties": false
      }
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "context_sha256",
    "snapshot_sha256",
    "environment",
    "source_unchanged",
    "passed",
    "results",
    "receipt_sha256"
  ],
  "additionalProperties": false
}
