{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/hook-check.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "hook-check"
    },
    "repository": {
      "type": "string"
    },
    "ready": {
      "const": true
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "remote_review_verified": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "repository",
    "ready",
    "snapshot_sha256",
    "remote_review_verified"
  ],
  "additionalProperties": false
}
