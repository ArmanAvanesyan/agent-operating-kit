{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/source-snapshot.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "source-snapshot"
    },
    "repository": {
      "type": "string"
    },
    "head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "missing"
              }
            },
            "required": [
              "path",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "file"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            },
            "required": [
              "path",
              "type",
              "sha256",
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "symlink"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "type",
              "sha256",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "included_ignored": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "repository",
    "head",
    "index_sha256",
    "files",
    "included_ignored",
    "snapshot_sha256"
  ],
  "additionalProperties": false
}
