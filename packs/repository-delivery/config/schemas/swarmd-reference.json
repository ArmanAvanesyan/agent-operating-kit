{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-delivery.local/schemas/swarmd-reference.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "swarmd-reference"
    },
    "reference": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "environment": {
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "task_id",
        "worker",
        "revision",
        "tree",
        "environment"
      ],
      "additionalProperties": false
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_state": {
      "enum": [
        "recorded",
        "complete",
        "failed"
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "read_task": {
          "const": true
        },
        "managed_finish": {
          "enum": [
            false,
            null
          ]
        }
      },
      "required": [
        "read_task",
        "managed_finish"
      ],
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "reference",
    "export_sha256",
    "observed_state",
    "capabilities",
    "gaps"
  ],
  "additionalProperties": false
}
