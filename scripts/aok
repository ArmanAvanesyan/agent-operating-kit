def validate_json_files(errors: list[str]) -> None:
    for rel in (".codex-plugin/plugin.json", "hooks.json", "templates/.codex/aok-local-environment.json"):
        require_json(KIT_ROOT / rel, errors)
    for path in sorted((KIT_ROOT / "schemas").glob("*.schema.json")):
        data = require_json(path, errors)
        if not data:
            continue
        for key in ("$schema", "title", "type"):
            if key not in data:
                errors.append(f"{path.relative_to(KIT_ROOT)}: missing {key}")
    for path in sorted((KIT_ROOT / "core" / "examples").glob("*.json")):
        data = require_json(path, errors)
        if not data:
            continue
        if not data.get("kind") and path.name != "task-packet.example.json":
            errors.append(f"{path.relative_to(KIT_ROOT)}: missing kind")
    for path in sorted((KIT_ROOT / "packs").glob("*/*/pack.content.json")):
        data = require_json(path, errors)
        if not data:
            continue
        if data.get("kind") != "pack-content":
            errors.append(f"{path.relative_to(KIT_ROOT)}: expected kind pack-content")


def validate_adapters(errors: list[str]) -> None:
    seen: set[str] = set()
    for target in SUPPORTED_TARGETS:
        base = KIT_ROOT / "adapters" / target
        readme = base / "README.md"
        manifest = base / "adapter.json"
        if not readme.exists():
            errors.append(f"{readme.relative_to(KIT_ROOT)}: missing")
        data = require_json(manifest, errors)
        if not data:
            continue
        seen.add(str(data.get("name", "")))
        required = ["name", "kind", "displayName", "status", "supportedTargets", "renders"]
        for key in required:
            if key not in data:
                errors.append(f"{manifest.relative_to(KIT_ROOT)}: missing {key}")
        if data.get("status") == "active":
            for key in ("supportLevel", "bundle"):
                if key not in data:
                    errors.append(f"{manifest.relative_to(KIT_ROOT)}: active adapter missing {key}")
            bundle = data.get("bundle")
            if isinstance(bundle, dict):
                for key in ("artifactName", "format", "importInstructions"):
                    if key not in bundle:
                        errors.append(f"{manifest.relative_to(KIT_ROOT)}: bundle missing {key}")
        if data.get("name") != target:
            errors.append(f"{manifest.relative_to(KIT_ROOT)}: name must be {target}")
        if data.get("kind") != "tool-adapter":
            errors.append(f"{manifest.relative_to(KIT_ROOT)}: kind must be tool-adapter")
    missing_targets = set(SUPPORTED_TARGETS) - seen
    if missing_targets:
        errors.append(f"adapters: missing manifests for {', '.join(sorted(missing_targets))}")


def validate_packs(errors: list[str]) -> None:
    expected = {
        "engineering-guardrails",
        "ship-pipeline",
        "phased-rollout-template",
        "batch-resolve-conflicts",
        "repository-delivery",
    }
    pack_root = KIT_ROOT / "packs"
    found = {path.name for path in pack_root.glob("*") if path.is_dir()} if pack_root.exists() else set()
    for name in sorted(expected - found):
        errors.append(f"packs/{name}: missing")
    for name in sorted(expected & found):
        base = pack_root / name
        if not (base / "README.md").exists():
            errors.append(f"packs/{name}/README.md: missing")
        data = require_json(base / "pack.json", errors)
        if not data:
            continue
        for key in (
            "name",
            "kind",
            "description",
            "sourceRepo",
            "neutralContent",
            "supportedTargets",
            "concepts",
            "adapters",
            "sourceRefs",
            "targetRender",
            "conceptGraph",
        ):
            if key not in data:
                errors.append(f"packs/{name}/pack.json: missing {key}")
        if data.get("name") != name:
            errors.append(f"packs/{name}/pack.json: name must be {name}")
        if data.get("kind") != "pack":
            errors.append(f"packs/{name}/pack.json: kind must be pack")
        if "skillRoot" in data and not _valid_skill_root(base, data["skillRoot"]):
            errors.append(f"packs/{name}/pack.json: skillRoot must be a safe relative path to a directory")

        targets = data.get("supportedTargets")
        if isinstance(targets, list):
            expected_targets = set(SUPPORTED_TARGETS)
            present = set(targets)
            if present != expected_targets:
                errors.append(
                    f"packs/{name}/pack.json: supportedTargets must include exactly {', '.join(sorted(expected_targets))}"
                )

        neutral_content = data.get("neutralContent", "pack.content.json")
        content_path = base / neutral_content
        content = require_json(content_path, errors)
        if not content:
            errors.append(f"packs/{name}/pack.json: missing neutral content {neutral_content}")
            continue
        if content.get("name") != name:
            errors.append(f"packs/{name}/pack.content.json: name must be {name}")

        target_render = data.get("targetRender")
        if not isinstance(target_render, dict):
            errors.append(f"packs/{name}/pack.json: targetRender must be an object")
        else:
            for target in SUPPORTED_TARGETS:
                if target not in target_render:
                    errors.append(f"packs/{name}/pack.json: missing targetRender[{target}]")
                    continue
                render = target_render[target]
                if not isinstance(render, dict):
                    errors.append(f"packs/{name}/pack.json: targetRender[{target}] must be object")
                    continue
                for key in ("status", "mode"):
                    if key not in render:
                        errors.append(f"packs/{name}/pack.json: targetRender[{target}] missing {key}")
                if render.get("status") == "active":
                    for key in ("supportLevel", "artifactName", "packageFormat", "importInstructions", "bundleRefs"):
                        if key not in render:
                            errors.append(f"packs/{name}/pack.json: targetRender[{target}] active render missing {key}")
                mode = render.get("mode")
                sources = render.get("sourceRefs", [])
                payload = render.get("payload")
                if mode == "source":
                    if not isinstance(sources, list) or not sources:
                        errors.append(f"packs/{name}/pack.json: targetRender[{target}] mode=source needs sourceRefs")
                    else:
                        for rel in sources:
                            if not isinstance(rel, str) or (not (base / rel).exists() and not (rel == "." and data.get("skillRoot") and base.is_dir())):
                                errors.append(
                                    f"packs/{name}/pack.json: targetRender[{target}] sourceRefs missing {rel}"
                                )
                elif mode in ("inline", "generated"):
                    if payload is None and mode == "inline":
                        errors.append(f"packs/{name}/pack.json: targetRender[{target}] mode=inline needs payload")
                elif mode == "manual":
                    pass
                elif mode == "unsupported":
                    pass
                else:
                    errors.append(
                        f"packs/{name}/pack.json: targetRender[{target}] has unsupported mode {mode}"
                    )

        source_refs = data.get("sourceRefs")
        if not isinstance(source_refs, dict):
            errors.append(f"packs/{name}/pack.json: sourceRefs must be an object")
        else:
            for rel in source_refs.values():
                if not isinstance(rel, list):
                    continue
                for source in rel:
                    if not isinstance(source, str):
                        continue
                    if not (base / source).exists() and not (source == "." and data.get("skillRoot") and base.is_dir()):
                        errors.append(f"packs/{name}/pack.json: sourceRef {source} missing")
        concept_graph = data.get("conceptGraph", {})
        if not isinstance(concept_graph, dict):
            errors.append(f"packs/{name}/pack.json: conceptGraph must be object")
        else:
            for section in ("roles", "hooks", "skills", "templates", "taskPackets"):
                if section not in concept_graph:
                    continue
                if not isinstance(concept_graph[section], list):
                    errors.append(f"packs/{name}/pack.json: conceptGraph.{section} must be array")

            for target in ("roles", "hooks", "skills", "templates", "taskPackets"):
                declared = concept_graph.get(target, [])
                if not isinstance(declared, list):
                    continue
                content_items = content.get(target, [])
                if not isinstance(content_items, list):
                    continue
                content_ids = {item.get("id") for item in content_items if isinstance(item, dict) and item.get("id")}
                missing = [item for item in declared if item not in content_ids]
                if missing:
                    errors.append(
                        f"packs/{name}/pack.json: conceptGraph.{target} references missing ids: {', '.join(missing)}"
                    )

        for adapter_name, adapter in (data.get("adapters") or {}).items():
            plugin_path = adapter.get("pluginPath")
            readme_path = adapter.get("readmePath")
            for rel in (plugin_path, readme_path):
                if rel and not (base / rel).exists():
                    errors.append(f"packs/{name}/pack.json: missing adapter asset {rel}")
            for rel in adapter.get("assets", []):
                if not (base / rel).exists():
                    errors.append(f"packs/{name}/pack.json: missing adapter asset {rel}")
            if adapter_name not in SUPPORTED_TARGETS:
                errors.append(f"packs/{name}/pack.json: unknown adapter {adapter_name}")


def _valid_skill_root(base: Path, rel: object) -> bool:
    if not isinstance(rel, str) or not re.fullmatch(r"[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*", rel) or any(part in (".", "..") for part in rel.split("/")):
        return False
    path = Path(rel)
    if path.is_absolute() or ".." in path.parts:
        return False
    current = base
    for part in path.parts:
        current = current / part
        if current.is_symlink() or not current.exists():
            return False
    return current.is_dir()


def validate_methodologies(errors: list[str]) -> None:
    profile_root = METHODOLOGY_ROOT / "profiles"
    expected_ids = {"kanban", "fdd", "dsdm", "aup", "xp", "lean", "am"}
    profiles: dict[str, dict] = {}
    for path in sorted(profile_root.glob("*.json")) if profile_root.exists() else []:
        data = require_json(path, errors)
        if not data:
            continue
        profile_id = data.get("id")
        if not isinstance(profile_id, str) or not profile_id:
            errors.append(f"{path.relative_to(KIT_ROOT)}: missing id")
            continue
        if profile_id in profiles:
            errors.append(f"methodologies: duplicate profile id {profile_id}")
            continue
        profiles[profile_id] = data
        allowed_keys = {
            "id",
            "kind",
            "displayName",
            "description",
            "supportLevel",
            "order",
            "default",
            "fragment",
            "requiredInputs",
            "hookExpectations",
            "roleEmphasis",
            "compatibleFlows",
            "lifecycle",
            "featureContract",
            "requirementContract",
            "iterationContract",
            "roleCatalog",
            "artifactCatalog",
            "ceremonies",
            "gates",
            "phaseMappings",
        }
        for key in sorted(set(data) - allowed_keys):
            errors.append(f"{path.relative_to(KIT_ROOT)}: unexpected property {key}")
        if path.stem != profile_id:
            errors.append(f"{path.relative_to(KIT_ROOT)}: filename must match id {profile_id}")
        if re.fullmatch(r"[a-z0-9][a-z0-9-]*", profile_id) is None:
            errors.append(f"{path.relative_to(KIT_ROOT)}: invalid profile id {profile_id}")
        for key in (
            "kind",
            "displayName",
            "description",
            "supportLevel",
            "order",
            "fragment",
            "requiredInputs",
            "hookExpectations",
            "roleEmphasis",
            "compatibleFlows",
            "lifecycle",
            "featureContract",
            "requirementContract",
            "iterationContract",
            "roleCatalog",
            "artifactCatalog",
            "ceremonies",
            "gates",
            "phaseMappings",
        ):
            if key not in data:
                errors.append(f"{path.relative_to(KIT_ROOT)}: missing {key}")
        kind = data.get("kind")
        support = data.get("supportLevel")
        if not isinstance(data.get("displayName"), str) or not data.get("displayName"):
            errors.append(f"{path.relative_to(KIT_ROOT)}: displayName must be a non-empty string")
        if not isinstance(data.get("description"), str) or not data.get("description"):
            errors.append(f"{path.relative_to(KIT_ROOT)}: description must be a non-empty string")
        if not isinstance(data.get("order"), int) or isinstance(data.get("order"), bool):
            errors.append(f"{path.relative_to(KIT_ROOT)}: order must be an integer")
        if "default" in data and not isinstance(data.get("default"), bool):
            errors.append(f"{path.relative_to(KIT_ROOT)}: default must be boolean")
        if kind not in ("flow", "overlay"):
            errors.append(f"{path.relative_to(KIT_ROOT)}: invalid kind {kind}")
        if support not in ("active", "scaffolded", "planned"):
            errors.append(f"{path.relative_to(KIT_ROOT)}: invalid supportLevel {support}")
        fragment = data.get("fragment")
        if support == "active":
            if not isinstance(fragment, str) or not fragment:
                errors.append(f"{path.relative_to(KIT_ROOT)}: active profile needs fragment")
            else:
                fragment_path = (METHODOLOGY_ROOT / fragment).resolve()
                try:
                    fragment_path.relative_to(METHODOLOGY_ROOT.resolve())
                except ValueError:
                    errors.append(f"{path.relative_to(KIT_ROOT)}: fragment escapes methodology root")
                else:
                    if not fragment_path.exists():
                        errors.append(f"{path.relative_to(KIT_ROOT)}: missing fragment {fragment}")
        elif fragment is not None:
            errors.append(f"{path.relative_to(KIT_ROOT)}: non-active profile fragment must be null")
        for key in ("requiredInputs", "hookExpectations", "roleEmphasis", "compatibleFlows"):
            values = data.get(key)
            if not isinstance(values, list) or not all(isinstance(item, str) and item for item in values):
                errors.append(f"{path.relative_to(KIT_ROOT)}: {key} must be an array of strings")
            elif len(values) != len(set(values)):
                errors.append(f"{path.relative_to(KIT_ROOT)}: {key} must contain unique values")
        for key in ("ceremonies", "gates", "phaseMappings"):
            if not isinstance(data.get(key), list):
                errors.append(f"{path.relative_to(KIT_ROOT)}: {key} must be an array")
        lifecycle = data.get("lifecycle")
        if support == "scaffolded" and kind == "flow":
            if not isinstance(lifecycle, dict):
                errors.append(f"{path.relative_to(KIT_ROOT)}: scaffolded flow needs lifecycle")
            for key in ("roleCatalog", "artifactCatalog"):
                if not isinstance(data.get(key), str) or not data.get(key):
                    errors.append(f"{path.relative_to(KIT_ROOT)}: scaffolded flow needs {key}")
        elif lifecycle is not None:
            errors.append(f"{path.relative_to(KIT_ROOT)}: only scaffolded flows may define lifecycle in this slice")
        feature_contract = data.get("featureContract")
        if profile_id == "fdd":
            if not isinstance(feature_contract, str) or not feature_contract:
                errors.append(f"{path.relative_to(KIT_ROOT)}: FDD needs featureContract")
        elif feature_contract is not None:
            errors.append(f"{path.relative_to(KIT_ROOT)}: only FDD may define featureContract")
        requirement_contract = data.get("requirementContract")
        if profile_id == "dsdm":
            if not isinstance(requirement_contract, str) or not requirement_contract:
                errors.append(f"{path.relative_to(KIT_ROOT)}: DSDM needs requirementContract")
        elif requirement_contract is not None:
            errors.append(
                f"{path.relative_to(KIT_ROOT)}: only DSDM may define requirementContract"
            )
        iteration_contract = data.get("iterationContract")
        if profile_id == "aup":
            if not isinstance(iteration_contract, str) or not iteration_contract:
                errors.append(f"{path.relative_to(KIT_ROOT)}: AUP needs iterationContract")
        elif iteration_contract is not None:
            errors.append(
                f"{path.relative_to(KIT_ROOT)}: only AUP may define iterationContract"
            )

    for profile_id in sorted(expected_ids - set(profiles)):
        errors.append(f"methodologies/profiles/{profile_id}.json: missing")
    for profile_id in sorted(set(profiles) - expected_ids):
        errors.append(f"methodologies/profiles/{profile_id}.json: unexpected profile")

    neutral_phases = {"intake", "planning", "build", "qa", "review", "release", "operate"}
    for profile in profiles.values():
        if profile.get("supportLevel") != "scaffolded" or profile.get("kind") != "flow":
            continue
        profile_id = profile["id"]
        label = f"methodologies/profiles/{profile_id}.json"
        lifecycle = profile.get("lifecycle")
        if not isinstance(lifecycle, dict):
            continue
        stages = lifecycle.get("stages")
        transitions = lifecycle.get("transitions")
        if not isinstance(stages, list) or not stages:
            errors.append(f"{label}: lifecycle.stages must be a non-empty array")
            continue
        if not isinstance(transitions, list):
            errors.append(f"{label}: lifecycle.transitions must be an array")
            transitions = []
        stage_ids = [
            stage.get("id")
            for stage in stages
            if isinstance(stage, dict) and isinstance(stage.get("id"), str)
        ]
        if len(stage_ids) != len(stages) or len(stage_ids) != len(set(stage_ids)):
            errors.append(f"{label}: lifecycle stage ids must be present and unique")
        initial = lifecycle.get("initialStage")
        if initial not in stage_ids:
            errors.append(f"{label}: lifecycle initialStage must reference a stage")
        for stage in stages:
            if not isinstance(stage, dict):
                continue
            phases = stage.get("allowedPhases")
            if (
                not isinstance(phases, list)
                or not phases
                or not all(isinstance(item, str) and item in neutral_phases for item in phases)
                or len(phases) != len(set(phases))
            ):
                errors.append(f"{label}: stage {stage.get('id')} has invalid allowedPhases")
        transition_pairs: set[tuple[str, str]] = set()
        for transition in transitions:
            if not isinstance(transition, dict):
                errors.append(f"{label}: lifecycle transition must be an object")
                continue
            source = transition.get("from")
            destination = transition.get("to")
            if source not in stage_ids or destination not in stage_ids:
                errors.append(f"{label}: transition {source!r} -> {destination!r} references an unknown stage")
            pair = (str(source), str(destination))
            if pair in transition_pairs:
                errors.append(f"{label}: duplicate transition {source!r} -> {destination!r}")
            transition_pairs.add(pair)
            if not isinstance(transition.get("loop"), bool):
                errors.append(f"{label}: transition {source!r} -> {destination!r} needs boolean loop")

        mappings = profile.get("phaseMappings")
        mapping_by_stage: dict[str, list] = {}
        if isinstance(mappings, list):
            for mapping in mappings:
                if not isinstance(mapping, dict) or not isinstance(mapping.get("lifecycleStage"), str):
                    errors.append(f"{label}: invalid phase mapping")
                    continue
                mapping_stage = mapping["lifecycleStage"]
                if mapping_stage in mapping_by_stage:
                    errors.append(f"{label}: duplicate phase mapping for {mapping_stage}")
                mapping_by_stage[mapping_stage] = mapping.get("phases")
        if set(mapping_by_stage) != set(stage_ids):
            errors.append(f"{label}: phase mappings must cover every lifecycle stage exactly once")
        for stage in stages:
            if isinstance(stage, dict) and mapping_by_stage.get(stage.get("id")) != stage.get("allowedPhases"):
                errors.append(f"{label}: phase mapping for {stage.get('id')} must match allowedPhases")

        try:
            roles = methodology_catalog(profile, "roleCatalog", "roles")
            artifacts = methodology_catalog(profile, "artifactCatalog", "artifacts")
        except AokError as exc:
            errors.append(str(exc))
            continue
        role_ids = [role.get("name") for role in roles if isinstance(role.get("name"), str)]
        artifact_ids = [
            artifact.get("id") for artifact in artifacts if isinstance(artifact.get("id"), str)
        ]
        if len(role_ids) != len(roles) or len(role_ids) != len(set(role_ids)):
            errors.append(f"{label}: role ids must be present and unique")
        if len(artifact_ids) != len(artifacts) or len(artifact_ids) != len(set(artifact_ids)):
            errors.append(f"{label}: artifact ids must be present and unique")
        human_roles: set[str] = set()
        output_paths: set[str] = set()
        for role in roles:
            role_id = role.get("name")
            if (
                not isinstance(role_id, str)
                or re.fullmatch(r"[a-z0-9][a-z0-9-]*", role_id) is None
            ):
                errors.append(f"{label}: role id {role_id!r} is invalid")
            if role.get("kind") != "role":
                errors.append(f"{label}: role {role_id!r} must have kind role")
            if not isinstance(role.get("description"), str) or not role.get("description"):
                errors.append(f"{label}: role {role_id!r} needs a description")
            if role.get("assignmentMode") not in ("agent", "human", "either"):
                errors.append(f"{label}: role {role_id!r} has invalid assignmentMode")
            if role.get("methodologies") != [profile_id]:
                errors.append(f"{label}: role {role_id!r} must belong to {profile_id}")
            responsibilities = role.get("responsibilities")
            if not isinstance(responsibilities, list) or not responsibilities:
                errors.append(f"{label}: role {role_id!r} needs responsibilities")
            for key in ("capabilities", "escalationRules"):
                values = role.get(key, [])
                if not isinstance(values, list) or not all(
                    isinstance(item, str) and item for item in values
                ):
                    errors.append(f"{label}: role {role_id!r} has invalid {key}")
            target_path = role.get("targets", {}).get("codex", {}).get("path")
            expected_prefix = f"agents/roles/{profile_id}-"
            if not isinstance(target_path, str) or not target_path.startswith(expected_prefix):
                errors.append(f"{label}: role {role_id!r} has invalid template output path")
            elif target_path in output_paths:
                errors.append(f"{label}: duplicate scaffold output path {target_path}")
            else:
                output_paths.add(target_path)
            if role.get("assignmentMode") == "human" and isinstance(role_id, str):
                human_roles.add(role_id)
        for artifact in artifacts:
            artifact_id = artifact.get("id")
            if (
                not isinstance(artifact_id, str)
                or re.fullmatch(r"[a-z0-9][a-z0-9-]*", artifact_id) is None
            ):
                errors.append(f"{label}: artifact id {artifact_id!r} is invalid")
            if artifact.get("kind") != "artifact" or artifact.get("methodology") != profile_id:
                errors.append(f"{label}: artifact {artifact_id!r} has invalid identity")
            if not isinstance(artifact.get("title"), str) or not artifact.get("title"):
                errors.append(f"{label}: artifact {artifact_id!r} needs a title")
            if not isinstance(artifact.get("description"), str) or not artifact.get("description"):
                errors.append(f"{label}: artifact {artifact_id!r} needs a description")
            if artifact.get("requirement") not in ("required", "conditional", "optional"):
                errors.append(f"{label}: artifact {artifact_id!r} has invalid requirement")
            if artifact.get("evolution") not in ("milestone", "evolutionary", "iterative", "working"):
                errors.append(f"{label}: artifact {artifact_id!r} has invalid evolution")
            owners = artifact.get("owners")
            approvers = artifact.get("approvers")
            if not isinstance(owners, list) or not owners:
                errors.append(f"{label}: artifact {artifact_id!r} needs owners")
                owners = []
            if not isinstance(approvers, list):
                errors.append(f"{label}: artifact {artifact_id!r} has invalid approvers")
                approvers = []
            for reference in owners + approvers:
                if reference not in role_ids:
                    errors.append(f"{label}: artifact {artifact_id!r} references unknown role {reference!r}")
            for stage_id in artifact.get("lifecycleStages", []):
                if stage_id not in stage_ids:
                    errors.append(f"{label}: artifact {artifact_id!r} references unknown stage {stage_id!r}")
            sections = artifact.get("sections")
            if not isinstance(sections, list) or not sections:
                errors.append(f"{label}: artifact {artifact_id!r} needs template sections")
            target_path = artifact.get("template", {}).get("outputPath")
            expected_prefix = f"docs/methodology/{profile_id}/artifacts/"
            if not isinstance(target_path, str) or not target_path.startswith(expected_prefix):
                errors.append(f"{label}: artifact {artifact_id!r} has invalid template output path")
            elif target_path in output_paths:
                errors.append(f"{label}: duplicate scaffold output path {target_path}")
            else:
                output_paths.add(target_path)
            source_path = artifact.get("template", {}).get("sourcePath")
            if source_path is not None:
                if not isinstance(source_path, str) or not source_path:
                    errors.append(f"{label}: artifact {artifact_id!r} has invalid sourcePath")
                else:
                    try:
                        methodology_asset_path(source_path, "Methodology artifact template")
                    except AokError as exc:
                        errors.append(str(exc))

        ceremony_ids: set[str] = set()
        for ceremony in profile.get("ceremonies", []):
            if not isinstance(ceremony, dict):
                errors.append(f"{label}: ceremony must be an object")
                continue
            ceremony_id = ceremony.get("id")
            if not isinstance(ceremony_id, str) or ceremony_id in ceremony_ids:
                errors.append(f"{label}: ceremony ids must be present and unique")
            else:
                ceremony_ids.add(ceremony_id)
            for stage_id in ceremony.get("lifecycleStages", []):
                if stage_id not in stage_ids:
                    errors.append(f"{label}: ceremony {ceremony_id!r} references unknown stage {stage_id!r}")
            for role_id in ceremony.get("participants", []):
                if role_id not in role_ids:
                    errors.append(f"{label}: ceremony {ceremony_id!r} references unknown role {role_id!r}")
            for artifact_id in ceremony.get("outputs", []):
                if artifact_id not in artifact_ids:
                    errors.append(f"{label}: ceremony {ceremony_id!r} references unknown artifact {artifact_id!r}")
            if ceremony.get("humanCheckpoint") and not human_roles.intersection(
                ceremony.get("participants", [])
            ):
                errors.append(f"{label}: human checkpoint {ceremony_id!r} needs a human-only participant")

        gate_ids: set[str] = set()
        for gate in profile.get("gates", []):
            if not isinstance(gate, dict):
                errors.append(f"{label}: gate must be an object")
                continue
            gate_id = gate.get("id")
            if not isinstance(gate_id, str) or gate_id in gate_ids:
                errors.append(f"{label}: gate ids must be present and unique")
            else:
                gate_ids.add(gate_id)
            if (str(gate.get("from")), str(gate.get("to"))) not in transition_pairs:
                errors.append(f"{label}: gate {gate_id!r} does not match a lifecycle transition")
            for artifact_id in gate.get("requiredArtifacts", []):
                if artifact_id not in artifact_ids:
                    errors.append(f"{label}: gate {gate_id!r} references unknown artifact {artifact_id!r}")
            for role_id in gate.get("requiredRoles", []):
                if role_id not in role_ids:
                    errors.append(f"{label}: gate {gate_id!r} references unknown role {role_id!r}")
            if gate.get("humanApproval") and not human_roles.intersection(gate.get("requiredRoles", [])):
                errors.append(f"{label}: human approval gate {gate_id!r} needs a human-only role")

        if profile_id == "aup":
            try:
                iteration_contract = load_iteration_contract(profile)
            except AokError as exc:
                errors.append(str(exc))
                iteration_contract = None
            if not isinstance(iteration_contract, dict):
                errors.append(f"{label}: AUP iteration contract must be an object")
            else:
                if (
                    iteration_contract.get("id") != "aup-iteration"
                    or iteration_contract.get("methodology") != "aup"
                ):
                    errors.append(f"{label}: AUP iteration contract identity is invalid")
                identifier = iteration_contract.get("identifier")
                identifier_pattern = (
                    identifier.get("pattern") if isinstance(identifier, dict) else None
                )
                if (
                    not isinstance(identifier, dict)
                    or identifier.get("field") != "iterationId"
                    or identifier_pattern != r"^[A-Z][A-Z0-9]*-[0-9]+$"
                ):
                    errors.append(f"{label}: AUP iteration identifier contract is invalid")
                else:
                    examples = identifier.get("examples")
                    if (
                        not isinstance(examples, list)
                        or not examples
                        or not all(
                            isinstance(item, str)
                            and re.fullmatch(identifier_pattern, item) is not None
                            for item in examples
                        )
                    ):
                        errors.append(f"{label}: AUP iteration identifier examples are invalid")

                selected_work = iteration_contract.get("selectedWork")
                work_types = (
                    selected_work.get("types")
                    if isinstance(selected_work, dict)
                    else None
                )
                expected_work_types = [
                    "use-case",
                    "user-story",
                    "non-functional",
                    "business-rule",
                    "defect",
                    "technical",
                ]
                if (
                    not isinstance(selected_work, dict)
                    or selected_work.get("idField") != "requirementId"
                    or selected_work.get("typeField") != "requirementType"
                    or work_types != expected_work_types
                ):
                    errors.append(f"{label}: AUP selected-work contract is invalid")

                disciplines = iteration_contract.get("disciplines")
                expected_disciplines = [
                    ("model", "model"),
                    ("implementation", "implementation"),
                    ("test", "test"),
                    ("deployment", "deployment"),
                    ("configuration-management", "configurationManagement"),
                    ("project-management", "projectManagement"),
                    ("environment", "environment"),
                ]
                actual_disciplines = [
                    (item.get("id"), item.get("taskField"))
                    for item in disciplines
                    if isinstance(item, dict)
                ] if isinstance(disciplines, list) else []
                if actual_disciplines != expected_disciplines:
                    errors.append(f"{label}: AUP disciplines are invalid")
                discipline_evidence_contract = iteration_contract.get(
                    "disciplineEvidence"
                )
                if discipline_evidence_contract != {
                    "field": "disciplineEvidence",
                    "requiredForEveryDiscipline": True,
                    "evidenceField": "evidence",
                    "notApplicableField": "notApplicableRationale",
                }:
                    errors.append(f"{label}: AUP discipline evidence contract is invalid")

                milestones = iteration_contract.get("milestones")
                expected_milestones = [
                    ("lco", 1, "inception", "lifecycle-objectives"),
                    ("lca", 2, "elaboration", "lifecycle-architecture"),
                    ("ioc", 3, "construction", "initial-operational-capability"),
                    ("pr", 4, "transition", "product-release"),
                ]
                actual_milestones = [
                    (
                        item.get("id"),
                        item.get("order"),
                        item.get("lifecycleStage"),
                        item.get("gate"),
                    )
                    for item in milestones
                    if isinstance(item, dict)
                ] if isinstance(milestones, list) else []
                if actual_milestones != expected_milestones:
                    errors.append(f"{label}: AUP lifecycle milestones are invalid")
                gates_by_id = {
                    gate.get("id"): gate
                    for gate in profile.get("gates", [])
                    if isinstance(gate, dict)
                }
                for milestone_id, _, milestone_stage, gate_id in expected_milestones:
                    gate = gates_by_id.get(gate_id)
                    if not gate or gate.get("from") != milestone_stage:
                        errors.append(
                            f"{label}: AUP milestone {milestone_id!r} does not match gate {gate_id!r}"
                        )
                        continue
                    if gate.get("humanApproval") is not True or "aup-stakeholder" not in gate.get(
                        "requiredRoles", []
                    ):
                        errors.append(
                            f"{label}: AUP milestone gate {gate_id!r} needs human stakeholder approval"
                        )
                if (
                    iteration_contract.get("completionMeasure")
                    != "iteration-objective-and-selected-work-accepted-with-discipline-evidence"
                ):
                    errors.append(f"{label}: AUP iteration completion measure is invalid")

                gate_inputs = iteration_contract.get("gateInputs")
                if (
                    not isinstance(gate_inputs, list)
                    or not all(isinstance(item, str) and item for item in gate_inputs)
                    or len(gate_inputs) != len(set(gate_inputs))
                ):
                    errors.append(f"{label}: AUP gateInputs must be unique strings")
                    gate_inputs = []
                for gate in profile.get("gates", []):
                    for input_id in gate.get("requiredInputs", []):
                        if input_id not in gate_inputs:
                            errors.append(
                                f"{label}: gate {gate.get('id')!r} references unknown AUP input {input_id!r}"
                            )

                def aup_contract_keys(value: object) -> set[str]:
                    if isinstance(value, dict):
                        return set(value).union(
                            *(aup_contract_keys(item) for item in value.values())
                        )
                    if isinstance(value, list):
                        return set().union(*(aup_contract_keys(item) for item in value))
                    return set()

                forbidden_keys = {
                    "naming",
                    "featureName",
                    "featureNameParts",
                    "subjectArea",
                    "businessActivity",
                    "weight",
                    "cumulative",
                    "moscow",
                    "timeboxing",
                    "timebox",
                }
                found_forbidden = sorted(
                    aup_contract_keys(iteration_contract) & forbidden_keys
                )
                if found_forbidden:
                    errors.append(
                        f"{label}: AUP contract contains FDD/DSDM-only keys: "
                        + ", ".join(found_forbidden)
                    )

                task_schema_path = KIT_ROOT / "schemas" / "task-packet.schema.json"
                task_schema = require_json(task_schema_path, errors)
                if task_schema:
                    properties = task_schema.get("properties", {})
                    if properties.get("iterationId", {}).get("pattern") != identifier_pattern:
                        errors.append(
                            "schemas/task-packet.schema.json: iterationId must match AUP contract"
                        )
                    if properties.get("requirementType", {}).get("enum") != work_types:
                        errors.append(
                            "schemas/task-packet.schema.json: requirementType must match AUP contract"
                        )
                    discipline_schema = properties.get("disciplineEvidence", {})
                    if discipline_schema.get("required") != [
                        task_field for _, task_field in expected_disciplines
                    ]:
                        errors.append(
                            "schemas/task-packet.schema.json: disciplineEvidence must require every AUP discipline"
                        )
                    if list(discipline_schema.get("properties", {})) != [
                        task_field for _, task_field in expected_disciplines
                    ]:
                        errors.append(
                            "schemas/task-packet.schema.json: disciplineEvidence fields must match AUP contract"
                        )
                    for field in (
                        "requirementType",
                        "iterationId",
                        "iterationObjective",
                        "disciplineEvidence",
                    ):
                        if field in task_schema.get("required", []):
                            errors.append(
                                f"schemas/task-packet.schema.json: {field} must remain optional"
                            )
                missing_sources = [
                    artifact.get("id")
                    for artifact in artifacts
                    if not artifact.get("template", {}).get("sourcePath")
                ]
                if missing_sources:
                    errors.append(
                        f"{label}: every AUP artifact needs a curated sourcePath: "
                        + ", ".join(str(item) for item in missing_sources)
                    )
                forbidden_template_phrases = (
                    "<action> <result>",
                    "subject area",
                    "business activity",
                    "moscow",
                    "timebox",
                    "domain-walkthrough",
                    "cumulative percentage",
                )
                for artifact in artifacts:
                    source_path = artifact.get("template", {}).get("sourcePath")
                    if not isinstance(source_path, str):
                        continue
                    try:
                        source_text = methodology_asset_path(
                            source_path, "Methodology artifact template"
                        ).read_text().lower()
                    except AokError:
                        continue
                    for phrase in forbidden_template_phrases:
                        if phrase in source_text:
                            errors.append(
                                f"{label}: AUP artifact {artifact.get('id')!r} contains FDD/DSDM-only content {phrase!r}"
                            )

        if profile_id == "dsdm":
            try:
                requirement_contract = load_requirement_contract(profile)
            except AokError as exc:
                errors.append(str(exc))
                requirement_contract = None
            if not isinstance(requirement_contract, dict):
                errors.append(f"{label}: DSDM requirement contract must be an object")
            else:
                if (
                    requirement_contract.get("id") != "dsdm-requirement"
                    or requirement_contract.get("methodology") != "dsdm"
                ):
                    errors.append(f"{label}: DSDM requirement contract identity is invalid")
                hierarchy = requirement_contract.get("hierarchy")
                hierarchy_ids = [
                    item.get("id") for item in hierarchy if isinstance(item, dict)
                ] if isinstance(hierarchy, list) else []
                if hierarchy_ids != [
                    "requirementTheme",
                    "requirement",
                    "acceptanceCriterion",
                ]:
                    errors.append(
                        f"{label}: DSDM hierarchy must be optional theme -> requirement -> acceptance criterion"
                    )
                elif (
                    hierarchy[0].get("optional") is not True
                    or hierarchy[1].get("optional") is not False
                    or hierarchy[2].get("optional") is not False
                    or hierarchy[2].get("repeatable") is not True
                ):
                    errors.append(f"{label}: DSDM hierarchy optionality is invalid")

                identifier = requirement_contract.get("identifier")
                identifier_pattern = (
                    identifier.get("pattern") if isinstance(identifier, dict) else None
                )
                if (
                    not isinstance(identifier, dict)
                    or identifier.get("field") != "requirementId"
                    or identifier_pattern != r"^[A-Z][A-Z0-9]*-[0-9]+$"
                ):
                    errors.append(f"{label}: DSDM requirement identifier contract is invalid")
                else:
                    examples = identifier.get("examples")
                    if (
                        not isinstance(examples, list)
                        or not examples
                        or not all(
                            isinstance(item, str)
                            and re.fullmatch(identifier_pattern, item) is not None
                            for item in examples
                        )
                    ):
                        errors.append(f"{label}: DSDM requirement identifier examples are invalid")

                moscow_contract = requirement_contract.get("moscow")
                moscow_values = (
                    moscow_contract.get("values")
                    if isinstance(moscow_contract, dict)
                    else None
                )
                moscow_ids = [
                    item.get("id") for item in moscow_values if isinstance(item, dict)
                ] if isinstance(moscow_values, list) else []
                if moscow_ids != ["must", "should", "could", "wont"]:
                    errors.append(f"{label}: DSDM MoSCoW values are invalid")
                moscow_levels = (
                    moscow_contract.get("levels")
                    if isinstance(moscow_contract, dict)
                    else None
                )
                expected_levels = [
                    ("project", "projectMoscow", None),
                    ("project-increment", "incrementMoscow", "projectIncrement"),
                    ("timebox", "timeboxMoscow", "timebox"),
                ]
                actual_levels = [
                    (item.get("id"), item.get("field"), item.get("contextField"))
                    for item in moscow_levels
                    if isinstance(item, dict)
                ] if isinstance(moscow_levels, list) else []
                if actual_levels != expected_levels:
                    errors.append(f"{label}: DSDM MoSCoW priority levels are invalid")
                if (
                    not isinstance(moscow_contract, dict)
                    or moscow_contract.get("legacyAlias")
                    != {"field": "moscow", "mapsTo": "timeboxMoscow"}
                ):
                    errors.append(f"{label}: DSDM legacy MoSCoW alias is invalid")
                guidance = (
                    moscow_contract.get("guidance")
                    if isinstance(moscow_contract, dict)
                    else None
                )
                if guidance != {
                    "mustEffortMaximumPercent": 60,
                    "couldEffortTargetPercent": 20,
                    "enforcement": "advisory",
                }:
                    errors.append(f"{label}: DSDM MoSCoW guidance must remain advisory")

                timeboxing = requirement_contract.get("timeboxing")
                checkpoints = (
                    timeboxing.get("checkpoints") if isinstance(timeboxing, dict) else None
                )
                checkpoint_ids = [
                    item.get("id") for item in checkpoints if isinstance(item, dict)
                ] if isinstance(checkpoints, list) else []
                checkpoint_orders = [
                    item.get("order") for item in checkpoints if isinstance(item, dict)
                ] if isinstance(checkpoints, list) else []
                if checkpoint_ids != ["kick-off", "mid-timebox", "close-out"]:
                    errors.append(f"{label}: DSDM timebox checkpoints are invalid")
                if checkpoint_orders != [1, 2, 3]:
                    errors.append(f"{label}: DSDM timebox checkpoint ordering is invalid")
                dispositions = (
                    timeboxing.get("dispositions") if isinstance(timeboxing, dict) else None
                )
                disposition_ids = [
                    item.get("id") for item in dispositions if isinstance(item, dict)
                ] if isinstance(dispositions, list) else []
                if disposition_ids != ["planned", "delivered", "deferred", "wont"]:
                    errors.append(f"{label}: DSDM timebox dispositions are invalid")
                if (
                    not isinstance(timeboxing, dict)
                    or timeboxing.get("policy")
                    != {
                        "time": "fixed",
                        "quality": "protected",
                        "scope": "flexed-by-moscow",
                    }
                    or timeboxing.get("progressMeasure")
                    != "requirements-delivered-and-accepted-by-moscow"
                ):
                    errors.append(f"{label}: DSDM timebox policy is invalid")

                gate_inputs = requirement_contract.get("gateInputs")
                if (
                    not isinstance(gate_inputs, list)
                    or not all(isinstance(item, str) and item for item in gate_inputs)
                    or len(gate_inputs) != len(set(gate_inputs))
                ):
                    errors.append(f"{label}: DSDM gateInputs must be unique strings")
                    gate_inputs = []
                for gate in profile.get("gates", []):
                    for input_id in gate.get("requiredInputs", []):
                        if input_id not in gate_inputs:
                            errors.append(
                                f"{label}: gate {gate.get('id')!r} references unknown DSDM input {input_id!r}"
                            )

                def contract_keys(value: object) -> set[str]:
                    if isinstance(value, dict):
                        return set(value).union(
                            *(contract_keys(item) for item in value.values())
                        )
                    if isinstance(value, list):
                        return set().union(*(contract_keys(item) for item in value))
                    return set()

                forbidden_keys = {
                    "naming",
                    "featureName",
                    "featureNameParts",
                    "subjectArea",
                    "businessActivity",
                    "milestones",
                    "weight",
                    "cumulative",
                }
                found_forbidden = sorted(contract_keys(requirement_contract) & forbidden_keys)
                if found_forbidden:
                    errors.append(
                        f"{label}: DSDM contract contains FDD-only keys: "
                        + ", ".join(found_forbidden)
                    )

                task_schema_path = KIT_ROOT / "schemas" / "task-packet.schema.json"
                task_schema = require_json(task_schema_path, errors)
                if task_schema:
                    properties = task_schema.get("properties", {})
                    if properties.get("requirementId", {}).get("pattern") != identifier_pattern:
                        errors.append(
                            "schemas/task-packet.schema.json: requirementId must match DSDM contract"
                        )
                    for field in (
                        "projectMoscow",
                        "incrementMoscow",
                        "timeboxMoscow",
                        "moscow",
                    ):
                        if properties.get(field, {}).get("enum") != moscow_ids:
                            errors.append(
                                f"schemas/task-packet.schema.json: {field} must match DSDM contract"
                            )
                    for field in (
                        "requirementId",
                        "requirementTheme",
                        "requirementOutcome",
                        "projectIncrement",
                        "projectMoscow",
                        "incrementMoscow",
                        "timeboxMoscow",
                    ):
                        if field in task_schema.get("required", []):
                            errors.append(
                                f"schemas/task-packet.schema.json: {field} must remain optional"
                            )
                missing_sources = [
                    artifact.get("id")
                    for artifact in artifacts
                    if not artifact.get("template", {}).get("sourcePath")
                ]
                if missing_sources:
                    errors.append(
                        f"{label}: every DSDM artifact needs a curated sourcePath: "
                        + ", ".join(str(item) for item in missing_sources)
                    )
                forbidden_template_phrases = (
                    "<action> <result>",
                    "domain-walkthrough",
                    "design-inspection",
                    "code-inspection",
                    "promote-to-build",
                    "cumulative progress",
                )
                for artifact in artifacts:
                    source_path = artifact.get("template", {}).get("sourcePath")
                    if not isinstance(source_path, str):
                        continue
                    try:
                        source_text = methodology_asset_path(
                            source_path, "Methodology artifact template"
                        ).read_text().lower()
                    except AokError:
                        continue
                    for phrase in forbidden_template_phrases:
                        if phrase in source_text:
                            errors.append(
                                f"{label}: DSDM artifact {artifact.get('id')!r} contains FDD-only content {phrase!r}"
                            )

        if profile_id != "fdd":
            continue
        try:
            feature_contract = load_feature_contract(profile)
        except AokError as exc:
            errors.append(str(exc))
            continue
        if not isinstance(feature_contract, dict):
            errors.append(f"{label}: FDD feature contract must be an object")
            continue
        if feature_contract.get("id") != "fdd-feature" or feature_contract.get("methodology") != "fdd":
            errors.append(f"{label}: FDD feature contract identity is invalid")
        hierarchy = feature_contract.get("hierarchy")
        hierarchy_ids = [
            item.get("id") for item in hierarchy if isinstance(item, dict)
        ] if isinstance(hierarchy, list) else []
        if hierarchy_ids != ["subjectArea", "businessActivity", "feature"]:
            errors.append(
                f"{label}: FDD hierarchy must be subjectArea -> businessActivity -> feature"
            )
        elif hierarchy[1].get("alias") != "Feature Set":
            errors.append(f"{label}: FDD businessActivity must document Feature Set alias")
        naming = feature_contract.get("naming")
        if not isinstance(naming, dict):
            errors.append(f"{label}: FDD feature contract needs naming")
            naming = {}
        if naming.get("preferredStyle") != "short":
            errors.append(f"{label}: FDD preferred naming style must be short")
        if naming.get("prepositions") != ["by", "for", "of", "to"]:
            errors.append(f"{label}: FDD naming prepositions must be by, for, of, to")
        styles = naming.get("styles")
        style_ids = [
            item.get("id") for item in styles if isinstance(item, dict)
        ] if isinstance(styles, list) else []
        if style_ids != ["short", "classic"]:
            errors.append(f"{label}: FDD naming styles must be short then classic")
        if feature_contract.get("maxEstimatedEffortDays") != 10:
            errors.append(f"{label}: FDD maximum estimated effort must be 10 days")
        milestones = feature_contract.get("milestones")
        if not isinstance(milestones, list) or len(milestones) != 6:
            errors.append(f"{label}: FDD feature contract needs six milestones")
            milestones = []
        milestone_ids = [
            item.get("id") for item in milestones if isinstance(item, dict)
        ]
        if len(milestone_ids) != len(set(milestone_ids)):
            errors.append(f"{label}: FDD milestone ids must be unique")
        expected_cumulative = 0
        for index, milestone in enumerate(milestones, start=1):
            if not isinstance(milestone, dict):
                errors.append(f"{label}: FDD milestone {index} must be an object")
                continue
            if milestone.get("order") != index:
                errors.append(f"{label}: FDD milestone orders must be sequential")
            weight = milestone.get("weight")
            if not isinstance(weight, int) or isinstance(weight, bool) or weight <= 0:
                errors.append(f"{label}: FDD milestone {milestone.get('id')!r} has invalid weight")
                continue
            expected_cumulative += weight
            if milestone.get("cumulative") != expected_cumulative:
                errors.append(
                    f"{label}: FDD milestone {milestone.get('id')!r} has invalid cumulative progress"
                )
            if milestone.get("lifecycleStage") not in stage_ids:
                errors.append(
                    f"{label}: FDD milestone {milestone.get('id')!r} references unknown stage"
                )
        if expected_cumulative != 100:
            errors.append(f"{label}: FDD milestone weights must sum to 100")
        gate_inputs = feature_contract.get("gateInputs")
        if (
            not isinstance(gate_inputs, list)
            or not all(isinstance(item, str) and item for item in gate_inputs)
            or len(gate_inputs) != len(set(gate_inputs))
        ):
            errors.append(f"{label}: FDD gateInputs must be unique strings")
            gate_inputs = []
        for gate in profile.get("gates", []):
            for input_id in gate.get("requiredInputs", []):
                if input_id not in gate_inputs:
                    errors.append(
                        f"{label}: gate {gate.get('id')!r} references unknown FDD input {input_id!r}"
                    )
        task_schema_path = KIT_ROOT / "schemas" / "task-packet.schema.json"
        task_schema = require_json(task_schema_path, errors)
        if task_schema:
            properties = task_schema.get("properties", {})
            schema_milestones = (
                properties.get("featureMilestones", {})
                .get("items", {})
                .get("enum")
            )
            if schema_milestones != milestone_ids:
                errors.append(
                    "schemas/task-packet.schema.json: featureMilestones must match FDD contract"
                )
            if properties.get("estimatedEffortDays", {}).get("maximum") != feature_contract.get(
                "maxEstimatedEffortDays"
            ):
                errors.append(
                    "schemas/task-packet.schema.json: estimatedEffortDays must match FDD contract"
                )

    defaults = [
        profile["id"]
        for profile in profiles.values()
        if profile.get("kind") == "flow" and profile.get("default") is True
    ]
    if defaults != ["kanban"]:
        errors.append("methodologies: kanban must be the only default flow")
    for profile in profiles.values():
        if profile.get("kind") == "flow" and profile.get("compatibleFlows"):
            errors.append(
                f"methodologies/profiles/{profile['id']}.json: flow compatibleFlows must be empty"
            )
        if profile.get("kind") != "overlay":
            continue
        for flow_id in profile.get("compatibleFlows", []):
            flow = profiles.get(flow_id)
            if not flow or flow.get("kind") != "flow":
                errors.append(
                    f"methodologies/profiles/{profile['id']}.json: incompatible flow reference {flow_id}"
                )
        if profile.get("supportLevel") == "active":
            active_compatible = [
                flow_id
                for flow_id in profile.get("compatibleFlows", [])
                if profiles.get(flow_id, {}).get("supportLevel") == "active"
            ]
            if not active_compatible:
                errors.append(
                    f"methodologies/profiles/{profile['id']}.json: active overlay needs an active compatible flow"
                )
    for kind in ("flow", "overlay"):
        orders = [
            profile.get("order")
            for profile in profiles.values()
            if profile.get("kind") == kind
            and isinstance(profile.get("order"), int)
            and not isinstance(profile.get("order"), bool)
        ]
        if len(orders) != len(set(orders)):
            errors.append(f"methodologies: {kind} order values must be unique")
    template_path = KIT_ROOT / "templates" / "agents" / "methodology.md"
    if template_path.exists() and "kanban" in profiles:
        try:
            rendered = render_methodology_policy(DEFAULT_METHODOLOGY, profiles)
            if template_path.read_text() != rendered:
                errors.append("templates/agents/methodology.md: must match the default kanban render")
        except AokError as exc:
            errors.append(f"methodologies: cannot render default kanban policy: {exc}")


def validate_work_item_catalog(errors: list[str]) -> None:
    catalog = require_json(WORK_ITEM_CATALOG_PATH, errors)
    if not catalog:
        return
    label = "work-items/catalog.json"
    if catalog.get("kind") != "aok-work-item-type-catalog":
        errors.append(f"{label}: kind must be aok-work-item-type-catalog")
    if catalog.get("version") != 1:
        errors.append(f"{label}: version must be 1")
    types = catalog.get("types")
    common = catalog.get("commonSections")
    if not isinstance(types, list):
        errors.append(f"{label}: types must be an array")
        return
    if not isinstance(common, list) or not common:
        errors.append(f"{label}: commonSections must be a non-empty array")
        common = []
    expected_ids = {
        "epic",
        "feature",
        "task",
        "bug",
        "spike",
        "incident",
        "risk",
        "change",
        "xp-user-story",
        "lean-improvement",
        "lean-experiment",
        "fdd-feature",
        "dsdm-requirement",
        "aup-use-case",
        "aup-user-story",
        "aup-non-functional",
        "aup-business-rule",
        "aup-defect",
        "aup-technical",
    }
    if catalog.get("maxTypes") != 19 or len(types) != 19:
        errors.append(f"{label}: maxTypes and catalog size must both be 19")
    profiles = load_methodology_profiles()
    task_schema = require_json(KIT_ROOT / "schemas" / "task-packet.schema.json", errors) or {}
    task_properties = task_schema.get("properties", {})
    task_work_item = task_properties.get("workItemType", {})
    task_enum = task_work_item.get("enum", []) if isinstance(task_work_item, dict) else []
    required_task_fields = set(task_schema.get("required", []))
    if "workItemType" in required_task_fields:
        errors.append("schemas/task-packet.schema.json: workItemType must remain optional")
    type_ids: list[str] = []
    source_paths: set[str] = set()
    canonical = {"epic", "feature", "task", "bug", "spike", "incident", "risk", "change"}
    github_types = {"Feature", "Task", "Bug"}
    azure_types = {"Epic", "Feature", "Task", "Bug", "$defaultRequirementWorkItemType"}

    def validate_sections(raw: object, owner: str) -> None:
        if not isinstance(raw, list) or not raw:
            errors.append(f"{label}: {owner} sections must be a non-empty array")
            return
        ids = [
            item.get("id")
            for item in raw
            if isinstance(item, dict) and isinstance(item.get("id"), str)
        ]
        if len(ids) != len(raw) or len(ids) != len(set(ids)):
            errors.append(f"{label}: {owner} section ids must be present and unique")
        for section in raw:
            if not isinstance(section, dict):
                continue
            for key in ("label", "description"):
                if not isinstance(section.get(key), str) or not section.get(key):
                    errors.append(f"{label}: {owner} section {section.get('id')} needs {key}")
            for key in ("required", "multiline"):
                if not isinstance(section.get(key), bool):
                    errors.append(
                        f"{label}: {owner} section {section.get('id')} {key} must be boolean"
                    )

    validate_sections(common, "common")
    common_ids = {
        item.get("id") for item in common if isinstance(item, dict) and item.get("id")
    }
    for item in types:
        if not isinstance(item, dict):
            errors.append(f"{label}: work-item type must be an object")
            continue
        item_id = item.get("id")
        if not isinstance(item_id, str) or re.fullmatch(r"[a-z0-9][a-z0-9-]*", item_id) is None:
            errors.append(f"{label}: invalid work-item type id {item_id!r}")
            continue
        type_ids.append(item_id)
        for key in ("displayName", "description"):
            if not isinstance(item.get(key), str) or not item.get(key):
                errors.append(f"{label}: {item_id} needs {key}")
        if item.get("canonicalCategory") not in canonical:
            errors.append(f"{label}: {item_id} has invalid canonicalCategory")
        origin = item.get("origin")
        if not isinstance(origin, dict):
            errors.append(f"{label}: {item_id} origin must be an object")
        else:
            origin_kind = origin.get("kind")
            origin_id = origin.get("id")
            if origin_kind == "core":
                if origin_id != "core":
                    errors.append(f"{label}: {item_id} core origin id must be core")
            else:
                profile = profiles.get(origin_id)
                if not profile or profile.get("kind") != origin_kind:
                    errors.append(f"{label}: {item_id} has invalid methodology origin")
                elif profile.get("supportLevel") not in ("active", "scaffolded"):
                    errors.append(f"{label}: {item_id} origin is not active or scaffolded")
        hierarchy = item.get("hierarchy")
        if not isinstance(hierarchy, dict):
            errors.append(f"{label}: {item_id} hierarchy must be an object")
        else:
            for key in ("parentTypes", "childTypes"):
                values = hierarchy.get(key)
                if (
                    not isinstance(values, list)
                    or not all(isinstance(value, str) for value in values)
                    or len(values) != len(set(values))
                ):
                    errors.append(f"{label}: {item_id} {key} must contain unique strings")
        task_fields = item.get("taskPacketFields")
        if (
            not isinstance(task_fields, list)
            or not task_fields
            or len(task_fields) != len(set(task_fields))
        ):
            errors.append(f"{label}: {item_id} taskPacketFields must be unique and non-empty")
        else:
            for field in task_fields:
                if field not in task_properties:
                    errors.append(f"{label}: {item_id} references unknown task field {field}")
        source = item.get("sourcePath")
        if not isinstance(source, str) or not source:
            errors.append(f"{label}: {item_id} needs sourcePath")
        elif source in source_paths:
            errors.append(f"{label}: duplicate sourcePath {source}")
        else:
            source_paths.add(source)
            try:
                if not work_item_source_path(source).read_text().strip():
                    errors.append(f"{label}: {item_id} source template is empty")
            except AokError as exc:
                errors.append(f"{label}: {exc}")
        validate_sections(item.get("sections"), item_id)
        section_ids = {
            section.get("id")
            for section in item.get("sections", [])
            if isinstance(section, dict) and section.get("id")
        }
        if common_ids & section_ids:
            errors.append(f"{label}: {item_id} duplicates a common section id")
        mappings = item.get("providerMappings")
        if not isinstance(mappings, dict):
            errors.append(f"{label}: {item_id} providerMappings must be an object")
        else:
            github = mappings.get("github", {})
            azure = mappings.get("azureDevOps", {})
            if not isinstance(github, dict) or github.get("issueType") not in github_types:
                errors.append(f"{label}: {item_id} has invalid GitHub issue type")
            if not isinstance(azure, dict) or azure.get("workItemType") not in azure_types:
                errors.append(f"{label}: {item_id} has invalid Azure work-item type")
    if len(type_ids) != len(set(type_ids)):
        errors.append(f"{label}: work-item type ids must be unique")
    if set(type_ids) != expected_ids:
        errors.append(f"{label}: catalog ids must match the 19-type AOK contract")
    if set(task_enum) != expected_ids:
        errors.append(
            "schemas/task-packet.schema.json: workItemType enum must match the work-item catalog"
        )
    known_ids = set(type_ids)
    for item in types:
        if not isinstance(item, dict):
            continue
        hierarchy = item.get("hierarchy", {})
        if not isinstance(hierarchy, dict):
            continue
        for reference in [*hierarchy.get("parentTypes", []), *hierarchy.get("childTypes", [])]:
            if reference not in known_ids:
                errors.append(
                    f"{label}: {item.get('id')} hierarchy references unknown type {reference}"
                )
    expected_counts = {
        ("kanban", ()): 8,
        ("kanban", ("xp",)): 9,
        ("kanban", ("lean",)): 10,
        ("kanban", ("xp", "lean")): 11,
        ("fdd", ()): 9,
        ("dsdm", ()): 9,
        ("aup", ()): 14,
    }
    for (flow, overlays), count in expected_counts.items():
        try:
            selection = normalize_work_item_selection(flow, list(overlays), profiles)
            actual = len(effective_work_item_types(catalog, selection))
            if actual != count:
                errors.append(
                    f"{label}: {flow}+{','.join(overlays) or 'none'} must render {count}, got {actual}"
                )
        except AokError as exc:
            errors.append(f"{label}: cannot resolve {flow} work-item set: {exc}")


def validate_claude_code_marketplace(errors: list[str]) -> None:
    marketplace_root = KIT_ROOT / "adapters" / "claude-code" / "marketplace"
    marketplace = marketplace_root / ".claude-plugin" / "marketplace.json"
    data = require_json(marketplace, errors)
    if not data:
        return
    plugins = data.get("plugins")
    if not isinstance(plugins, list) or not plugins:
        errors.append(f"{marketplace.relative_to(KIT_ROOT)}: plugins must be a non-empty list")
        return
    plugin_names = {plugin.get("name") for plugin in plugins if isinstance(plugin, dict)}
    if CLAUDE_ROOT_PLUGIN not in plugin_names:
        errors.append(f"{marketplace.relative_to(KIT_ROOT)}: missing {CLAUDE_ROOT_PLUGIN} plugin")
    for plugin in plugins:
        name = plugin.get("name", "<unknown>")
        source = plugin.get("source")
        if not isinstance(source, str) or not source:
            errors.append(f"{marketplace.relative_to(KIT_ROOT)}: plugin {name} missing source")
            continue
        resolved = (marketplace_root / source).resolve()
        if not resolved.exists():
            errors.append(f"{marketplace.relative_to(KIT_ROOT)}: plugin {name} source does not exist: {source}")
        try:
            resolved.relative_to(KIT_ROOT.resolve())
        except ValueError:
            errors.append(f"{marketplace.relative_to(KIT_ROOT)}: plugin {name} source escapes kit root: {source}")


def validate_codex_local_environment_templates(errors: list[str]) -> None:
    report = collect_codex_local_env(KIT_ROOT / "templates")
    if not report["templatesOk"]:
        for item in report["files"]:
            if not item["ok"]:
                errors.append(f"templates/{item['relativePath']}: missing")
            if item["executable"] is False:
                errors.append(f"templates/{item['relativePath']}: must be executable")
        if not report["manifest"]["ok"]:
            detail = f": {report['manifest']['error']}" if report["manifest"]["error"] else ""
            errors.append(f"templates/.codex/aok-local-environment.json: invalid manifest{detail}")
        if not report["environmentToml"]["ok"]:
            detail = f": {report['environmentToml']['error']}" if report["environmentToml"]["error"] else ""
            errors.append(f"templates/.codex/environments/environment.toml: invalid local environment config{detail}")
        for action in report["missingActions"]:
            errors.append(f"templates/.codex/aok-local-environment.json: missing action {action}")
        for action in report["invalidActions"]:
            errors.append(f"templates/.codex/aok-local-environment.json: invalid action {action}")
    if report["codexGeneratedConfig"].get("status") != "locally-observed":
        errors.append("templates/.codex/aok-local-environment.json: codexGeneratedConfig.status must be locally-observed")
    if report["codexGeneratedConfig"].get("path") != ".codex/environments/environment.toml":
        errors.append("templates/.codex/aok-local-environment.json: codexGeneratedConfig.path must be .codex/environments/environment.toml")


def validate_kit() -> list[str]:
    errors: list[str] = []
    validate_required_files(errors)
    validate_json_files(errors)
    validate_adapters(errors)
    validate_packs(errors)
    validate_methodologies(errors)
    validate_work_item_catalog(errors)
    validate_claude_code_marketplace(errors)
    validate_codex_local_environment_templates(errors)
    return errors


def cmd_validate(_: argparse.Namespace) -> int:
    missing = validate_kit()
    if missing:
        print("Kit validation failed:")
        for item in missing:
            print(f"- {item}")
        return 1
    print(f"Kit validation passed: {KIT_ROOT}")
    return 0


def cmd_version(_: argparse.Namespace) -> int:
    print(plugin_version())
    return 0


