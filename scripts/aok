class AokError(RuntimeError):
    pass


def run(cmd: list[str], cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, check=check)


def is_windows_host() -> bool:
    return os.name == "nt"


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def print_result(label: str, ok: bool, detail: str = "") -> None:
    mark = "OK" if ok else "FAIL"
    suffix = f" - {detail}" if detail else ""
    print(f"{mark} {label}{suffix}")


def load_json(path: Path, default: dict) -> dict:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        raise AokError(f"Invalid JSON in {path}: {exc}") from exc


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n")


def parse_command_json(result: subprocess.CompletedProcess[str], label: str) -> object:
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise AokError(f"{label} returned malformed JSON: {exc}") from exc


def object_list(data: object, *keys: str) -> list[dict]:
    if isinstance(data, list):
        return [item for item in data if isinstance(item, dict)]
    if isinstance(data, dict):
        for key in keys:
            value = data.get(key)
            if isinstance(value, list):
                return [item for item in value if isinstance(item, dict)]
    return []


def work_system_check(report: dict, name: str, status: str, detail: str) -> None:
    report["checks"].append({"name": name, "status": status, "detail": detail})
    if status != "satisfied":
        report["conformant"] = False


def work_system_report(provider: str) -> dict:
    return {
        "provider": provider,
        "supportLevel": WORK_SYSTEM_SUPPORT_LEVEL,
        "conformant": True,
        "project": None,
        "checks": [],
        "futureOperations": [],
        "binding": None,
    }


def render_work_system_report(report: dict) -> str:
    lines = [
        f"Work-system plan: {report['provider']} ({report['supportLevel']})",
        f"Conformant: {'yes' if report['conformant'] else 'no'}",
    ]
    project = report.get("project")
    if isinstance(project, dict):
        label = project.get("title") or project.get("name") or project.get("id") or "unknown"
        lines.append(f"Project: {label}")
    if report.get("bindingWritten"):
        lines.append(f"Binding written: {report['bindingWritten']}")
    lines.append("Checks:")
    for check in report["checks"]:
        lines.append(f"- {check['status'].upper()} {check['name']}: {check['detail']}")
    lines.append("Future operations (not executed):")
    operations = report.get("futureOperations") or []
    if operations:
        lines.extend(f"- {operation}" for operation in operations)
    else:
        lines.append("- none")
    return "\n".join(lines)


def write_work_system_binding(path: Path, binding: dict) -> None:
    project_path = path.resolve()
    if not project_path.exists() or not project_path.is_dir():
        raise AokError(f"Target is not a directory: {project_path}")
    manifest_path = project_path / ".aok" / "project.json"
    manifest = load_json(manifest_path, {})
    if not isinstance(manifest, dict):
        raise AokError(f"Project manifest must be a JSON object: {manifest_path}")
    manifest["workSystem"] = binding
    write_json(manifest_path, manifest)


def checked_tool(name: str) -> None:
    if not command_exists(name):
        raise AokError(f"Required command is not installed: {name}")


def shell_command(parts: list[object]) -> str:
    return shlex.join(str(part) for part in parts)


def github_project(args: argparse.Namespace) -> tuple[dict | None, list[dict]]:
    checked_tool("gh")
    run(["gh", "auth", "status"])
    if args.project_number is not None:
        result = run(
            ["gh", "project", "view", str(args.project_number), "--owner", args.owner, "--format", "json"],
            check=False,
        )
        if result.returncode != 0:
            error = (result.stderr or "").strip()
            lowered = error.lower()
            if "could not resolve" in lowered or "not found" in lowered:
                return None, []
            raise AokError(f"gh project view failed: {error or f'exit code {result.returncode}'}")
        data = parse_command_json(result, "gh project view")
        if not isinstance(data, dict):
            raise AokError("gh project view returned an unexpected JSON shape")
        return data, []
    result = run(["gh", "project", "list", "--owner", args.owner, "--format", "json", "--limit", "100"])
    projects = object_list(parse_command_json(result, "gh project list"), "projects", "items")
    matches = [project for project in projects if project.get("title") == args.project_title]
    return (matches[0] if len(matches) == 1 else None), matches


def github_field_type(field: dict) -> str:
    raw = str(field.get("dataType") or field.get("type") or "").upper()
    aliases = {
        "PROJECTV2SINGLESELECTFIELD": "SINGLE_SELECT",
        "PROJECTV2ITERATIONFIELD": "ITERATION",
    }
    return aliases.get(raw, raw)


def github_field_options(field: dict) -> list[dict]:
    return object_list(field.get("options", []), "options", "items")


def discover_github_work_system(args: argparse.Namespace) -> dict:
    report = work_system_report("github")
    project, title_matches = github_project(args)
    if project is None:
        if len(title_matches) > 1:
            work_system_check(
                report,
                "project",
                "mismatched",
                f"multiple projects match title {args.project_title!r}; use --project-number",
            )
        else:
            label = args.project_title or str(args.project_number)
            work_system_check(report, "project", "missing", f"project {label!r} was not found")
            if args.project_title:
                report["futureOperations"].append(
                    shell_command(
                        ["gh", "project", "create", "--owner", args.owner, "--title", args.project_title]
                    )
                )
        return report

    number = project.get("number", args.project_number)
    if number is None:
        raise AokError("GitHub project JSON did not include a project number")
    project_id = project.get("id")
    title = project.get("title") or args.project_title or f"Project {number}"
    url = project.get("url") or ""
    report["project"] = {
        "id": project_id,
        "number": int(number),
        "title": title,
        "url": url,
        "owner": args.owner,
    }
    if not project_id or not url:
        work_system_check(report, "project", "mismatched", "project ID or URL is missing")
    else:
        work_system_check(report, "project", "satisfied", f"found project {number} ({title})")

    fields_result = run(
        ["gh", "project", "field-list", str(number), "--owner", args.owner, "--format", "json", "--limit", "100"]
    )
    fields = object_list(parse_command_json(fields_result, "gh project field-list"), "fields", "items")
    if any(github_field_type(field) == "PROJECTV2FIELD" for field in fields):
        if not project_id:
            raise AokError("GitHub project JSON did not include an ID needed to resolve field data types")
        type_result = run(
            [
                "gh",
                "api",
                "graphql",
                "-f",
                (
                    "query($id:ID!){node(id:$id){... on ProjectV2{fields(first:100){nodes{"
                    "__typename ... on ProjectV2FieldCommon{id name dataType}}}}}}"
                ),
                "-F",
                f"id={project_id}",
            ]
        )
        type_data = parse_command_json(type_result, "gh api graphql field type query")
        nodes: object = type_data
        for key in ("data", "node", "fields", "nodes"):
            nodes = nodes.get(key, {}) if isinstance(nodes, dict) else {}
        type_fields = object_list(nodes)
        data_types = {
            str(field.get("id")): str(field.get("dataType", ""))
            for field in type_fields
            if field.get("id")
        }
        for field in fields:
            if github_field_type(field) == "PROJECTV2FIELD":
                field["dataType"] = data_types.get(str(field.get("id")), "")
    by_name: dict[str, list[dict]] = {}
    for field in fields:
        by_name.setdefault(str(field.get("name", "")), []).append(field)
    binding_fields: dict[str, dict] = {}

    expected: list[tuple[str, str, tuple[str, ...]]] = []
    expected.extend((name, "SINGLE_SELECT", options) for name, options in WORK_SYSTEM_SELECT_FIELDS.items())
    expected.extend((name, "TEXT", ()) for name in WORK_SYSTEM_TEXT_FIELDS)
    expected.extend((name, "NUMBER", ()) for name in WORK_SYSTEM_NUMBER_FIELDS)
    for name, expected_type, required_options in expected:
        matches = by_name.get(name, [])
        if not matches:
            work_system_check(report, f"field:{name}", "missing", f"expected {expected_type}")
            suffix = (
                f" with options {', '.join(required_options)}" if required_options else ""
            )
            create_command: list[object] = [
                "gh",
                "project",
                "field-create",
                number,
                "--owner",
                args.owner,
                "--name",
                name,
                "--data-type",
                expected_type,
            ]
            if required_options:
                create_command.extend(["--single-select-options", ",".join(required_options)])
            report["futureOperations"].append(
                f"{shell_command(create_command)}  # create {name!r} as {expected_type}{suffix}"
            )
            continue
        if len(matches) > 1:
            work_system_check(report, f"field:{name}", "mismatched", "duplicate field names")
            continue
        field = matches[0]
        if not field.get("id"):
            work_system_check(report, f"field:{name}", "mismatched", "field ID is missing")
            continue
        actual_type = github_field_type(field)
        if actual_type != expected_type:
            work_system_check(
                report,
                f"field:{name}",
                "mismatched",
                f"expected {expected_type}, found {actual_type or 'unknown'}",
            )
            continue
        field_binding = {"id": field.get("id"), "type": actual_type}
        if required_options:
            options = github_field_options(field)
            option_by_name: dict[str, list[dict]] = {}
            for option in options:
                option_by_name.setdefault(str(option.get("name", "")), []).append(option)
            missing_options = [option for option in required_options if len(option_by_name.get(option, [])) != 1]
            if missing_options:
                work_system_check(
                    report,
                    f"field:{name}",
                    "mismatched",
                    f"missing or duplicate options: {', '.join(missing_options)}",
                )
                report["futureOperations"].append(
                    f"ensure GitHub field {name!r} options: {', '.join(required_options)}"
                )
                continue
            if any(not option_by_name[option][0].get("id") for option in required_options):
                work_system_check(report, f"field:{name}", "mismatched", "one or more option IDs are missing")
                continue
            field_binding["options"] = {
                option: option_by_name[option][0].get("id") for option in required_options
            }
        work_system_check(report, f"field:{name}", "satisfied", expected_type)
        binding_fields[name] = field_binding

    if report["conformant"]:
        report["binding"] = {
            "provider": "github",
            "supportLevel": WORK_SYSTEM_SUPPORT_LEVEL,
            "owner": args.owner,
            "projectNumber": int(number),
            "projectId": project_id,
            "url": url,
            "fields": binding_fields,
        }
    return report


def az_json(cmd: list[str], label: str) -> object:
    result = run(cmd + ["--output", "json", "--only-show-errors"])
    return parse_command_json(result, label)


def az_invoke(
    organization: str,
    area: str,
    resource: str,
    route_parameters: dict[str, object],
    *,
    api_version: str = "7.1",
) -> object:
    cmd = [
        "az",
        "devops",
        "invoke",
        "--organization",
        organization,
        "--area",
        area,
        "--resource",
        resource,
        "--api-version",
        api_version,
        "--http-method",
        "GET",
    ]
    if route_parameters:
        cmd.append("--route-parameters")
        cmd.extend(f"{key}={value}" for key, value in route_parameters.items() if value is not None)
    return az_json(cmd, f"az devops invoke {area}/{resource}")


def azure_pick_named(
    items: list[dict],
    requested: str | None,
    *,
    name_key: str = "name",
    fallback: str | None = None,
) -> tuple[dict | None, list[dict]]:
    target = requested or fallback
    if target:
        matches = [item for item in items if item.get(name_key) == target]
        return (matches[0] if len(matches) == 1 else None), matches
    return (items[0] if len(items) == 1 else None), items


def azure_field_type(field: dict) -> str:
    return str(field.get("type") or field.get("fieldType") or "").lower().replace(" ", "")


def azure_allowed_values(field: dict) -> list[str]:
    raw = field.get("allowedValues")
    if isinstance(raw, list):
        values = []
        for item in raw:
            if isinstance(item, dict):
                item = item.get("value") or item.get("name") or item.get("displayName")
            values.append(str(item))
        return values
    return []


def discover_azure_work_system(args: argparse.Namespace) -> dict:
    report = work_system_report("azure-devops")
    checked_tool("az")
    project_data = az_json(
        [
            "az",
            "devops",
            "project",
            "show",
            "--organization",
            args.organization,
            "--project",
            args.project,
        ],
        "az devops project show",
    )
    if not isinstance(project_data, dict):
        raise AokError("az devops project show returned an unexpected JSON shape")
    project_id = project_data.get("id")
    project_name = project_data.get("name") or args.project
    project_url = project_data.get("url") or ""
    report["project"] = {"id": project_id, "name": project_name, "url": project_url}
    if not project_id or not project_url:
        work_system_check(report, "project", "mismatched", "project ID or URL is missing")
    else:
        work_system_check(report, "project", "satisfied", f"found project {project_name}")

    teams_data = az_json(
        [
            "az",
            "devops",
            "team",
            "list",
            "--organization",
            args.organization,
            "--project",
            str(project_id or project_name),
            "--top",
            "100",
        ],
        "az devops team list",
    )
    teams = object_list(teams_data, "value", "teams", "items")
    default_team = project_data.get("defaultTeam")
    fallback_team = default_team.get("name") if isinstance(default_team, dict) else None
    team, team_matches = azure_pick_named(teams, args.team, fallback=fallback_team)
    if team is None:
        detail = (
            f"multiple teams match {args.team!r}" if len(team_matches) > 1
            else f"team {(args.team or fallback_team or '<default>')!r} was not found"
        )
        work_system_check(report, "team", "mismatched" if len(team_matches) > 1 else "missing", detail)
        return report
    team_id = team.get("id")
    team_name = team.get("name")
    if not team_id:
        work_system_check(report, "team", "mismatched", "team ID is missing")
    else:
        work_system_check(report, "team", "satisfied", f"found team {team_name}")

    capabilities = project_data.get("capabilities")
    process_template = capabilities.get("processTemplate", {}) if isinstance(capabilities, dict) else {}
    process_id = process_template.get("templateTypeId")
    if not process_id:
        work_system_check(report, "process", "missing", "project did not expose a process ID")
        return report
    process_data = az_invoke(
        args.organization,
        "processes",
        "processes",
        {"processTypeId": process_id},
    )
    if not isinstance(process_data, dict):
        raise AokError("Azure process lookup returned an unexpected JSON shape")
    customization = str(process_data.get("customizationType") or "").lower()
    process_name = process_data.get("name") or process_template.get("templateName") or process_id
    if customization not in ("inherited", "custom"):
        work_system_check(
            report,
            "process",
            "mismatched",
            f"{process_name} is {customization or 'unknown'}; an inherited/custom process is required",
        )
        report["futureOperations"].append(
            f"bind project {project_name!r} to an inherited process before AOK provisioning"
        )
    else:
        work_system_check(report, "process", "satisfied", f"{process_name} is {customization}")

    wit_data = az_invoke(
        args.organization,
        "processes",
        "workItemTypes",
        {"processId": process_id},
    )
    work_item_types = object_list(wit_data, "value", "workItemTypes", "items")
    if args.work_item_type:
        wit_matches = [
            item
            for item in work_item_types
            if item.get("name") == args.work_item_type or item.get("referenceName") == args.work_item_type
        ]
        work_item_type = wit_matches[0] if len(wit_matches) == 1 else None
    else:
        preferred = ("User Story", "Product Backlog Item", "Issue", "Requirement")
        candidates = [item for name in preferred for item in work_item_types if item.get("name") == name]
        work_item_type = candidates[0] if candidates else (work_item_types[0] if len(work_item_types) == 1 else None)
        wit_matches = [work_item_type] if work_item_type else work_item_types
    if work_item_type is None:
        requested = args.work_item_type or "default requirement backlog type"
        detail = f"work-item type {requested!r} was not uniquely resolved"
        work_system_check(report, "workItemType", "missing" if not wit_matches else "mismatched", detail)
        return report
    wit_name = work_item_type.get("name")
    wit_ref = work_item_type.get("referenceName")
    if not wit_ref:
        raise AokError("Azure work-item type JSON did not include referenceName")
    work_system_check(report, "workItemType", "satisfied", f"{wit_name} ({wit_ref})")

    fields_data = az_invoke(
        args.organization,
        "processes",
        "fields",
        {"processId": process_id, "witRefName": wit_ref},
    )
    fields = object_list(fields_data, "value", "fields", "items")
    by_name: dict[str, list[dict]] = {}
    for field in fields:
        by_name.setdefault(str(field.get("name", "")), []).append(field)
    binding_fields: dict[str, dict] = {}
    expected_fields: list[tuple[str, tuple[str, ...], tuple[str, ...]]] = []
    expected_fields.extend(
        (name, ("pickliststring",), options)
        for name, options in WORK_SYSTEM_SELECT_FIELDS.items()
        if name != "Status"
    )
    expected_fields.extend((name, ("string", "plaintext", "html"), ()) for name in WORK_SYSTEM_TEXT_FIELDS)
    expected_fields.extend((name, ("integer",), ()) for name in WORK_SYSTEM_NUMBER_FIELDS)
    for name, allowed_types, required_options in expected_fields:
        matches = by_name.get(name, [])
        if not matches:
            work_system_check(report, f"field:{name}", "missing", f"expected {'/'.join(allowed_types)}")
            report["futureOperations"].append(f"add Azure process field {name!r} to {wit_name}")
            continue
        if len(matches) > 1:
            work_system_check(report, f"field:{name}", "mismatched", "duplicate field names")
            continue
        field = matches[0]
        if not field.get("referenceName"):
            work_system_check(report, f"field:{name}", "mismatched", "field referenceName is missing")
            continue
        actual_type = azure_field_type(field)
        if actual_type not in allowed_types:
            work_system_check(
                report,
                f"field:{name}",
                "mismatched",
                f"expected {'/'.join(allowed_types)}, found {actual_type or 'unknown'}",
            )
            continue
        if required_options:
            values = azure_allowed_values(field)
            missing = [value for value in required_options if values.count(value) != 1]
            if missing:
                work_system_check(
                    report,
                    f"field:{name}",
                    "mismatched",
                    f"missing or duplicate values: {', '.join(missing)}",
                )
                report["futureOperations"].append(
                    f"ensure Azure field {name!r} values: {', '.join(required_options)}"
                )
                continue
        work_system_check(report, f"field:{name}", "satisfied", actual_type)
        binding_fields[name] = {
            "referenceName": field.get("referenceName"),
            "type": actual_type,
        }

    states_data = az_invoke(
        args.organization,
        "processes",
        "states",
        {"processId": process_id, "witRefName": wit_ref},
    )
    states = object_list(states_data, "value", "states", "items")
    state_by_name: dict[str, list[dict]] = {}
    for state in states:
        state_by_name.setdefault(str(state.get("name", "")), []).append(state)
    state_binding: dict[str, dict] = {}
    for name, category in AZURE_STATE_CATEGORIES.items():
        matches = state_by_name.get(name, [])
        if len(matches) != 1:
            status = "missing" if not matches else "mismatched"
            work_system_check(report, f"state:{name}", status, "missing" if not matches else "duplicate states")
            report["futureOperations"].append(f"ensure Azure state {name!r} in category {category}")
            continue
        state = matches[0]
        if not state.get("id"):
            work_system_check(report, f"state:{name}", "mismatched", "state ID is missing")
            continue
        actual_category = str(state.get("stateCategory") or state.get("category") or "").replace(" ", "")
        if actual_category.lower() != category.lower():
            work_system_check(
                report,
                f"state:{name}",
                "mismatched",
                f"expected category {category}, found {actual_category or 'unknown'}",
            )
            continue
        work_system_check(report, f"state:{name}", "satisfied", category)
        state_binding[name] = {"id": state.get("id"), "category": category}

    boards_data = az_invoke(
        args.organization,
        "work",
        "boards",
        {"project": project_id or project_name, "team": team_id or team_name},
    )
    boards = object_list(boards_data, "value", "boards", "items")
    board, board_matches = azure_pick_named(boards, args.board)
    if board is None:
        requested = args.board or "the only board"
        detail = f"board {requested!r} was not uniquely resolved"
        work_system_check(report, "board", "missing" if not board_matches else "mismatched", detail)
        return report
    board_id = board.get("id")
    board_name = board.get("name")
    if not board_id:
        work_system_check(report, "board", "mismatched", "board ID is missing")
    else:
        work_system_check(report, "board", "satisfied", f"found board {board_name}")
    columns_data = az_invoke(
        args.organization,
        "work",
        "columns",
        {
            "project": project_id or project_name,
            "team": team_id or team_name,
            "board": board_id or board_name,
        },
    )
    columns = object_list(columns_data, "value", "columns", "items")
    column_by_name: dict[str, list[dict]] = {}
    for column in columns:
        column_by_name.setdefault(str(column.get("name", "")), []).append(column)
    column_binding: dict[str, str | None] = {}
    for name in WORK_SYSTEM_SELECT_FIELDS["Status"]:
        matches = column_by_name.get(name, [])
        if len(matches) != 1:
            work_system_check(
                report,
                f"column:{name}",
                "missing" if not matches else "mismatched",
                "missing" if not matches else "duplicate columns",
            )
            report["futureOperations"].append(f"ensure Azure board column {name!r}")
            continue
        if not matches[0].get("id"):
            work_system_check(report, f"column:{name}", "mismatched", "column ID is missing")
            continue
        work_system_check(report, f"column:{name}", "satisfied", "present")
        column_binding[name] = matches[0].get("id")

    if report["conformant"]:
        binding_fields["Status"] = {"referenceName": "System.State", "type": "state"}
        report["binding"] = {
            "provider": "azure-devops",
            "supportLevel": WORK_SYSTEM_SUPPORT_LEVEL,
            "organization": args.organization.rstrip("/"),
            "project": {"id": project_id, "name": project_name, "url": project_url},
            "team": {"id": team_id, "name": team_name},
            "board": {"id": board_id, "name": board_name, "columns": column_binding},
            "process": {"id": process_id, "name": process_name, "customizationType": customization},
            "workItemType": {"name": wit_name, "referenceName": wit_ref},
            "fields": binding_fields,
            "states": state_binding,
        }
    return report


def cmd_work_system_setup_github(args: argparse.Namespace) -> int:
    report = discover_github_work_system(args)
    if args.write_binding:
        if not report["conformant"] or not report.get("binding"):
            if args.json:
                print(json.dumps(report, indent=2))
            else:
                print(render_work_system_report(report))
            print("Error: refusing to write a nonconformant work-system binding", file=sys.stderr)
            return 1
        stored_binding = dict(report["binding"])
        stored_binding["verifiedAt"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        write_work_system_binding(Path(args.path), stored_binding)
        report["binding"] = stored_binding
        report["bindingWritten"] = str(Path(args.path).resolve() / ".aok" / "project.json")
    print(json.dumps(report, indent=2) if args.json else render_work_system_report(report))
    return 0


def cmd_work_system_setup_azure(args: argparse.Namespace) -> int:
    report = discover_azure_work_system(args)
    if args.write_binding:
        if not report["conformant"] or not report.get("binding"):
            if args.json:
                print(json.dumps(report, indent=2))
            else:
                print(render_work_system_report(report))
            print("Error: refusing to write a nonconformant work-system binding", file=sys.stderr)
            return 1
        stored_binding = dict(report["binding"])
        stored_binding["verifiedAt"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        write_work_system_binding(Path(args.path), stored_binding)
        report["binding"] = stored_binding
        report["bindingWritten"] = str(Path(args.path).resolve() / ".aok" / "project.json")
    print(json.dumps(report, indent=2) if args.json else render_work_system_report(report))
    return 0


def cmd_work_system_validate(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    manifest_path = target / ".aok" / "project.json"
    manifest = load_json(manifest_path, {})
    if not isinstance(manifest, dict) or not isinstance(manifest.get("workSystem"), dict):
        raise AokError(f"No work-system binding in {manifest_path}")
    binding = manifest["workSystem"]
    provider = binding.get("provider")
    if provider == "github":
        discovery_args = argparse.Namespace(
            owner=binding.get("owner"),
            project_number=binding.get("projectNumber"),
            project_title=None,
        )
        if not discovery_args.owner or discovery_args.project_number is None:
            raise AokError("GitHub work-system binding is missing owner or projectNumber")
        report = discover_github_work_system(discovery_args)
    elif provider == "azure-devops":
        project = binding.get("project", {})
        team = binding.get("team", {})
        board = binding.get("board", {})
        work_item_type = binding.get("workItemType", {})
        discovery_args = argparse.Namespace(
            organization=binding.get("organization"),
            project=project.get("id") or project.get("name"),
            team=team.get("name"),
            board=board.get("name"),
            work_item_type=work_item_type.get("referenceName") or work_item_type.get("name"),
        )
        if not discovery_args.organization or not discovery_args.project:
            raise AokError("Azure DevOps work-system binding is missing organization or project")
        report = discover_azure_work_system(discovery_args)
    else:
        raise AokError(f"Unsupported work-system provider in {manifest_path}: {provider!r}")

    discovered = report.get("binding")
    if report["conformant"] and discovered:
        old = dict(binding)
        new = dict(discovered)
        old.pop("verifiedAt", None)
        new.pop("verifiedAt", None)
        if old != new:
            work_system_check(report, "binding", "mismatched", "stored IDs or mappings differ from provider")
        else:
            work_system_check(report, "binding", "satisfied", "stored IDs and mappings match provider")
    print(json.dumps(report, indent=2) if args.json else render_work_system_report(report))
    return 0 if report["conformant"] else 1


def load_methodology_profiles() -> dict[str, dict]:
    profiles: dict[str, dict] = {}
    profile_root = METHODOLOGY_ROOT / "profiles"
    if not profile_root.exists():
        raise AokError(f"Methodology profile directory is missing: {profile_root}")
    for path in sorted(profile_root.glob("*.json")):
        data = load_json(path, {})
        if not isinstance(data, dict):
            raise AokError(f"Methodology profile must be a JSON object: {path}")
        profile_id = data.get("id")
        if not isinstance(profile_id, str) or not profile_id:
            raise AokError(f"Methodology profile is missing an ID: {path}")
        if profile_id in profiles:
            raise AokError(f"Duplicate methodology profile ID: {profile_id}")
        profiles[profile_id] = data
    return profiles


def methodology_catalog(profile: dict, key: str, collection: str) -> list[dict]:
    relative = profile.get(key)
    if relative is None:
        return []
    if not isinstance(relative, str) or not relative:
        raise AokError(f"Methodology profile {profile.get('id')!r} has an invalid {key}")
    path = (METHODOLOGY_ROOT / relative).resolve()
    try:
        path.relative_to(METHODOLOGY_ROOT.resolve())
    except ValueError as exc:
        raise AokError(f"Methodology catalog escapes the catalog root: {relative}") from exc
    data = load_json(path, {})
    values = data.get(collection) if isinstance(data, dict) else None
    if not isinstance(values, list) or not all(isinstance(item, dict) for item in values):
        raise AokError(f"Methodology catalog must contain an object array {collection!r}: {path}")
    return values


def methodology_asset_path(relative: str, label: str) -> Path:
    path = (METHODOLOGY_ROOT / relative).resolve()
    try:
        path.relative_to(METHODOLOGY_ROOT.resolve())
    except ValueError as exc:
        raise AokError(f"{label} escapes the methodology root: {relative}") from exc
    if not path.exists() or not path.is_file():
        raise AokError(f"{label} is missing: {path}")
    return path


def load_feature_contract(profile: dict) -> dict | None:
    relative = profile.get("featureContract")
    if relative is None:
        return None
    if not isinstance(relative, str) or not relative:
        raise AokError(f"Methodology profile {profile.get('id')!r} has an invalid featureContract")
    path = methodology_asset_path(relative, "Methodology feature contract")
    data = load_json(path, {})
    if not isinstance(data, dict):
        raise AokError(f"Methodology feature contract must be a JSON object: {path}")
    return data


def load_requirement_contract(profile: dict) -> dict | None:
    relative = profile.get("requirementContract")
    if relative is None:
        return None
    if not isinstance(relative, str) or not relative:
        raise AokError(
            f"Methodology profile {profile.get('id')!r} has an invalid requirementContract"
        )
    path = methodology_asset_path(relative, "Methodology requirement contract")
    data = load_json(path, {})
    if not isinstance(data, dict):
        raise AokError(f"Methodology requirement contract must be a JSON object: {path}")
    return data


def load_iteration_contract(profile: dict) -> dict | None:
    relative = profile.get("iterationContract")
    if relative is None:
        return None
    if not isinstance(relative, str) or not relative:
        raise AokError(
            f"Methodology profile {profile.get('id')!r} has an invalid iterationContract"
        )
    path = methodology_asset_path(relative, "Methodology iteration contract")
    data = load_json(path, {})
    if not isinstance(data, dict):
        raise AokError(f"Methodology iteration contract must be a JSON object: {path}")
    return data


def methodology_profile_contract(profile: dict) -> dict:
    result = dict(profile)
    roles = methodology_catalog(profile, "roleCatalog", "roles")
    artifacts = methodology_catalog(profile, "artifactCatalog", "artifacts")
    result["roles"] = roles
    result["artifacts"] = artifacts
    result["featureDefinition"] = load_feature_contract(profile)
    result["requirementDefinition"] = load_requirement_contract(profile)
    result["iterationDefinition"] = load_iteration_contract(profile)
    result["catalogCounts"] = {
        "stages": len((profile.get("lifecycle") or {}).get("stages", [])),
        "roles": len(roles),
        "artifacts": len(artifacts),
        "ceremonies": len(profile.get("ceremonies", [])),
        "gates": len(profile.get("gates", [])),
    }
    return result


def render_scaffold_role(role: dict, flow_name: str) -> str:
    assignment = role.get("assignmentMode", "either")
    title = str(role.get("callsign") or role["name"]).replace("-", " ").title()
    lines = [
        METHODOLOGY_SCAFFOLD_MARKER,
        f"# {title}",
        "",
        f"Flow: `{flow_name}`",
        f"Role ID: `{role['name']}`",
        f"Assignment: `{assignment}`",
        "",
        "## Mission",
        "",
        str(role["description"]),
        "",
        "## Responsibilities",
        "",
        *[f"- {item}" for item in role.get("responsibilities", [])],
    ]
    capabilities = role.get("capabilities", [])
    if capabilities:
        lines.extend(["", "## Capabilities", "", *[f"- {item}" for item in capabilities]])
    escalation = role.get("escalationRules", [])
    if escalation:
        lines.extend(["", "## Escalation", "", *[f"- {item}" for item in escalation]])
    if assignment == "human":
        lines.extend(
            [
                "",
                "## Authority Guardrail",
                "",
                "This role requires a named human. Agents may prepare evidence and recommendations but must not assume its approval authority.",
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def render_scaffold_artifact(artifact: dict, flow_name: str) -> str:
    source = artifact.get("template", {}).get("sourcePath")
    if source is not None:
        if not isinstance(source, str) or not source:
            raise AokError(f"Methodology artifact {artifact.get('id')!r} has invalid sourcePath")
        body = methodology_asset_path(source, "Methodology artifact template").read_text().strip()
        return f"{METHODOLOGY_SCAFFOLD_MARKER}\n{body}\n"
    lines = [
        METHODOLOGY_SCAFFOLD_MARKER,
        f"# {artifact['title']}",
        "",
        f"Flow: `{flow_name}`",
        f"Requirement: `{artifact['requirement']}`",
        f"Evolution: `{artifact['evolution']}`",
        f"Owners: {', '.join(f'`{item}`' for item in artifact['owners'])}",
        "Approvers: "
        + (", ".join(f"`{item}`" for item in artifact.get("approvers", [])) or "none"),
        f"Lifecycle stages: {', '.join(f'`{item}`' for item in artifact['lifecycleStages'])}",
        "",
        str(artifact["description"]),
    ]
    for section in artifact.get("sections", []):
        lines.extend(["", f"## {section}", "", "<!-- Complete this section for the project. -->"])
    return "\n".join(lines).rstrip() + "\n"


def validate_fdd_feature_name(name: str, contract: dict) -> dict:
    normalized = " ".join(name.split())
    prepositions = contract.get("naming", {}).get("prepositions", [])
    if not isinstance(prepositions, list) or not prepositions:
        raise AokError("FDD feature contract has no naming prepositions")
    connector = "|".join(re.escape(str(item)) for item in prepositions)
    classic = re.fullmatch(
        rf"(?P<action>\S+)\s+the\s+(?P<result>.+?)\s+"
        rf"(?P<preposition>{connector})\s+(?P<article>a|an)\s+(?P<object>.+)",
        normalized,
        flags=re.IGNORECASE,
    )
    short = re.fullmatch(
        rf"(?P<action>\S+)\s+(?P<result>.+?)\s+"
        rf"(?P<preposition>{connector})\s+(?P<object>.+)",
        normalized,
        flags=re.IGNORECASE,
    )
    if classic is None and short is not None:
        short_result = short.group("result").lower()
        short_object = short.group("object").lower()
        if short_result.startswith("the ") or short_object.startswith(("a ", "an ")):
            return {
                "kind": "aok-fdd-feature-name-validation",
                "valid": False,
                "inputName": name,
                "normalizedName": normalized,
                "style": None,
                "canonicalName": None,
                "parts": None,
                "errors": [
                    "feature name has ambiguous article structure; use either the short form "
                    "without articles or the complete classic form"
                ],
            }
    match = classic or short
    errors: list[str] = []
    if not normalized:
        errors.append("feature name is empty")
    elif match is None:
        errors.append(
            "feature name must match '<action> <result> <by|for|of|to> <object>' "
            "or the accepted classic article form"
        )
    if match is None:
        return {
            "kind": "aok-fdd-feature-name-validation",
            "valid": False,
            "inputName": name,
            "normalizedName": normalized,
            "style": None,
            "canonicalName": None,
            "parts": None,
            "errors": errors,
        }
    parts = {
        "action": match.group("action"),
        "result": match.group("result"),
        "preposition": match.group("preposition").lower(),
        "object": match.group("object"),
        "style": "classic" if classic else "short",
    }
    if classic:
        parts["article"] = match.group("article").lower()
    canonical = (
        f"{parts['action']} {parts['result']} {parts['preposition']} {parts['object']}"
    )
    return {
        "kind": "aok-fdd-feature-name-validation",
        "valid": True,
        "inputName": name,
        "normalizedName": normalized,
        "style": parts["style"],
        "canonicalName": canonical,
        "parts": parts,
        "errors": [],
    }


def render_feature_name_validation(report: dict) -> str:
    lines = [
        f"FDD feature name validation: {'passed' if report['valid'] else 'failed'}",
        f"Input: {report['inputName']}",
        f"Normalized: {report['normalizedName'] or '<empty>'}",
    ]
    if report["valid"]:
        lines.extend(
            [
                f"Style: {report['style']}",
                f"Canonical short name: {report['canonicalName']}",
                f"Action: {report['parts']['action']}",
                f"Result: {report['parts']['result']}",
                f"Preposition: {report['parts']['preposition']}",
                f"Object: {report['parts']['object']}",
            ]
        )
    else:
        lines.extend(f"- {error}" for error in report["errors"])
    return "\n".join(lines)


def validate_dsdm_requirement(args: argparse.Namespace, contract: dict) -> dict:
    normalize = lambda value: " ".join(value.split()) if isinstance(value, str) else ""
    requirement_id = normalize(args.requirement_id)
    theme = normalize(args.theme) if args.theme is not None else None
    outcome = normalize(args.outcome)
    acceptance = [normalize(item) for item in (args.acceptance or [])]
    project_increment = normalize(args.increment) if args.increment is not None else None
    timebox = normalize(args.timebox) if args.timebox is not None else None
    errors: list[str] = []

    identifier = contract.get("identifier", {})
    pattern = identifier.get("pattern")
    if not isinstance(pattern, str) or re.fullmatch(pattern, requirement_id) is None:
        errors.append(
            "requirement id must use an uppercase namespace and numeric sequence "
            "(for example REQ-014)"
        )
    if not outcome:
        errors.append("requirement outcome must be non-empty")
    if args.theme is not None and not theme:
        errors.append("requirement theme must be non-empty when supplied")
    if args.increment is not None and not project_increment:
        errors.append("project increment must be non-empty when supplied")
    if args.timebox is not None and not timebox:
        errors.append("timebox must be non-empty when supplied")
    if not acceptance or any(not item for item in acceptance):
        errors.append("at least one non-empty acceptance criterion is required")
    if len(acceptance) != len(set(acceptance)):
        errors.append("acceptance criteria must be unique after whitespace normalization")

    values = contract.get("moscow", {}).get("values", [])
    valid_priorities = [
        item.get("id")
        for item in values
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    ]
    priority_inputs = [
        ("project", args.project_moscow),
        ("project increment", args.increment_moscow),
        ("timebox", args.timebox_moscow),
    ]
    for label, value in priority_inputs:
        if value is not None and value not in valid_priorities:
            errors.append(
                f"{label} MoSCoW priority must be one of: {', '.join(valid_priorities)}"
            )
    if bool(project_increment) != bool(args.increment_moscow):
        errors.append(
            "project increment and increment MoSCoW priority must be supplied together"
        )
    if bool(timebox) != bool(args.timebox_moscow):
        errors.append("timebox and timebox MoSCoW priority must be supplied together")

    requirement = {
        "id": requirement_id,
        "outcome": outcome,
        "acceptanceCriteria": acceptance,
    }
    if theme is not None:
        requirement["theme"] = theme
    priorities = {"project": args.project_moscow}
    if project_increment is not None:
        priorities["projectIncrement"] = {
            "id": project_increment,
            "moscow": args.increment_moscow,
        }
    if timebox is not None:
        priorities["timebox"] = {
            "id": timebox,
            "moscow": args.timebox_moscow,
        }
    return {
        "kind": "aok-dsdm-requirement-validation",
        "valid": not errors,
        "requirement": requirement,
        "priorities": priorities,
        "errors": errors,
    }


def render_requirement_validation(report: dict) -> str:
    requirement = report["requirement"]
    lines = [
        f"DSDM requirement validation: {'passed' if report['valid'] else 'failed'}",
        f"Requirement ID: {requirement['id'] or '<empty>'}",
        f"Outcome: {requirement['outcome'] or '<empty>'}",
    ]
    if "theme" in requirement:
        lines.append(f"Theme: {requirement['theme'] or '<empty>'}")
    lines.append(f"Project MoSCoW: {report['priorities']['project']}")
    increment = report["priorities"].get("projectIncrement")
    if increment:
        lines.append(
            f"Project increment: {increment['id']} ({increment['moscow']})"
        )
    timebox = report["priorities"].get("timebox")
    if timebox:
        lines.append(f"Timebox: {timebox['id']} ({timebox['moscow']})")
    lines.append("Acceptance criteria:")
    lines.extend(
        [f"- {item or '<empty>'}" for item in requirement["acceptanceCriteria"]]
        or ["- <none>"]
    )
    if report["errors"]:
        lines.append("Errors:")
        lines.extend(f"- {error}" for error in report["errors"])
    return "\n".join(lines)


def validate_aup_iteration(args: argparse.Namespace, contract: dict) -> dict:
    normalize = lambda value: " ".join(value.split()) if isinstance(value, str) else ""
    iteration_id = normalize(args.iteration_id)
    stage = normalize(args.stage).lower()
    objective = normalize(args.objective)
    errors: list[str] = []

    identifier = contract.get("identifier", {})
    pattern = identifier.get("pattern")
    if not isinstance(pattern, str) or re.fullmatch(pattern, iteration_id) is None:
        errors.append(
            "iteration id must use an uppercase namespace and numeric sequence "
            "(for example I-12)"
        )
    if not objective:
        errors.append("iteration objective must be non-empty")

    milestone_by_stage = {
        item.get("lifecycleStage"): item
        for item in contract.get("milestones", [])
        if isinstance(item, dict) and isinstance(item.get("lifecycleStage"), str)
    }
    milestone = milestone_by_stage.get(stage)
    if milestone is None:
        errors.append(
            "iteration stage must be one of: "
            + ", ".join(str(item) for item in milestone_by_stage)
        )

    work_contract = contract.get("selectedWork", {})
    valid_work_types = work_contract.get("types", [])
    selected_work: list[dict[str, str]] = []
    seen_work_ids: set[str] = set()
    if not args.work_item:
        errors.append("at least one selected work item is required")
    for raw_item in args.work_item or []:
        if "=" not in raw_item:
            errors.append(
                f"selected work item {raw_item!r} must use '<type>=<id>'"
            )
            continue
        raw_type, raw_id = raw_item.split("=", 1)
        work_type = normalize(raw_type).lower()
        work_id = normalize(raw_id)
        if work_type not in valid_work_types:
            errors.append(
                f"selected work type {work_type or '<empty>'!r} must be one of: "
                + ", ".join(str(item) for item in valid_work_types)
            )
        if not isinstance(pattern, str) or re.fullmatch(pattern, work_id) is None:
            errors.append(
                f"selected work id {work_id or '<empty>'!r} must use an uppercase "
                "namespace and numeric sequence"
            )
        if work_id in seen_work_ids:
            errors.append(f"selected work id {work_id or '<empty>'!r} is duplicated")
        else:
            seen_work_ids.add(work_id)
        selected_work.append({"type": work_type, "id": work_id})

    discipline_contracts = contract.get("disciplines", [])
    discipline_by_id = {
        item.get("id"): item
        for item in discipline_contracts
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    discipline_evidence: dict[str, dict] = {}
    seen_disciplines: set[str] = set()
    for raw_item in args.discipline or []:
        if "=" not in raw_item:
            errors.append(
                f"discipline entry {raw_item!r} must use '<discipline>=<evidence>'"
            )
            continue
        raw_id, raw_value = raw_item.split("=", 1)
        discipline_id = normalize(raw_id).lower()
        value = normalize(raw_value)
        discipline = discipline_by_id.get(discipline_id)
        if discipline is None:
            errors.append(
                f"unknown discipline {discipline_id or '<empty>'!r}; expected: "
                + ", ".join(str(item) for item in discipline_by_id)
            )
            continue
        if discipline_id in seen_disciplines:
            errors.append(f"discipline {discipline_id!r} is duplicated")
            continue
        seen_disciplines.add(discipline_id)
        task_field = discipline.get("taskField")
        if not isinstance(task_field, str) or not task_field:
            raise AokError(f"AUP discipline {discipline_id!r} has no taskField")
        if value.startswith("not-applicable:"):
            rationale = normalize(value.removeprefix("not-applicable:"))
            if not rationale:
                errors.append(
                    f"discipline {discipline_id!r} needs a non-empty not-applicable rationale"
                )
            discipline_evidence[task_field] = {
                "notApplicableRationale": rationale
            }
        elif value.startswith("not-applicable"):
            errors.append(
                f"discipline {discipline_id!r} must use "
                "'not-applicable:<rationale>'"
            )
            discipline_evidence[task_field] = {"evidence": [value]}
        elif not value:
            errors.append(f"discipline {discipline_id!r} needs non-empty evidence")
            discipline_evidence[task_field] = {"evidence": []}
        else:
            discipline_evidence[task_field] = {"evidence": [value]}
    missing_disciplines = [
        discipline_id
        for discipline_id in discipline_by_id
        if discipline_id not in seen_disciplines
    ]
    if missing_disciplines:
        errors.append(
            "missing discipline evidence: " + ", ".join(missing_disciplines)
        )
    discipline_evidence = {
        str(item["taskField"]): discipline_evidence[str(item["taskField"])]
        for item in discipline_contracts
        if isinstance(item, dict)
        and isinstance(item.get("taskField"), str)
        and str(item["taskField"]) in discipline_evidence
    }

    return {
        "kind": "aok-aup-iteration-validation",
        "valid": not errors,
        "iteration": {
            "id": iteration_id,
            "stage": stage,
            "objective": objective,
            "selectedWork": selected_work,
            "disciplineEvidence": discipline_evidence,
        },
        "milestoneTarget": dict(milestone) if milestone is not None else None,
        "errors": errors,
    }


def render_iteration_validation(report: dict) -> str:
    iteration = report["iteration"]
    lines = [
        f"AUP iteration validation: {'passed' if report['valid'] else 'failed'}",
        f"Iteration ID: {iteration['id'] or '<empty>'}",
        f"Stage: {iteration['stage'] or '<empty>'}",
        f"Objective: {iteration['objective'] or '<empty>'}",
    ]
    milestone = report.get("milestoneTarget")
    lines.append(
        "Milestone target: "
        + (
            f"{milestone['name']} ({milestone['id'].upper()})"
            if milestone
            else "<unknown>"
        )
    )
    lines.append("Selected work:")
    lines.extend(
        [f"- {item['type']}={item['id']}" for item in iteration["selectedWork"]]
        or ["- <none>"]
    )
    lines.append("Discipline evidence:")
    for task_field, evidence in iteration["disciplineEvidence"].items():
        if "notApplicableRationale" in evidence:
            lines.append(
                f"- {task_field}: not applicable — {evidence['notApplicableRationale']}"
            )
        else:
            rendered = ", ".join(evidence.get("evidence", [])) or "<empty>"
            lines.append(f"- {task_field}: {rendered}")
    if report["errors"]:
        lines.append("Errors:")
        lines.extend(f"- {error}" for error in report["errors"])
    return "\n".join(lines)


def render_scaffold_readme(profile: dict, roles: list[dict], artifacts: list[dict]) -> str:
    lifecycle = profile["lifecycle"]
    lines = [
        METHODOLOGY_SCAFFOLD_MARKER,
        f"# {profile['displayName']} Delivery Scaffold",
        "",
        "> This flow is scaffolded, not active. These files do not select the flow, enforce gates, or change project lifecycle state.",
        "",
        str(profile["description"]),
        "",
        "## Lifecycle",
        "",
    ]
    for stage in lifecycle["stages"]:
        repeatable = "; repeatable" if stage["repeatable"] else ""
        lines.append(
            f"- `{stage['id']}` — {stage['name']} ({stage['scope']}{repeatable}); "
            f"neutral phases: {', '.join(stage['allowedPhases'])}"
        )
    lines.extend(["", "## Roles", ""])
    for role in roles:
        lines.append(
            f"- `{role['name']}` ({role['assignmentMode']}): {role['description']}"
        )
    lines.extend(["", "## Artifacts", ""])
    for artifact in artifacts:
        lines.append(
            f"- `{artifact['id']}` ({artifact['requirement']}): {artifact['description']}"
        )
    lines.extend(["", "## Ceremonies", ""])
    for ceremony in profile["ceremonies"]:
        checkpoint = "; human checkpoint" if ceremony["humanCheckpoint"] else ""
        lines.append(f"- `{ceremony['id']}` — {ceremony['name']} ({ceremony['trigger']}{checkpoint})")
    lines.extend(["", "## Gates", ""])
    for gate in profile["gates"]:
        approval = "; human approval" if gate["humanApproval"] else ""
        lines.append(
            f"- `{gate['id']}`: `{gate['from']}` → `{gate['to']}` "
            f"({gate['severity']}{approval})"
        )
    return "\n".join(lines).rstrip() + "\n"


def methodology_scaffold_assets(profile: dict) -> dict[Path, str]:
    roles = methodology_catalog(profile, "roleCatalog", "roles")
    artifacts = methodology_catalog(profile, "artifactCatalog", "artifacts")
    flow = str(profile["id"])
    assets: dict[Path, str] = {}
    for role in roles:
        target = role.get("targets", {}).get("codex", {}).get("path")
        if not isinstance(target, str) or not target:
            raise AokError(f"Methodology role {role.get('name')!r} has no Codex output path")
        assets[Path(target)] = render_scaffold_role(role, flow)
    for artifact in artifacts:
        target = artifact.get("template", {}).get("outputPath")
        if not isinstance(target, str) or not target:
            raise AokError(f"Methodology artifact {artifact.get('id')!r} has no output path")
        assets[Path(target)] = render_scaffold_artifact(artifact, flow)
    assets[Path("docs") / "methodology" / flow / "README.md"] = render_scaffold_readme(
        profile, roles, artifacts
    )
    return assets


def normalize_methodology_selection(
    flow: str,
    overlays: list[str] | None,
    profiles: dict[str, dict] | None = None,
) -> dict:
    profiles = profiles or load_methodology_profiles()
    if flow not in profiles:
        raise AokError(f"Unknown methodology flow: {flow}")
    flow_profile = profiles[flow]
    if flow_profile.get("kind") != "flow":
        raise AokError(f"Methodology profile {flow!r} is not a flow")
    if flow_profile.get("supportLevel") != "active":
        raise AokError(
            f"Methodology flow {flow!r} is {flow_profile.get('supportLevel', 'unknown')}; "
            "only active profiles can be selected"
        )

    raw_overlays = overlays or []
    duplicates = sorted({item for item in raw_overlays if raw_overlays.count(item) > 1})
    if duplicates:
        raise AokError(f"Duplicate methodology overlays: {', '.join(duplicates)}")
    selected: list[dict] = []
    for overlay in raw_overlays:
        if overlay not in profiles:
            raise AokError(f"Unknown methodology overlay: {overlay}")
        profile = profiles[overlay]
        if profile.get("kind") != "overlay":
            raise AokError(f"Methodology profile {overlay!r} is not an overlay")
        if profile.get("supportLevel") != "active":
            raise AokError(
                f"Methodology overlay {overlay!r} is {profile.get('supportLevel', 'unknown')}; "
                "only active profiles can be selected"
            )
        compatible = profile.get("compatibleFlows", [])
        if flow not in compatible:
            raise AokError(f"Methodology overlay {overlay!r} is not compatible with flow {flow!r}")
        selected.append(profile)
    selected.sort(key=lambda item: (int(item.get("order", 0)), str(item.get("id", ""))))
    return {"flow": flow, "overlays": [str(profile["id"]) for profile in selected]}


def methodology_fragment(profile: dict) -> str:
    fragment = profile.get("fragment")
    if not isinstance(fragment, str) or not fragment:
        raise AokError(f"Active methodology profile {profile.get('id')!r} has no policy fragment")
    path = (METHODOLOGY_ROOT / fragment).resolve()
    try:
        path.relative_to(METHODOLOGY_ROOT.resolve())
    except ValueError as exc:
        raise AokError(f"Methodology policy fragment escapes the catalog root: {fragment}") from exc
    if not path.exists():
        raise AokError(f"Methodology policy fragment is missing: {path}")
    return path.read_text().strip()


def render_methodology_policy(selection: dict, profiles: dict[str, dict] | None = None) -> str:
    profiles = profiles or load_methodology_profiles()
    normalized = normalize_methodology_selection(
        str(selection.get("flow", "")),
        selection.get("overlays") if isinstance(selection.get("overlays"), list) else [],
        profiles,
    )
    flow = profiles[normalized["flow"]]
    lines = [
        METHODOLOGY_GENERATED_MARKER,
        "# Project Methodology",
        "",
        f"Flow: `{flow['id']}`",
        "Overlays: "
        + (", ".join(f"`{overlay}`" for overlay in normalized["overlays"]) or "none"),
        "",
        f"## Flow: {flow['displayName']}",
        "",
        methodology_fragment(flow),
    ]
    for overlay_id in normalized["overlays"]:
        overlay = profiles[overlay_id]
        lines.extend(
            [
                "",
                f"## Overlay: {overlay['displayName']}",
                "",
                methodology_fragment(overlay),
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def methodology_manifest(path: Path) -> tuple[dict, Path]:
    manifest_path = path.resolve() / ".aok" / "project.json"
    manifest = load_json(manifest_path, {})
    if not isinstance(manifest, dict):
        raise AokError(f"Project manifest must be a JSON object: {manifest_path}")
    return manifest, manifest_path


def methodology_selection_from_manifest(manifest: dict) -> tuple[dict, bool]:
    selection = manifest.get("methodology")
    if selection is None:
        return dict(DEFAULT_METHODOLOGY), True
    if not isinstance(selection, dict):
        raise AokError("Project methodology selection must be an object")
    flow = selection.get("flow")
    overlays = selection.get("overlays", [])
    if not isinstance(flow, str) or not isinstance(overlays, list) or not all(
        isinstance(item, str) for item in overlays
    ):
        raise AokError("Project methodology selection must contain a flow string and overlay array")
    return {"flow": flow, "overlays": overlays}, False


def methodology_policy_is_safe(
    target: Path,
    new_selection: dict,
    *,
    force: bool,
    profiles: dict[str, dict] | None = None,
) -> None:
    policy_path = target / "agents" / "methodology.md"
    if not policy_path.exists():
        return
    current = policy_path.read_text()
    desired = render_methodology_policy(new_selection, profiles)
    if current == desired:
        return
    manifest, _ = methodology_manifest(target)
    old_selection, _ = methodology_selection_from_manifest(manifest)
    try:
        expected_old = render_methodology_policy(old_selection, profiles)
    except AokError:
        expected_old = ""
    generated_and_unmodified = (
        current.startswith(METHODOLOGY_GENERATED_MARKER) and current == expected_old
    )
    if not generated_and_unmodified and not force:
        raise AokError(
            f"Refusing to overwrite modified methodology policy: {policy_path}; use --force to back it up"
        )


def write_methodology_policy(
    target: Path,
    selection: dict,
    *,
    force: bool,
    prechecked: bool = False,
    profiles: dict[str, dict] | None = None,
) -> str:
    policy_path = target / "agents" / "methodology.md"
    desired = render_methodology_policy(selection, profiles)
    policy_path.parent.mkdir(parents=True, exist_ok=True)
    if not policy_path.exists():
        policy_path.write_text(desired)
        return f"created {policy_path.relative_to(target)}"
    current = policy_path.read_text()
    if current == desired:
        return f"unchanged {policy_path.relative_to(target)}"
    if not prechecked:
        methodology_policy_is_safe(target, selection, force=force, profiles=profiles)
    backup_detail = ""
    if force and not current.startswith(METHODOLOGY_GENERATED_MARKER):
        backup_root = target / ".aok-backups" / datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
        backup = backup_file(policy_path, backup_root, target)
        backup_detail = f"; backup {backup.relative_to(target)}"
    elif force:
        manifest, _ = methodology_manifest(target)
        old_selection, _ = methodology_selection_from_manifest(manifest)
        try:
            modified = current != render_methodology_policy(old_selection, profiles)
        except AokError:
            modified = True
        if modified:
            backup_root = target / ".aok-backups" / datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
            backup = backup_file(policy_path, backup_root, target)
            backup_detail = f"; backup {backup.relative_to(target)}"
    policy_path.write_text(desired)
    return f"updated {policy_path.relative_to(target)}{backup_detail}"


def methodology_validation_report(path: Path) -> dict:
    target = path.resolve()
    profiles = load_methodology_profiles()
    manifest, manifest_path = methodology_manifest(target)
    selection, implicit = methodology_selection_from_manifest(manifest)
    report = {
        "kind": "aok-methodology-validation",
        "projectPath": str(target),
        "manifestPath": str(manifest_path),
        "implicit": implicit,
        "selection": selection,
        "valid": True,
        "checks": [],
    }
    if not manifest_path.exists():
        report["implicit"] = False
        report["valid"] = False
        report["checks"].append({"name": "manifest", "status": "missing"})
        return report
    try:
        normalized = normalize_methodology_selection(
            str(selection.get("flow", "")),
            selection.get("overlays") if isinstance(selection.get("overlays"), list) else [],
            profiles,
        )
        report["selection"] = normalized
        report["checks"].append({"name": "selection", "status": "satisfied"})
        policy_path = target / "agents" / "methodology.md"
        if implicit and not policy_path.exists():
            report["checks"].append({"name": "policy", "status": "implicit-default"})
        elif not policy_path.exists():
            report["valid"] = False
            report["checks"].append({"name": "policy", "status": "missing"})
        elif policy_path.read_text() != render_methodology_policy(normalized, profiles):
            report["valid"] = False
            report["checks"].append({"name": "policy", "status": "mismatched"})
        else:
            report["checks"].append({"name": "policy", "status": "satisfied"})
    except AokError as exc:
        report["valid"] = False
        report["checks"].append({"name": "selection", "status": "invalid", "detail": str(exc)})
    return report


def render_methodology_validation(report: dict) -> str:
    selection = report["selection"]
    overlays = ", ".join(selection.get("overlays", [])) or "none"
    lines = [
        f"Methodology validation: {'passed' if report['valid'] else 'failed'}",
        f"Flow: {selection.get('flow', '<unknown>')}",
        f"Overlays: {overlays}",
        f"Implicit legacy default: {'yes' if report['implicit'] else 'no'}",
    ]
    for check in report["checks"]:
        detail = f" - {check['detail']}" if check.get("detail") else ""
        lines.append(f"- {check['name']}: {check['status']}{detail}")
    return "\n".join(lines)


def cmd_methodology_set(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    if not target.exists() or not target.is_dir():
        raise AokError(f"Target is not a directory: {target}")
    manifest, manifest_path = methodology_manifest(target)
    if not manifest_path.exists():
        raise AokError(f"Project is not initialized; missing {manifest_path}")
    profiles = load_methodology_profiles()
    selection = normalize_methodology_selection(args.flow, args.overlay, profiles)
    methodology_policy_is_safe(target, selection, force=args.force, profiles=profiles)
    change = write_methodology_policy(target, selection, force=args.force, profiles=profiles)
    manifest["methodology"] = selection
    write_json(manifest_path, manifest)
    print(f"Methodology set for {target}")
    print(f"- flow: {selection['flow']}")
    print(f"- overlays: {', '.join(selection['overlays']) or 'none'}")
    print(f"- {change}")
    return 0


def cmd_methodology_show(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    manifest, manifest_path = methodology_manifest(target)
    if not manifest_path.exists():
        raise AokError(f"Project is not initialized; missing {manifest_path}")
    selection, implicit = methodology_selection_from_manifest(manifest)
    profiles = load_methodology_profiles()
    normalized = normalize_methodology_selection(selection["flow"], selection["overlays"], profiles)
    result = {"selection": normalized, "implicit": implicit}
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Flow: {normalized['flow']}")
        print(f"Overlays: {', '.join(normalized['overlays']) or 'none'}")
        print(f"Implicit legacy default: {'yes' if implicit else 'no'}")
    return 0


def cmd_methodology_validate(args: argparse.Namespace) -> int:
    report = methodology_validation_report(Path(args.path))
    print(json.dumps(report, indent=2) if args.json else render_methodology_validation(report))
    return 0 if report["valid"] else 1


def cmd_methodology_validate_feature(args: argparse.Namespace) -> int:
    profile = load_methodology_profiles().get("fdd")
    if not profile:
        raise AokError("FDD methodology profile is missing")
    contract = load_feature_contract(profile)
    if contract is None:
        raise AokError("FDD feature contract is missing")
    report = validate_fdd_feature_name(args.name, contract)
    print(json.dumps(report, indent=2) if args.json else render_feature_name_validation(report))
    return 0 if report["valid"] else 1


def cmd_methodology_validate_requirement(args: argparse.Namespace) -> int:
    profile = load_methodology_profiles().get("dsdm")
    if not profile:
        raise AokError("DSDM methodology profile is missing")
    contract = load_requirement_contract(profile)
    if contract is None:
        raise AokError("DSDM requirement contract is missing")
    report = validate_dsdm_requirement(args, contract)
    print(json.dumps(report, indent=2) if args.json else render_requirement_validation(report))
    return 0 if report["valid"] else 1


def cmd_methodology_validate_iteration(args: argparse.Namespace) -> int:
    profile = load_methodology_profiles().get("aup")
    if not profile:
        raise AokError("AUP methodology profile is missing")
    contract = load_iteration_contract(profile)
    if contract is None:
        raise AokError("AUP iteration contract is missing")
    report = validate_aup_iteration(args, contract)
    print(json.dumps(report, indent=2) if args.json else render_iteration_validation(report))
    return 0 if report["valid"] else 1


def cmd_methodology_list(args: argparse.Namespace) -> int:
    profiles = load_methodology_profiles()
    items = sorted(
        profiles.values(),
        key=lambda item: (0 if item.get("kind") == "flow" else 1, int(item.get("order", 0)), item["id"]),
    )
    if args.json:
        print(json.dumps({"profiles": [methodology_profile_contract(item) for item in items]}, indent=2))
    else:
        for profile in items:
            counts = methodology_profile_contract(profile)["catalogCounts"]
            detail = (
                f"; {counts['stages']} stages, {counts['roles']} roles, "
                f"{counts['artifacts']} artifacts"
                if any(counts.values())
                else ""
            )
            description = str(profile["description"]).rstrip(".")
            print(
                f"{profile['id']}: {profile['kind']} ({profile['supportLevel']}) - "
                f"{description}{detail}."
            )
    return 0


def cmd_methodology_scaffold(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    if not target.exists() or not target.is_dir():
        raise AokError(f"Target is not a directory: {target}")
    profiles = load_methodology_profiles()
    profile = profiles.get(args.flow)
    if not profile:
        raise AokError(f"Unknown methodology flow: {args.flow}")
    if profile.get("kind") != "flow":
        raise AokError(f"Methodology profile {args.flow!r} is not a flow")
    if profile.get("supportLevel") != "scaffolded":
        raise AokError(
            f"Methodology flow {args.flow!r} is {profile.get('supportLevel', 'unknown')}; "
            "only scaffolded flows can be exported"
        )

    assets = methodology_scaffold_assets(profile)
    resolved: list[tuple[Path, Path, str]] = []
    conflicts: list[Path] = []
    for relative, content in sorted(assets.items(), key=lambda item: str(item[0])):
        destination = (target / relative).resolve()
        try:
            destination.relative_to(target)
        except ValueError as exc:
            raise AokError(f"Methodology scaffold output escapes target: {relative}") from exc
        resolved.append((relative, destination, content))
        if destination.exists() and destination.read_text() != content:
            conflicts.append(relative)
    if conflicts and not args.force:
        raise AokError(
            "Refusing to overwrite modified or conflicting methodology scaffold files: "
            + ", ".join(str(path) for path in conflicts)
            + "; use --force to back them up"
        )

    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    backup_root = target / ".aok-backups" / timestamp
    changes: list[dict[str, str]] = []
    for relative, destination, content in resolved:
        if destination.exists() and destination.read_text() == content:
            changes.append({"path": str(relative), "status": "unchanged"})
            continue
        backup: Path | None = None
        if destination.exists():
            backup = backup_file(destination, backup_root, target)
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(content)
        change = {"path": str(relative), "status": "updated" if backup else "created"}
        if backup:
            change["backup"] = str(backup.relative_to(target))
        changes.append(change)

    result = {
        "kind": "aok-methodology-scaffold",
        "projectPath": str(target),
        "flow": profile["id"],
        "supportLevel": profile["supportLevel"],
        "selectionChanged": False,
        "lifecycleStateChanged": False,
        "counts": methodology_profile_contract(profile)["catalogCounts"],
        "files": changes,
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Scaffolded {profile['displayName']} for {target}")
        print("- methodology selection: unchanged")
        print("- lifecycle state: unchanged")
        for change in changes:
            backup = f"; backup {change['backup']}" if change.get("backup") else ""
            print(f"- {change['status']} {change['path']}{backup}")
    return 0


def load_work_item_catalog() -> dict:
    catalog = load_json(WORK_ITEM_CATALOG_PATH, {})
    if not isinstance(catalog, dict):
        raise AokError(f"Work-item catalog must be a JSON object: {WORK_ITEM_CATALOG_PATH}")
    common = catalog.get("commonSections")
    types = catalog.get("types")
    if not isinstance(common, list) or not all(isinstance(item, dict) for item in common):
        raise AokError("Work-item catalog commonSections must be an object array")
    if not isinstance(types, list) or not all(isinstance(item, dict) for item in types):
        raise AokError("Work-item catalog types must be an object array")
    return catalog


def work_item_source_path(relative: str) -> Path:
    if not isinstance(relative, str) or not relative:
        raise AokError("Work-item type has an invalid sourcePath")
    path = (WORK_ITEM_ROOT / relative).resolve()
    try:
        path.relative_to(WORK_ITEM_ROOT.resolve())
    except ValueError as exc:
        raise AokError(f"Work-item template escapes the catalog root: {relative}") from exc
    if not path.exists() or not path.is_file():
        raise AokError(f"Work-item template is missing: {path}")
    return path


def normalize_work_item_selection(
    flow: str,
    overlays: list[str] | None,
    profiles: dict[str, dict] | None = None,
) -> dict:
    profiles = profiles or load_methodology_profiles()
    profile = profiles.get(flow)
    if not profile:
        raise AokError(f"Unknown methodology flow: {flow}")
    if profile.get("kind") != "flow":
        raise AokError(f"Methodology profile {flow!r} is not a flow")
    support = profile.get("supportLevel")
    if support == "active":
        return normalize_methodology_selection(flow, overlays, profiles)
    if support == "scaffolded":
        if overlays:
            raise AokError(
                f"Methodology flow {flow!r} is scaffolded; overlays cannot be composed "
                "with scaffolded work-item exports in this slice"
            )
        return {"flow": flow, "overlays": []}
    raise AokError(
        f"Methodology flow {flow!r} is {support or 'unknown'}; "
        "only active or scaffolded flows have work-item templates"
    )


def work_item_selection_for_project(
    target: Path,
    flow: str | None,
    overlays: list[str] | None,
) -> dict:
    profiles = load_methodology_profiles()
    if flow is not None:
        return normalize_work_item_selection(flow, overlays, profiles)
    if overlays:
        raise AokError("--overlay requires an explicit --flow")
    manifest, _ = methodology_manifest(target)
    stored, _ = methodology_selection_from_manifest(manifest)
    return normalize_work_item_selection(stored["flow"], stored["overlays"], profiles)


def effective_work_item_types(catalog: dict, selection: dict) -> list[dict]:
    allowed_origins = {("core", "core"), ("flow", selection["flow"])}
    allowed_origins.update(("overlay", overlay) for overlay in selection["overlays"])
    return [
        item
        for item in catalog["types"]
        if (
            item.get("origin", {}).get("kind"),
            item.get("origin", {}).get("id"),
        )
        in allowed_origins
    ]


def work_item_sections(catalog: dict, item: dict) -> list[dict]:
    return [*catalog["commonSections"], *item["sections"]]


def render_neutral_work_item(catalog: dict, item: dict) -> str:
    source = work_item_source_path(item["sourcePath"]).read_text().strip()
    origin = item["origin"]
    lines = [
        WORK_ITEM_GENERATED_MARKER,
        f"# {item['displayName']}",
        "",
        f"AOK work-item type: `{item['id']}`",
        f"Canonical category: `{item['canonicalCategory']}`",
        f"Origin: `{origin['kind']}:{origin['id']}`",
        "",
        source,
    ]
    for section in work_item_sections(catalog, item):
        requirement = "Required" if section["required"] else "Optional"
        lines.extend(
            [
                "",
                f"## {section['label']}",
                "",
                f"<!-- {requirement}: {section['description']} -->",
                "",
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def yaml_string(value: object) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def render_github_work_item(catalog: dict, item: dict) -> str:
    source = work_item_source_path(item["sourcePath"]).read_text().strip()
    lines = [
        "# Generated by AOK work-item scaffold. Do not edit directly.",
        f"name: {yaml_string(item['displayName'])}",
        f"description: {yaml_string(item['description'])}",
        f"type: {yaml_string(item['providerMappings']['github']['issueType'])}",
        "body:",
        "  - type: markdown",
        "    attributes:",
        "      value: |-",
        f"        **AOK work-item type:** `{item['id']}`",
        "",
        f"        {item['description']}",
        "",
        *[f"        {line}" for line in source.splitlines()],
    ]
    for section in work_item_sections(catalog, item):
        control = "textarea" if section["multiline"] else "input"
        lines.extend(
            [
                f"  - type: {control}",
                f"    id: {section['id']}",
                "    attributes:",
                f"      label: {yaml_string(section['label'])}",
                f"      description: {yaml_string(section['description'])}",
            ]
        )
        if control == "textarea":
            lines.extend(["      placeholder: |-", "        Provide concrete, reviewable details."])
        else:
            lines.append(f"      placeholder: {yaml_string('Required detail')}")
        lines.extend(
            [
                "    validations:",
                f"      required: {'true' if section['required'] else 'false'}",
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def resolve_azure_requirement_type(target: Path) -> str:
    manifest = load_json(target / ".aok" / "project.json", {})
    if not isinstance(manifest, dict):
        return "$defaultRequirementWorkItemType"
    binding = manifest.get("workSystem")
    if (
        not isinstance(binding, dict)
        or binding.get("provider") != "azure-devops"
        or binding.get("supportLevel") != WORK_SYSTEM_SUPPORT_LEVEL
        or not isinstance(binding.get("verifiedAt"), str)
        or not binding.get("verifiedAt")
    ):
        return "$defaultRequirementWorkItemType"
    work_item_type = binding.get("workItemType")
    if not isinstance(work_item_type, dict):
        return "$defaultRequirementWorkItemType"
    value = work_item_type.get("name") or work_item_type.get("referenceName")
    return str(value) if value else "$defaultRequirementWorkItemType"


def render_azure_work_item(
    catalog: dict,
    item: dict,
    azure_requirement_type: str,
) -> str:
    mapping = item["providerMappings"]["azureDevOps"]["workItemType"]
    resolved = azure_requirement_type if mapping == "$defaultRequirementWorkItemType" else mapping
    source = work_item_source_path(item["sourcePath"]).read_text().strip()
    lines = [
        WORK_ITEM_GENERATED_MARKER,
        f"# {item['displayName']} — Azure DevOps",
        "",
        "> This document is desired-state guidance. It does not install or modify an Azure DevOps process or work-item template.",
        "",
        f"- AOK work-item type: `{item['id']}`",
        f"- Canonical category: `{item['canonicalCategory']}`",
        f"- Azure work-item type: `{resolved}`",
        "",
        source,
    ]
    for section in work_item_sections(catalog, item):
        requirement = "required" if section["required"] else "optional"
        lines.extend(
            [
                "",
                f"## {section['label']}",
                "",
                f"Field intent: {section['description']} ({requirement}).",
                "",
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def work_item_desired_state(
    provider: str,
    selection: dict,
    items: list[dict],
    azure_requirement_type: str,
) -> str:
    mappings: list[dict] = []
    for item in items:
        if provider == "github":
            native = item["providerMappings"]["github"]["issueType"]
        else:
            raw = item["providerMappings"]["azureDevOps"]["workItemType"]
            native = azure_requirement_type if raw == "$defaultRequirementWorkItemType" else raw
        mappings.append(
            {
                "aokType": item["id"],
                "canonicalCategory": item["canonicalCategory"],
                "providerType": native,
            }
        )
    data = {
        "generatedBy": WORK_ITEM_JSON_GENERATOR,
        "kind": f"aok-{provider}-work-item-desired-state",
        "remoteMutation": False,
        "selection": selection,
        "mappings": mappings,
    }
    if provider == "azure-devops":
        data["defaultRequirementWorkItemType"] = azure_requirement_type
    return json.dumps(data, indent=2, sort_keys=False) + "\n"


def resolve_work_item_providers(raw: str) -> tuple[str, ...]:
    if raw == "all":
        return WORK_ITEM_PROVIDERS
    if raw not in WORK_ITEM_PROVIDERS:
        raise AokError(f"Unsupported work-item provider: {raw}")
    return (raw,)


def work_item_assets(
    target: Path,
    catalog: dict,
    selection: dict,
    providers: tuple[str, ...],
) -> dict[Path, str]:
    items = effective_work_item_types(catalog, selection)
    assets: dict[Path, str] = {}
    azure_requirement_type = resolve_azure_requirement_type(target)
    if "neutral" in providers:
        for item in items:
            assets[Path("agents/tasks/types") / f"aok-{item['id']}.md"] = (
                render_neutral_work_item(catalog, item)
            )
    if "github" in providers:
        for item in items:
            assets[Path(".github/ISSUE_TEMPLATE") / f"aok-{item['id']}.yml"] = (
                render_github_work_item(catalog, item)
            )
        assets[Path("docs/aok/work-items/github/desired-state.json")] = (
            work_item_desired_state("github", selection, items, azure_requirement_type)
        )
    if "azure-devops" in providers:
        for item in items:
            assets[Path("docs/aok/work-items/azure-devops") / f"aok-{item['id']}.md"] = (
                render_azure_work_item(catalog, item, azure_requirement_type)
            )
        assets[Path("docs/aok/work-items/azure-devops/desired-state.json")] = (
            work_item_desired_state("azure-devops", selection, items, azure_requirement_type)
        )
    return assets


def content_sha256(content: str) -> str:
    return hashlib.sha256(content.encode()).hexdigest()


def load_work_item_scaffold_manifest(target: Path) -> tuple[dict | None, Path]:
    path = target / ".aok" / "work-item-scaffold.json"
    if path.is_symlink():
        raise AokError(f"Work-item scaffold manifest must not be a symlink: {path}")
    try:
        path.resolve().relative_to(target.resolve())
    except ValueError as exc:
        raise AokError(f"Work-item scaffold manifest escapes target: {path}") from exc
    if not path.exists():
        return None, path
    data = load_json(path, {})
    if not isinstance(data, dict):
        raise AokError(f"Work-item scaffold manifest must be an object: {path}")
    return data, path


def work_item_scaffold_manifest(
    catalog: dict,
    selection: dict,
    providers: tuple[str, ...],
    assets: dict[Path, str],
) -> dict:
    return {
        "generatedBy": WORK_ITEM_JSON_GENERATOR,
        "kind": "aok-work-item-scaffold-manifest",
        "catalogVersion": catalog["version"],
        "selection": selection,
        "providers": list(providers),
        "files": [
            {"path": str(path), "sha256": content_sha256(content)}
            for path, content in sorted(assets.items(), key=lambda item: str(item[0]))
        ],
    }


def work_item_file_is_generated(path: Path, expected_hash: str | None = None) -> bool:
    if not path.exists() or not path.is_file():
        return False
    content = path.read_text()
    if expected_hash and content_sha256(content) != expected_hash:
        return False
    if content.startswith(WORK_ITEM_GENERATED_MARKER) or content.startswith(
        "# Generated by AOK work-item scaffold."
    ):
        return True
    if path.suffix == ".json":
        try:
            data = json.loads(content)
            return isinstance(data, dict) and data.get("generatedBy") == WORK_ITEM_JSON_GENERATOR
        except json.JSONDecodeError:
            return False
    return False


def cmd_work_item_list(args: argparse.Namespace) -> int:
    catalog = load_work_item_catalog()
    selection: dict | None = None
    items = catalog["types"]
    if args.flow is not None:
        selection = normalize_work_item_selection(args.flow, args.overlay)
        items = effective_work_item_types(catalog, selection)
    elif args.overlay:
        raise AokError("--overlay requires --flow")
    result = {
        "kind": "aok-work-item-type-list",
        "catalogVersion": catalog["version"],
        "catalogCount": len(catalog["types"]),
        "selection": selection,
        "effectiveCount": len(items),
        "types": items,
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        if selection:
            print(f"Flow: {selection['flow']}")
            print(f"Overlays: {', '.join(selection['overlays']) or 'none'}")
        print(f"Work-item types: {len(items)}")
        for item in items:
            origin = item["origin"]
            print(
                f"- {item['id']}: {item['displayName']} "
                f"({origin['kind']}:{origin['id']} -> {item['canonicalCategory']})"
            )
    return 0


def cmd_work_item_scaffold(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    if not target.exists() or not target.is_dir():
        raise AokError(f"Target is not a directory: {target}")
    catalog = load_work_item_catalog()
    selection = work_item_selection_for_project(target, args.flow, args.overlay)
    providers = resolve_work_item_providers(args.provider)
    assets = work_item_assets(target, catalog, selection, providers)
    old_manifest, manifest_path = load_work_item_scaffold_manifest(target)
    manifest_owned = old_manifest is not None and (
        old_manifest.get("generatedBy") == WORK_ITEM_JSON_GENERATOR
        and old_manifest.get("kind") == "aok-work-item-scaffold-manifest"
    )
    old_files = {
        item.get("path"): item.get("sha256")
        for item in (old_manifest.get("files", []) if manifest_owned else [])
        if isinstance(item, dict) and isinstance(item.get("path"), str)
    }
    expected_paths = {str(path) for path in assets}
    stale_paths = sorted(set(old_files) - expected_paths)
    conflicts: list[Path] = []
    resolved: list[tuple[Path, Path, str]] = []
    for relative, content in sorted(assets.items(), key=lambda item: str(item[0])):
        destination = (target / relative).resolve()
        try:
            destination.relative_to(target)
        except ValueError as exc:
            raise AokError(f"Work-item scaffold output escapes target: {relative}") from exc
        resolved.append((relative, destination, content))
        if destination.exists() and destination.read_text() != content:
            old_hash = old_files.get(str(relative))
            if not old_hash or not work_item_file_is_generated(destination, old_hash):
                conflicts.append(relative)
    for raw in stale_paths:
        stale = (target / raw).resolve()
        try:
            stale.relative_to(target)
        except ValueError as exc:
            raise AokError(f"Recorded work-item output escapes target: {raw}") from exc
        if stale.exists() and not work_item_file_is_generated(stale, old_files.get(raw)):
            conflicts.append(Path(raw))
    if old_manifest is not None and not manifest_owned:
        conflicts.append(manifest_path.relative_to(target))
    if conflicts and not args.force:
        raise AokError(
            "Refusing to overwrite modified or conflicting work-item scaffold files: "
            + ", ".join(str(path) for path in sorted(set(conflicts), key=str))
            + "; use --force to back them up"
        )

    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")
    backup_root = target / ".aok-backups" / timestamp
    changes: list[dict[str, str]] = []
    if old_manifest is not None and not manifest_owned:
        backup = backup_file(manifest_path, backup_root, target)
        changes.append({
            "path": str(manifest_path.relative_to(target)),
            "status": "updated",
            "backup": str(backup.relative_to(target)),
        })
    for raw in stale_paths:
        stale = target / raw
        if not stale.exists():
            continue
        backup: Path | None = None
        if args.force and not work_item_file_is_generated(stale, old_files.get(raw)):
            backup = backup_file(stale, backup_root, target)
        stale.unlink()
        change = {"path": raw, "status": "removed"}
        if backup:
            change["backup"] = str(backup.relative_to(target))
        changes.append(change)
    for relative, destination, content in resolved:
        if destination.exists() and destination.read_text() == content:
            changes.append({"path": str(relative), "status": "unchanged"})
            continue
        existed = destination.exists()
        backup: Path | None = None
        old_hash = old_files.get(str(relative))
        safe_generated_update = (
            existed
            and old_hash is not None
            and work_item_file_is_generated(destination, old_hash)
        )
        if existed and not safe_generated_update:
            backup = backup_file(destination, backup_root, target)
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(content)
        change = {"path": str(relative), "status": "updated" if existed else "created"}
        if backup:
            change["backup"] = str(backup.relative_to(target))
        changes.append(change)

    scaffold_manifest = work_item_scaffold_manifest(catalog, selection, providers, assets)
    write_json(manifest_path, scaffold_manifest)
    result = {
        "kind": "aok-work-item-scaffold",
        "projectPath": str(target),
        "selection": selection,
        "providers": list(providers),
        "effectiveCount": len(effective_work_item_types(catalog, selection)),
        "projectManifestChanged": False,
        "remoteMutation": False,
        "manifestPath": str(manifest_path.relative_to(target)),
        "files": changes,
    }
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Scaffolded work-item templates for {target}")
        print(f"- flow: {selection['flow']}")
        print(f"- overlays: {', '.join(selection['overlays']) or 'none'}")
        print(f"- providers: {', '.join(providers)}")
        print("- project methodology: unchanged")
        print("- remote resources: unchanged")
        for change in changes:
            backup = f"; backup {change['backup']}" if change.get("backup") else ""
            print(f"- {change['status']} {change['path']}{backup}")
    return 0


def work_item_validation_report(target: Path) -> dict:
    target = target.resolve()
    report = {
        "kind": "aok-work-item-validation",
        "projectPath": str(target),
        "valid": True,
        "selection": None,
        "providers": [],
        "checks": [],
    }
    try:
        manifest, _ = load_work_item_scaffold_manifest(target)
    except AokError as exc:
        report["valid"] = False
        report["checks"].append({"name": "manifest", "status": "invalid", "detail": str(exc)})
        return report
    if manifest is None:
        report["valid"] = False
        report["checks"].append({"name": "manifest", "status": "missing"})
        return report
    if (
        manifest.get("generatedBy") != WORK_ITEM_JSON_GENERATOR
        or manifest.get("kind") != "aok-work-item-scaffold-manifest"
    ):
        report["valid"] = False
        report["checks"].append(
            {
                "name": "manifest",
                "status": "invalid",
                "detail": "unknown generator or manifest kind",
            }
        )
        return report
    report["checks"].append({"name": "manifest", "status": "satisfied"})
    catalog = load_work_item_catalog()
    selection = manifest.get("selection")
    providers = manifest.get("providers")
    report["selection"] = selection
    report["providers"] = providers if isinstance(providers, list) else []
    try:
        if not isinstance(selection, dict):
            raise AokError("manifest selection must be an object")
        normalized = normalize_work_item_selection(
            str(selection.get("flow", "")),
            selection.get("overlays") if isinstance(selection.get("overlays"), list) else [],
        )
        if normalized != selection:
            raise AokError("manifest selection is not normalized")
        if not isinstance(providers, list) or not providers:
            raise AokError("manifest providers must be a non-empty array")
        if len(providers) != len(set(providers)) or any(
            provider not in WORK_ITEM_PROVIDERS for provider in providers
        ):
            raise AokError("manifest providers are invalid or duplicated")
        canonical_providers = [
            provider for provider in WORK_ITEM_PROVIDERS if provider in providers
        ]
        if providers != canonical_providers:
            raise AokError("manifest providers are not in canonical order")
        expected = work_item_assets(target, catalog, normalized, tuple(providers))
        expected_manifest = work_item_scaffold_manifest(catalog, normalized, tuple(providers), expected)
        if manifest.get("catalogVersion") != catalog.get("version"):
            raise AokError("catalog version is stale")
        recorded_files = manifest.get("files")
        if recorded_files != expected_manifest["files"]:
            raise AokError("recorded file set or hashes do not match the current catalog")
        report["checks"].append({"name": "contract", "status": "satisfied"})
        for item in recorded_files:
            path = target / item["path"]
            if not path.exists():
                report["valid"] = False
                report["checks"].append({"name": item["path"], "status": "missing"})
            elif not work_item_file_is_generated(path):
                report["valid"] = False
                report["checks"].append({"name": item["path"], "status": "unmarked"})
            elif content_sha256(path.read_text()) != item["sha256"]:
                report["valid"] = False
                report["checks"].append({"name": item["path"], "status": "mismatched"})
            else:
                report["checks"].append({"name": item["path"], "status": "satisfied"})
    except AokError as exc:
        report["valid"] = False
        report["checks"].append({"name": "contract", "status": "invalid", "detail": str(exc)})
    return report


def render_work_item_validation(report: dict) -> str:
    selection = report.get("selection") or {}
    lines = [
        f"Work-item validation: {'passed' if report['valid'] else 'failed'}",
        f"Flow: {selection.get('flow', '<unknown>')}",
        f"Overlays: {', '.join(selection.get('overlays', [])) or 'none'}",
        f"Providers: {', '.join(report.get('providers', [])) or 'none'}",
    ]
    for check in report["checks"]:
        detail = f" - {check['detail']}" if check.get("detail") else ""
        lines.append(f"- {check['name']}: {check['status']}{detail}")
    return "\n".join(lines)


def cmd_work_item_validate(args: argparse.Namespace) -> int:
    report = work_item_validation_report(Path(args.path))
    print(json.dumps(report, indent=2) if args.json else render_work_item_validation(report))
    return 0 if report["valid"] else 1


def load_simple_environment_toml(path: Path) -> dict:
    if tomllib is not None:
        return tomllib.loads(path.read_text())
    data: dict[str, object] = {"actions": []}
    current_action: dict[str, str] | None = None
    in_setup = False
    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line == "[setup]":
            data.setdefault("setup", {})
            in_setup = True
            current_action = None
            continue
        if line == "[[actions]]":
            current_action = {}
            data.setdefault("actions", []).append(current_action)
            in_setup = False
            continue
        if "=" not in line:
            continue
        key, value = [part.strip() for part in line.split("=", 1)]
        parsed = value.strip('"') if value.startswith('"') and value.endswith('"') else int(value) if value.isdigit() else value
        if current_action is not None:
            current_action[key] = parsed
        elif in_setup:
            data.setdefault("setup", {})[key] = parsed
        else:
            data[key] = parsed
    return data


def resolve_targets(raw: str) -> tuple[str, ...]:
    if raw == "all":
        return SUPPORTED_TARGETS
    if raw not in SUPPORTED_TARGETS:
        raise AokError(f"Unsupported target: {raw}")
    return (raw,)


def normalize_pack_output(pack_name: str, target: str, explicit_out: Path | None, target_count: int) -> Path:
    if explicit_out is None:
        return KIT_ROOT / "build" / "renders" / pack_name / f"{target}.json"
    if explicit_out.suffix and target_count == 1:
        return explicit_out
    if explicit_out.suffix and explicit_out.name == explicit_out.stem:
        return explicit_out / f"{pack_name}.{target}.json"
    return explicit_out / f"{pack_name}.{target}.json"


def find_pack_dirs() -> list[str]:
    pack_root = KIT_ROOT / "packs"
    return sorted([path.name for path in pack_root.glob("*") if path.is_dir()])


def load_pack_manifest(pack_name: str) -> tuple[dict, Path]:
    pack_dir = KIT_ROOT / "packs" / pack_name
    manifest_path = pack_dir / "pack.json"
    if not pack_dir.exists() or not pack_dir.is_dir():
        raise AokError(f"Unknown pack: {pack_name}")
    if not manifest_path.exists():
        raise AokError(f"Missing pack manifest: {manifest_path}")
    manifest = load_json(manifest_path, {})
    if not isinstance(manifest, dict):
        raise AokError(f"Invalid pack manifest: {manifest_path}")
    if not manifest:
        raise AokError(f"Invalid pack manifest: {manifest_path}")
    return manifest, pack_dir


def load_pack_content(pack_name: str, pack_dir: Path, manifest: dict) -> tuple[dict, Path]:
    content_rel = manifest.get("neutralContent", "pack.content.json")
    content_path = pack_dir / content_rel
    if not content_path.exists():
        raise AokError(f"Missing neutral pack content file: {content_path}")
    content = load_json(content_path, {})
    if not isinstance(content, dict):
        raise AokError(f"Missing or invalid neutral pack content: {content_path}")
    return content, content_path


def user_home(raw: str | None = None) -> Path:
    return Path(raw).expanduser().resolve() if raw else Path.home()


def marketplace_paths(home: Path | None = None) -> tuple[Path, Path]:
    home = home or Path.home()
    root = home / ".agents" / "plugins"
    return root / "marketplace.json", root / "plugins" / PLUGIN_NAME


def cli_shim_path(home: Path | None = None) -> Path:
    home = home or Path.home()
    bin_dir = home / ".local" / "bin"
    return bin_dir / ("aok.cmd" if is_windows_host() else "aok")


def remove_existing_path(path: Path) -> None:
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink()


def plugin_dir_looks_valid(path: Path) -> bool:
    manifest_path = path / ".codex-plugin" / "plugin.json"
    if not manifest_path.exists():
        return False
    try:
        data = json.loads(manifest_path.read_text())
    except json.JSONDecodeError:
        return False
    return data.get("name") == PLUGIN_NAME


def create_windows_junction(link_path: Path, target: Path) -> bool:
    result = subprocess.run(
        ["cmd", "/c", "mklink", "/J", str(link_path), str(target)],
        text=True,
        capture_output=True,
        check=False,
    )
    return result.returncode == 0


def ensure_plugin_path(link_path: Path, replace: bool) -> str:
    current_matches = False
    existing_mode = ""
    if link_path.exists() or link_path.is_symlink():
        try:
            current_matches = link_path.resolve() == KIT_ROOT
        except OSError:
            current_matches = False
        if current_matches:
            return "symlink" if link_path.is_symlink() else "junction"
        if is_windows_host() and plugin_dir_looks_valid(link_path):
            existing_mode = "copy"
            current_matches = True
        if current_matches:
            return existing_mode
        if not replace:
            raise AokError(f"Refusing to replace existing plugin path: {link_path}")
        remove_existing_path(link_path)

    if not is_windows_host():
        link_path.symlink_to(KIT_ROOT, target_is_directory=True)
        return "symlink"

    if create_windows_junction(link_path, KIT_ROOT):
        return "junction"
    shutil.copytree(KIT_ROOT, link_path)
    return "copy"


def windows_cli_shim_text(target_script: Path) -> str:
    target = str(target_script)
    return (
        "@echo off\n"
        "setlocal\n"
        "where py >nul 2>nul\n"
        "if %ERRORLEVEL%==0 (\n"
        f'  py -3 "{target}" %*\n'
        ") else (\n"
        f'  python "{target}" %*\n'
        ")\n"
    )


def ensure_cli_shim(home: Path, replace: bool) -> tuple[Path, str]:
    bin_dir = home / ".local" / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)

    if not is_windows_host():
        bin_link = bin_dir / "aok"
        if bin_link.exists() or bin_link.is_symlink():
            if not (bin_link.is_symlink() and bin_link.resolve() == KIT_ROOT / "scripts" / "aok"):
                if replace:
                    remove_existing_path(bin_link)
                    bin_link.symlink_to(KIT_ROOT / "scripts" / "aok")
                else:
                    raise AokError(f"Refusing to replace existing executable: {bin_link}")
        else:
            bin_link.symlink_to(KIT_ROOT / "scripts" / "aok")
        return bin_link, "symlink"

    bin_link = bin_dir / "aok.cmd"
    shim_text = windows_cli_shim_text(KIT_ROOT / "scripts" / "aok")
    if bin_link.exists():
        if bin_link.read_text().replace("\r\n", "\n") != shim_text:
            if not replace:
                raise AokError(f"Refusing to replace existing executable: {bin_link}")
            bin_link.unlink()
            bin_link.write_text(shim_text, newline="\r\n")
    else:
        bin_link.write_text(shim_text, newline="\r\n")

    legacy_unix_shim = bin_dir / "aok"
    if legacy_unix_shim.exists() or legacy_unix_shim.is_symlink():
        if replace:
            remove_existing_path(legacy_unix_shim)
    return bin_link, "cmd"


def cmd_install(args: argparse.Namespace) -> int:
    home = user_home(getattr(args, "home", None))
    replace = bool(getattr(args, "replace", False))
    missing = [name for name in ("codex",) if not command_exists(name)]
    if missing:
        print(f"Warning: missing optional commands: {', '.join(missing)}", file=sys.stderr)
        print("Install continues; `aok doctor` reports optional capabilities separately.", file=sys.stderr)

    marketplace, link_path = marketplace_paths(home)
    link_path.parent.mkdir(parents=True, exist_ok=True)
    plugin_mode = ensure_plugin_path(link_path, replace)

    data = load_json(
        marketplace,
        {"name": MARKETPLACE_NAME, "interface": {"displayName": MARKETPLACE_DISPLAY}, "plugins": []},
    )
    data.setdefault("name", MARKETPLACE_NAME)
    data.setdefault("interface", {}).setdefault("displayName", MARKETPLACE_DISPLAY)
    plugins = data.setdefault("plugins", [])
    entry = {
        "name": PLUGIN_NAME,
        "source": {"source": "local", "path": f"./plugins/{PLUGIN_NAME}"},
        "policy": {"installation": "AVAILABLE", "authentication": "ON_INSTALL"},
        "category": "Productivity",
    }
    for idx, plugin in enumerate(plugins):
        if plugin.get("name") == PLUGIN_NAME:
            plugins[idx] = entry
            break
    else:
        plugins.append(entry)
    write_json(marketplace, data)

    bin_link, shim_mode = ensure_cli_shim(home, replace)

    print(f"Registered plugin in {marketplace}")
    print(f"Plugin path ({plugin_mode}): {link_path} -> {KIT_ROOT}")
    print(f"CLI path ({shim_mode}): {bin_link}")
    return 0


def collect_doctor(home: Path | None = None) -> dict:
    home = home or Path.home()
    required_files = [
        KIT_ROOT / ".codex-plugin" / "plugin.json",
        KIT_ROOT / "hooks.json",
        KIT_ROOT / "templates" / "AGENTS.md",
        KIT_ROOT / "templates" / "agents" / "workflow.md",
        KIT_ROOT / "templates" / "agents" / "methodology.md",
        KIT_ROOT / "templates" / ".codex" / "setup.sh",
        KIT_ROOT / "templates" / ".codex" / "aok-action.sh",
        KIT_ROOT / "templates" / ".codex" / "aok-local-environment.json",
        KIT_ROOT / "templates" / ".codex" / "environments" / "environment.toml",
        KIT_ROOT / "docs" / "codex-local-environments.md",
        KIT_ROOT / "docs" / "methodology-profiles.md",
        KIT_ROOT / "scripts" / "aok",
    ]
    marketplace, link_path = marketplace_paths(home)
    cli_path = cli_shim_path(home)
    plugin_ok = link_path.exists() and (
        link_path.resolve() == KIT_ROOT or (is_windows_host() and plugin_dir_looks_valid(link_path))
    )
    commands = {
        name: {
            "ok": command_exists(name),
            "path": shutil.which(name),
            "required": False,
        }
        for name in ("git", "gh", "codex")
    }
    files = [
        {
            "path": str(path),
            "relativePath": str(path.relative_to(KIT_ROOT)),
            "ok": path.exists(),
        }
        for path in required_files
    ]
    install = {
        "marketplace": {
            "path": str(marketplace),
            "ok": marketplace.exists(),
        },
        "pluginPath": {
            "path": str(link_path),
            "ok": plugin_ok,
            "target": str(KIT_ROOT),
        },
        "cliShim": {
            "path": str(cli_path),
            "ok": cli_path.exists(),
        },
    }
    codex_local_environment = collect_codex_local_env(KIT_ROOT / "templates")
    required_ok = (
        all(item["ok"] for item in files)
        and install["marketplace"]["ok"]
        and install["pluginPath"]["ok"]
        and codex_local_environment["templatesOk"]
    )
    return {
        "kind": "aok-doctor-report",
        "version": plugin_version(),
        "kitRoot": str(KIT_ROOT),
        "home": str(home),
        "status": "ok" if required_ok else "needs-attention",
        "requiredOk": required_ok,
        "commands": commands,
        "files": files,
        "install": install,
        "codexLocalEnvironment": codex_local_environment,
        "nextActions": [] if required_ok else ["Run the AOK installer again or check the marketplace/plugin paths."],
    }


def doctor_report_text(report: dict) -> str:
    lines = [
        "# Agent Operating Kit Setup Report",
        "",
        f"Status: {report['status']}",
        f"Kit root: {report['kitRoot']}",
        f"Home: {report['home']}",
        "",
        "## Required Files",
    ]
    for item in report["files"]:
        lines.append(f"- {'OK' if item['ok'] else 'FAIL'} {item['relativePath']}")
    lines.extend(["", "## Installation"])
    for label, item in report["install"].items():
        lines.append(f"- {'OK' if item['ok'] else 'FAIL'} {label}: {item['path']}")
    lines.extend(["", "## Codex Local Environment"])
    local_env = report["codexLocalEnvironment"]
    lines.append(f"- {'OK' if local_env['templatesOk'] else 'FAIL'} templates: {local_env['projectPath']}")
    lines.append(f"- config schema status: {local_env['codexGeneratedConfig']['status']}")
    for item in local_env["files"]:
        lines.append(f"- {'OK' if item['ok'] else 'FAIL'} {item['relativePath']}")
    lines.extend(["", "## Optional Commands"])
    for name, item in report["commands"].items():
        detail = item["path"] or "not found"
        lines.append(f"- {'OK' if item['ok'] else 'MISSING'} {name}: {detail}")
    if report["nextActions"]:
        lines.extend(["", "## Next Actions"])
        for action in report["nextActions"]:
            lines.append(f"- {action}")
    return "\n".join(lines) + "\n"


def cmd_doctor(args: argparse.Namespace) -> int:
    report = collect_doctor(user_home(getattr(args, "home", None)))
    if getattr(args, "report", None):
        out = Path(args.report).expanduser()
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(doctor_report_text(report))
        print(f"Wrote setup report: {out}")
    if getattr(args, "json", False):
        print(json.dumps(report, indent=2))
    else:
        for name, item in report["commands"].items():
            print_result(f"optional command {name}", bool(item["ok"]), item["path"] or "not found")
        for item in report["files"]:
            print_result(item["relativePath"], bool(item["ok"]))
        install = report["install"]
        print_result("marketplace", install["marketplace"]["ok"], install["marketplace"]["path"])
        print_result("plugin path", install["pluginPath"]["ok"], install["pluginPath"]["path"])
        print_result("CLI shim", install["cliShim"]["ok"], install["cliShim"]["path"])
        local_env = report["codexLocalEnvironment"]
        print_result("Codex local environment templates", local_env["templatesOk"], local_env["projectPath"])
    return 0 if report["requiredOk"] else 1


def cmd_codex_setup(args: argparse.Namespace) -> int:
    install_args = argparse.Namespace(home=args.home, replace=args.replace)
    cmd_install(install_args)

    home = user_home(getattr(args, "home", None))
    report_path = None
    if getattr(args, "report", None):
        report_path = Path(args.report).expanduser()
    doctor_args = argparse.Namespace(home=str(home), json=False, report=str(report_path) if report_path else None)
    doctor_code = cmd_doctor(doctor_args)

    project_path = None
    if getattr(args, "project", None):
        project_path = Path(args.project).resolve()
        cmd_project_init(argparse.Namespace(path=str(project_path), force=args.force_project_init))
        cmd_project_validate(argparse.Namespace(path=str(project_path)))
        cmd_codex_local_env_validate(argparse.Namespace(path=str(project_path), json=False))

    if getattr(args, "claude", False):
        cmd_claude_setup(
            argparse.Namespace(
                home=args.home,
                settings=args.claude_settings,
                marketplace_path=args.claude_marketplace_path,
                enable=args.enable,
            )
        )

    print("Codex setup summary:")
    print(f"- install: {'updated' if args.replace else 'checked'} user registration")
    print(f"- doctor: {'ok' if doctor_code == 0 else 'needs-attention'}")
    if project_path is not None:
        print(f"- project: initialized and validated {project_path}")
    else:
        print("- project: skipped")
    if getattr(args, "claude", False):
        enabled = ", ".join(enabled_pack_names(args.enable))
        print(f"- claude: enabled marketplace plugins ({enabled})")
    else:
        print("- claude: skipped")

    return 0 if doctor_code == 0 else 1


def detect_workspace_kind(target: Path) -> str:
    if (target / ".git").exists():
        return "single-repo"
    child_repos = [p for p in target.iterdir() if p.is_dir() and (p / ".git").exists()]
    return "multi-repo" if child_repos else "plain-directory"


def backup_file(path: Path, backup_root: Path, target: Path) -> Path:
    rel = path.relative_to(target)
    dest = backup_root / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, dest)
    return dest


def unified_diff(old: str, new: str, old_label: str, new_label: str) -> str:
    return "".join(
        difflib.unified_diff(
            old.splitlines(keepends=True),
            new.splitlines(keepends=True),
            fromfile=old_label,
            tofile=new_label,
        )
    )


def copy_template_tree(target: Path, methodology: dict, force: bool = False) -> list[str]:
    template_root = KIT_ROOT / "templates"
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    backup_root = target / ".aok-backups" / timestamp
    changes: list[str] = []

    for src in sorted(template_root.rglob("*")):
        if src.is_dir():
            continue
        rel = src.relative_to(template_root)
        if rel == Path("agents/methodology.md"):
            continue
        dest = target / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        new_text = src.read_text()
        if not dest.exists():
            dest.write_text(new_text)
            if os.access(src, os.X_OK):
                dest.chmod(0o755)
            changes.append(f"created {rel}")
            continue
        old_text = dest.read_text()
        if old_text == new_text:
            changes.append(f"unchanged {rel}")
            continue
        if rel == Path("AGENTS.md") and not force:
            proposed = target / "AGENTS.aok-proposed.md"
            proposed.write_text(new_text)
            diff_path = target / "AGENTS.aok.diff"
            diff_path.write_text(unified_diff(old_text, new_text, "AGENTS.md", "AGENTS.aok-proposed.md"))
            changes.append(f"preserved AGENTS.md; wrote {proposed.name} and {diff_path.name}")
            continue
        backup = backup_file(dest, backup_root, target)
        dest.write_text(new_text)
        if os.access(src, os.X_OK):
            dest.chmod(0o755)
        changes.append(f"updated {rel}; backup {backup.relative_to(target)}")

    meta = target / ".aok"
    meta.mkdir(exist_ok=True)
    manifest_path = meta / "project.json"
    existing_manifest = load_json(manifest_path, {})
    if not isinstance(existing_manifest, dict):
        raise AokError(f"Project manifest must be a JSON object: {manifest_path}")
    manifest = dict(existing_manifest)
    manifest.update({
        "initializedAt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "workspaceKind": detect_workspace_kind(target),
        "kitVersion": plugin_version(),
        "methodology": methodology,
    })
    write_json(manifest_path, manifest)
    changes.append("wrote .aok/project.json")
    return changes


def plugin_version() -> str:
    manifest = json.loads((KIT_ROOT / ".codex-plugin" / "plugin.json").read_text())
    return str(manifest.get("version", "unknown"))


def cmd_project_init(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    if not target.exists() or not target.is_dir():
        raise AokError(f"Target is not a directory: {target}")
    profiles = load_methodology_profiles()
    requested_flow = getattr(args, "flow", None)
    requested_overlays = getattr(args, "overlay", None)
    if requested_flow is None and requested_overlays:
        raise AokError("--overlay requires an explicit --flow")
    existing_manifest, _ = methodology_manifest(target)
    if requested_flow is None:
        existing_selection, _ = methodology_selection_from_manifest(existing_manifest)
        selection = normalize_methodology_selection(
            existing_selection["flow"], existing_selection["overlays"], profiles
        )
    else:
        selection = normalize_methodology_selection(requested_flow, requested_overlays, profiles)
    methodology_policy_is_safe(target, selection, force=args.force, profiles=profiles)
    changes = copy_template_tree(target, methodology=selection, force=args.force)
    changes.append(
        write_methodology_policy(
            target,
            selection,
            force=args.force,
            prechecked=True,
            profiles=profiles,
        )
    )
    print(f"Initialized {target}")
    print(f"Workspace kind: {detect_workspace_kind(target)}")
    for change in changes:
        print(f"- {change}")
    return 0


def validate_project(path: Path) -> list[str]:
    missing = []
    required = [
        "AGENTS.md",
        "agents/workflow.md",
        "agents/github-project.md",
        "agents/hooks.md",
        "agents/tasks/task-template.md",
        "agents/roles/orchestrator.md",
        "agents/roles/implementer.md",
        "agents/roles/qa-reality-checker.md",
        "agents/roles/code-reviewer.md",
        ".codex/config.toml",
        ".codex/setup.sh",
        ".codex/aok-action.sh",
        ".codex/aok-local-environment.json",
        ".codex/environments/environment.toml",
    ]
    for rel in required:
        if not (path / rel).exists():
            missing.append(rel)
    local_env = collect_codex_local_env(path)
    for item in local_env["files"]:
        if item["ok"] and item["executable"] is False:
            missing.append(f"{item['relativePath']} must be executable")
    if (path / ".codex" / "aok-local-environment.json").exists() and not local_env["manifest"]["ok"]:
        missing.append(".codex/aok-local-environment.json must be a valid AOK Codex local-environment manifest")
    for action in local_env["missingActions"]:
        missing.append(f".codex/aok-local-environment.json missing action {action}")
    for action in local_env.get("invalidActions", []):
        missing.append(f".codex/aok-local-environment.json invalid action {action}")
    methodology_report = methodology_validation_report(path)
    if not methodology_report["valid"]:
        for check in methodology_report["checks"]:
            if check["status"] not in ("satisfied", "implicit-default"):
                detail = f": {check['detail']}" if check.get("detail") else ""
                missing.append(f"methodology {check['name']} {check['status']}{detail}")
    return missing


def cmd_project_validate(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    missing = validate_project(target)
    if missing:
        print("Project validation failed. Missing:")
        for rel in missing:
            print(f"- {rel}")
        return 1
    print(f"Project validation passed: {target}")
    return 0


def copy_codex_local_env_templates(target: Path, force: bool = False) -> list[str]:
    template_root = KIT_ROOT / "templates"
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    backup_root = target / ".aok-backups" / timestamp
    changes: list[str] = []
    for rel_raw in CODEX_LOCAL_ENV_REQUIRED:
        rel = Path(rel_raw)
        src = template_root / rel
        dest = target / rel
        if not src.exists():
            raise AokError(f"Missing Codex local-environment template: {src}")
        dest.parent.mkdir(parents=True, exist_ok=True)
        new_text = src.read_text()
        if not dest.exists():
            dest.write_text(new_text)
            if os.access(src, os.X_OK):
                dest.chmod(0o755)
            changes.append(f"created {rel}")
            continue
        old_text = dest.read_text()
        if old_text == new_text:
            changes.append(f"unchanged {rel}")
            continue
        if not force:
            proposed = dest.with_name(f"{dest.name}.aok-proposed")
            proposed.write_text(new_text)
            diff_path = dest.with_name(f"{dest.name}.aok.diff")
            diff_path.write_text(unified_diff(old_text, new_text, str(rel), str(proposed.relative_to(target))))
            changes.append(f"preserved {rel}; wrote {proposed.relative_to(target)} and {diff_path.relative_to(target)}")
            continue
        backup = backup_file(dest, backup_root, target)
        dest.write_text(new_text)
        if os.access(src, os.X_OK):
            dest.chmod(0o755)
        changes.append(f"updated {rel}; backup {backup.relative_to(target)}")
    return changes


def load_codex_local_env_manifest(path: Path) -> dict:
    manifest_path = path / ".codex" / "aok-local-environment.json"
    data = load_json(manifest_path, {})
    if not isinstance(data, dict):
        raise AokError(f"Invalid Codex local-environment manifest: {manifest_path}")
    return data


def collect_codex_local_env(path: Path) -> dict:
    project = path.resolve()
    files = []
    for rel in CODEX_LOCAL_ENV_REQUIRED:
        item = project / rel
        files.append(
            {
                "path": str(item),
                "relativePath": rel,
                "ok": item.exists(),
                "executable": item.exists() and os.access(item, os.X_OK) if rel.endswith(".sh") else None,
            }
        )
    manifest_path = project / ".codex" / "aok-local-environment.json"
    manifest: dict = {}
    manifest_ok = False
    manifest_error = None
    if manifest_path.exists():
        try:
            manifest = json.loads(manifest_path.read_text())
            manifest_ok = manifest.get("kind") == "aok-codex-local-environment"
        except json.JSONDecodeError as exc:
            manifest_error = str(exc)
    actions = manifest.get("actions", []) if isinstance(manifest, dict) else []
    action_names = [item.get("name") for item in actions if isinstance(item, dict)]
    missing_actions = [name for name in CODEX_LOCAL_ENV_ACTIONS if name not in action_names]
    invalid_actions = []
    for action in actions:
        if not isinstance(action, dict):
            invalid_actions.append("<non-object>")
            continue
        name = action.get("name", "<unnamed>")
        if not action.get("command"):
            invalid_actions.append(str(name))
    environment_path = project / ".codex" / "environments" / "environment.toml"
    environment_ok = False
    environment_error = None
    environment_actions: list[str] = []
    environment_setup = None
    if environment_path.exists():
        try:
            environment_data = load_simple_environment_toml(environment_path)
            environment_setup = (environment_data.get("setup") or {}).get("script")
            environment_actions = [
                str(item.get("name"))
                for item in environment_data.get("actions", [])
                if isinstance(item, dict) and item.get("name") and item.get("command")
            ]
            environment_ok = (
                environment_data.get("version") == 1
                and environment_setup == ".codex/setup.sh"
                and not [name for name in CODEX_LOCAL_ENV_ACTIONS if name not in environment_actions]
            )
        except Exception as exc:  # noqa: BLE001 - validation should report parse errors, not crash
            environment_error = str(exc)
    setup_default = (manifest.get("setupScripts") or {}).get("default") if isinstance(manifest, dict) else None
    codex_generated_config = manifest.get("codexGeneratedConfig", {}) if isinstance(manifest, dict) else {}
    templates_ok = (
        all(item["ok"] for item in files)
        and all(item["executable"] is not False for item in files)
        and manifest_ok
        and environment_ok
        and not missing_actions
        and not invalid_actions
        and setup_default == ".codex/setup.sh"
    )
    return {
        "kind": "aok-codex-local-environment-report",
        "projectPath": str(project),
        "docs": CODEX_LOCAL_ENV_DOCS_URL,
        "templatesOk": templates_ok,
        "files": files,
        "manifest": {
            "path": str(manifest_path),
            "ok": manifest_ok,
            "error": manifest_error,
            "version": manifest.get("version") if isinstance(manifest, dict) else None,
        },
        "setupScript": setup_default,
        "environmentToml": {
            "path": str(environment_path),
            "ok": environment_ok,
            "error": environment_error,
            "setupScript": environment_setup,
            "actions": environment_actions,
        },
        "actions": actions,
        "missingActions": missing_actions,
        "invalidActions": invalid_actions,
        "codexGeneratedConfig": codex_generated_config
        or {
            "status": "unknown",
            "reason": "No AOK Codex local-environment manifest was found.",
        },
    }


def cmd_codex_local_env_init(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    if not target.exists() or not target.is_dir():
        raise AokError(f"Target is not a directory: {target}")
    changes = copy_codex_local_env_templates(target, force=args.force)
    print(f"Initialized Codex local environment: {target}")
    for change in changes:
        print(f"- {change}")
    print("Register .codex/setup.sh and .codex/aok-action.sh actions in Codex App settings.")
    return 0


def cmd_codex_local_env_validate(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    report = collect_codex_local_env(target)
    if getattr(args, "json", False):
        print(json.dumps(report, indent=2))
    else:
        for item in report["files"]:
            detail = item["path"]
            if item["executable"] is False:
                detail = f"{detail} (not executable)"
            print_result(item["relativePath"], bool(item["ok"]) and item["executable"] is not False, detail)
        print_result("manifest", report["manifest"]["ok"], report["manifest"]["path"])
        print_result("environment.toml", report["environmentToml"]["ok"], report["environmentToml"]["path"])
        for missing in report["missingActions"]:
            print_result(f"action {missing}", False)
        for invalid in report["invalidActions"]:
            print_result(f"action {invalid}", False, "missing command")
        print_result("Codex generated config schema", True, report["codexGeneratedConfig"].get("status", "unknown"))
    return 0 if report["templatesOk"] else 1


def cmd_codex_local_env_actions(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    report = collect_codex_local_env(target)
    if report["missingActions"]:
        raise AokError(f"Codex local-environment actions are incomplete: {', '.join(report['missingActions'])}")
    if report["invalidActions"]:
        raise AokError(f"Codex local-environment actions are malformed: {', '.join(report['invalidActions'])}")
    for action in report["actions"]:
        print(f"{action['name']}: {action['command']}")
    return 0


def render_swarmd_projection(task: dict, roles: list[dict]) -> dict:
    callsign = task.get("assigneeRole")
    assignee = "implementer"
    if callsign:
        for role in roles:
            if role.get("id") == callsign:
                assignee = role.get("callsign", role.get("name", role.get("id")))
                break
    assignee = str(assignee or "implementer")
    title = task.get("title", task.get("id", "unnamed task"))
    spec = task.get("spec", task.get("description", ""))
    return {
        "task.create": {
            "title": title,
            "spec": spec,
            "assignee": assignee,
            "phase": task.get("phase", "planned"),
        },
        "memory.put": {
            "namespace": "decision",
            "key": f"{title.lower().replace(' ', '-')}-decision",
            "content": task.get("defaultDecision", f"Follow neutral AOK process for {title}."),
        },
        "event.append": {
            "type": "aok.task.packet.generated",
            "actor": assignee,
            "payload": {
                "taskPacket": task.get("id", title),
                "status": task.get("status", "pending"),
            },
        },
    }


def render_pack_payload(pack_name: str, pack_manifest: dict, content: dict, target: str) -> dict:
    roles = content.get("roles", [])
    skills = content.get("skills", [])
    hooks = content.get("hooks", [])
    templates = content.get("templates", [])
    task_packets = content.get("taskPackets", [])
    task_projection = [
        {
            **task,
            "swarmd": render_swarmd_projection(task, roles),
        }
        for task in task_packets
    ]

    base = {
        "kind": "aok-pack-render",
        "version": pack_manifest.get("version", "0.1.0"),
        "pack": {
            "name": pack_name,
            "sourceRepo": pack_manifest.get("sourceRepo"),
            "kind": pack_manifest.get("kind", "pack"),
            "description": pack_manifest.get("description"),
            "supportedTargets": pack_manifest.get("supportedTargets", []),
            "concepts": pack_manifest.get("concepts", []),
        },
        "source": {
            "manifest": f"packs/{pack_name}/pack.json",
            "content": f"packs/{pack_name}/{pack_manifest.get('neutralContent', 'pack.content.json')}",
        },
        "target": target,
        "renderedAt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "roles": roles,
        "hooks": hooks,
        "skills": skills,
        "templates": templates,
        "taskPackets": task_projection,
        "targetRender": pack_manifest.get("targetRender", {}).get(target, {}),
        "concepts": {
            "roles": [item.get("id") for item in roles if isinstance(item, dict) and item.get("id")],
            "hooks": [item.get("id") for item in hooks if isinstance(item, dict) and item.get("id")],
            "skills": [item.get("id") for item in skills if isinstance(item, dict) and item.get("id")],
            "templates": [item.get("id") for item in templates if isinstance(item, dict) and item.get("id")],
            "taskPackets": [item.get("id") for item in task_packets if isinstance(item, dict) and item.get("id")],
        },
    }

    if target == "claude-code":
        plugin_path = KIT_ROOT / "packs" / pack_name / "claude-code" / "plugin.json"
        plugin = {}
        if plugin_path.exists():
            plugin = load_json(plugin_path, {})
        return {
            **base,
            "targetContract": "claude-code-toolbox-compatible",
            "pluginJson": plugin,
            "compatibility": {
                "hookContracts": "hook commands and plugin.json",
                "skillContracts": [item.get("sourcePath") for item in skills if isinstance(item, dict)],
            },
        }

    if target == "codex":
        return {
            **base,
            "targetContract": "codex-agent",
            "notes": ["Rendered into Codex JSON contract for local adoption."],
            "mcpConfig": {
                "mcpServers": {
                    "swarmd": {
                        "command": "swarmd",
                        "args": ["mcp"],
                    }
                }
            },
        }

    return {
        **base,
        "targetContract": f"{target}-agent",
        "notes": [f"Rendered as structured JSON contract for {target}."],
    }


def cmd_render_pack(args: argparse.Namespace) -> int:
    targets = resolve_targets(args.target)
    manifest, pack_dir = load_pack_manifest(args.pack)
    pack_name = manifest.get("name") or args.pack
    content, _ = load_pack_content(pack_name, pack_dir, manifest)
    for target in targets:
        out = normalize_pack_output(pack_name, target, Path(args.out) if args.out else None, len(targets))
        rendered = render_pack_payload(pack_name, manifest, content, target)
        write_json(out, rendered)
        print(f"Wrote render: {out}")
    return 0


def cmd_render_all(args: argparse.Namespace) -> int:
    targets = resolve_targets(args.target)
    pack_dirs = find_pack_dirs()
    if not pack_dirs:
        raise AokError("No packs found.")

    output_root = Path(args.out) if args.out else (KIT_ROOT / "build" / "renders")
    for pack_name in pack_dirs:
        manifest_path = KIT_ROOT / "packs" / pack_name / "pack.json"
        if not manifest_path.exists():
            continue
        manifest = load_json(manifest_path, {})
        if not isinstance(manifest, dict):
            continue
        content, _ = load_pack_content(pack_name, manifest_path.parent, manifest)
        for target in targets:
            out_dir = output_root / target
            out = out_dir / f"{pack_name}.json"
            rendered = render_pack_payload(pack_name, manifest, content, target)
            write_json(out, rendered)
            print(f"Wrote render: {out}")
    return 0


def item_id(item: dict, fallback: str) -> str:
    value = str(item.get("id") or item.get("name") or fallback)
    return re.sub(r"[^a-zA-Z0-9_.-]+", "-", value).strip("-") or fallback


def write_bundle_item_files(bundle_dir: Path, section: str, items: list[dict]) -> list[str]:
    written: list[str] = []
    if not items:
        return written
    section_dir = bundle_dir / section
    section_dir.mkdir(parents=True, exist_ok=True)
    for idx, item in enumerate(items, start=1):
        if not isinstance(item, dict):
            continue
        rel = Path(section) / f"{item_id(item, f'{section}-{idx}')}.json"
        write_json(bundle_dir / rel, item)
        written.append(str(rel))
    return written


def markdown_list(title: str, items: list[dict], fields: tuple[str, ...]) -> str:
    lines = [f"# {title}", ""]
    if not items:
        lines.append("No items.")
        return "\n".join(lines) + "\n"
    for item in items:
        if not isinstance(item, dict):
            continue
        lines.append(f"## {item.get('name') or item.get('title') or item.get('id')}")
        lines.append("")
        for field in fields:
            value = item.get(field)
            if value is None:
                continue
            if isinstance(value, list):
                lines.append(f"- {field}: {', '.join(str(part) for part in value)}")
            elif isinstance(value, dict):
                lines.append(f"- {field}: `{json.dumps(value, sort_keys=True)}`")
            else:
                lines.append(f"- {field}: {value}")
        lines.append("")
    return "\n".join(lines)


def copy_bundle_source(base: Path, rel: str, bundle_dir: Path, copied: list[str]) -> None:
    src_raw = Path(os.path.abspath(base / rel))
    root = KIT_ROOT.resolve()
    src = src_raw.resolve(strict=True)
    try:
        source_rel = src.relative_to(root)
        lexical_rel = src_raw.relative_to(root)
    except ValueError as exc:
        raise AokError(f"Refusing to copy source outside kit root: {rel}") from exc
    _reject_source_symlinks(root, lexical_rel)
    dest = bundle_dir / "sources" / source_rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        _validate_support_tree(src)
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(src, dest, ignore=_support_ignore, symlinks=False)
    else:
        if not stat.S_ISREG(src.stat().st_mode):
            raise AokError(f"Refusing special bundle source: {rel}")
        shutil.copy2(src, dest)
    copied.append(str(Path("sources") / source_rel))


def _skip_support_name(name: str) -> bool:
    return name in {".git", ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", "dist", "build", "coverage"} or name.startswith(".coverage") or name.endswith((".egg-info", ".pyc", ".pyo"))


def _support_ignore(directory: str, names: list[str]) -> set[str]:
    return {name for name in names if _skip_support_name(name)}


def _validate_support_tree(root: Path) -> None:
    for current, dirs, files in os.walk(root, followlinks=False):
        dirs[:] = [name for name in dirs if not _skip_support_name(name)]
        for name in [*dirs, *files]:
            path = Path(current) / name
            mode = path.lstat().st_mode
            if stat.S_ISLNK(mode) or not (stat.S_ISDIR(mode) or stat.S_ISREG(mode)):
                raise AokError(f"Refusing unsafe bundle source: {path}")


def _reject_source_symlinks(root: Path, rel: Path) -> None:
    current = root
    for part in rel.parts:
        if part == "..":
            current = current.parent
            continue
        current = current / part
        if current.is_symlink():
            raise AokError(f"Refusing symlink bundle source: {current}")


def write_skill_reference_wrappers(bundle_dir: Path, pack_name: str, skill_root: str, skills: list, host_dir: Path) -> list[str]:
    files: list[str] = []
    for skill in skills:
        if not isinstance(skill, dict):
            continue
        slug = _cursor_slug(str(skill.get("id") or skill.get("name") or "skill"))
        source = str(skill.get("sourcePath") or f"{skill_root}/{slug}/SKILL.md")
        rel = host_dir / slug / "SKILL.md"
        guide = Path(os.path.relpath(bundle_dir / "sources" / "packs" / pack_name / source, (bundle_dir / rel).parent))
        description = str(skill.get("description") or slug).replace('"', "'")
        body = f'---\nname: {slug}\ndescription: "{description}"\n---\n\nRead the canonical bundled guide at [{slug}]({guide.as_posix()}).\n'
        target = bundle_dir / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(body)
        files.append(rel.as_posix())
    return files

def bundle_readme(pack_name: str, target: str, support_level: str) -> str:
    return f"""# {pack_name} for {target}

This bundle was generated by Agent Operating Kit.

- Pack: `{pack_name}`
- Target: `{target}`
- Support level: `{support_level}`
- Contract: `aok-bundle.json`

Use this directory as the importable, self-contained representation of the AOK
pack for the target. Native target installers may consume the same contract and
included source files.
"""



def _cursor_slug(raw: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", (raw or "").strip().lower()).strip("-")
    return s or "item"


def write_cursor_native_tree(bundle_dir: Path, pack_dir: Path, content: dict) -> list[str]:
    """Emit .cursor/rules, .cursor/skills, and a non-executable hooks checklist."""
    files: list[str] = []
    roles = content.get("roles") or []
    if isinstance(roles, list) and roles:
        rules_dir = bundle_dir / ".cursor" / "rules"
        rules_dir.mkdir(parents=True, exist_ok=True)
        for role in roles:
            if not isinstance(role, dict):
                continue
            slug = _cursor_slug(str(role.get("id") or role.get("callsign") or role.get("name") or "role"))
            rel = f".cursor/rules/{slug}.mdc"
            name = str(role.get("name") or role.get("callsign") or role.get("id") or "Role")
            callsign = str(role.get("callsign") or role.get("id") or "")
            desc = f"AOK role: {name}"
            if callsign and callsign != name:
                desc = f"AOK role: {name} ({callsign})"
            lines = ["---", f"description: {desc!r}", "alwaysApply: false", "---", "", f"# {name}", ""]
            if callsign:
                lines.extend([f"Callsign: `{callsign}`", ""])
            resp = role.get("responsibilities") or []
            if isinstance(resp, list) and resp:
                lines.append("## Responsibilities")
                lines.append("")
                for item in resp:
                    lines.append(f"- {item}")
                lines.append("")
            esc = role.get("escalation") or {}
            if isinstance(esc, dict) and esc:
                lines.append("## Escalation")
                lines.append("")
                if "ifBlockedBy" in esc:
                    lines.append(f"- If blocked by: {esc['ifBlockedBy']}")
                notify = esc.get("notify") or []
                if isinstance(notify, list) and notify:
                    lines.append("- Notify: " + " ".join(f"`{n}`" for n in notify))
                lines.append("")
            lines.append("Generated by Agent Operating Kit from pack role content.")
            lines.append("")
            (bundle_dir / rel).write_text("\n".join(lines))
            files.append(rel)

    skills = content.get("skills") or []
    if isinstance(skills, list):
        for skill in skills:
            if not isinstance(skill, dict):
                continue
            slug = _cursor_slug(str(skill.get("id") or skill.get("name") or "skill"))
            skill_dir = bundle_dir / ".cursor" / "skills" / slug
            skill_dir.mkdir(parents=True, exist_ok=True)
            rel = f".cursor/skills/{slug}/SKILL.md"
            name = str(skill.get("name") or skill.get("id") or slug)
            desc = str(skill.get("description") or f"AOK skill {name}")
            body = None
            source = skill.get("sourcePath")
            if isinstance(source, str) and source:
                src = pack_dir / source
                if src.is_file():
                    src_text = src.read_text()
                    if src_text.lstrip().startswith("---"):
                        parts = src_text.lstrip().split("---", 2)
                        if len(parts) >= 3:
                            fm_lines = []
                            have_name = have_desc = False
                            for line in parts[1].splitlines():
                                trim = line.strip()
                                if trim.startswith("name:"):
                                    fm_lines.append(f"name: {slug}")
                                    have_name = True
                                else:
                                    fm_lines.append(line)
                                    if trim.startswith("description:"):
                                        have_desc = True
                            if not have_name:
                                fm_lines.insert(0, f"name: {slug}")
                            if not have_desc:
                                fm_lines.append(f"description: {desc!r}")
                            body = "---\n" + "\n".join(fm_lines) + "\n---" + parts[2]
                    if body is None:
                        body = f"---\nname: {slug}\ndescription: {desc!r}\n---\n\n{src_text}"
                        if not body.endswith("\n"):
                            body += "\n"
            if body is None:
                lines = [
                    "---",
                    f"name: {slug}",
                    f"description: {desc!r}",
                    "---",
                    "",
                    f"# {name}",
                    "",
                    desc,
                    "",
                    "Generated by Agent Operating Kit from pack skill content.",
                    "",
                ]
                inputs = skill.get("inputs") or {}
                if isinstance(inputs, dict) and inputs:
                    lines.append("## Inputs")
                    lines.append("")
                    for k, v in inputs.items():
                        lines.append(f"- `{k}`: {v}")
                body = "\n".join(lines) + "\n"
            (bundle_dir / rel).write_text(body)
            files.append(rel)

    hooks = content.get("hooks") or []
    if isinstance(hooks, list) and hooks:
        rel = ".cursor/hooks-checklist.md"
        lines = [
            "# Cursor hooks checklist (non-executable)",
            "",
            "AOK emits this file as **operator guidance**, not as",
            "`.cursor/hooks.json`. Pack hooks often reference Claude Code",
            "plugin paths (`CLAUDE_PLUGIN_ROOT`) and are not Cursor hook",
            "scripts. Map manually or keep as a pre/after checklist.",
            "",
        ]
        for hook in hooks:
            if not isinstance(hook, dict):
                continue
            name = str(hook.get("name") or hook.get("id") or "hook")
            lines.append(f"## {name}")
            lines.append("")
            if hook.get("event"):
                lines.append(f"- Event: `{hook['event']}`")
            if hook.get("severity"):
                lines.append(f"- Severity: `{hook['severity']}`")
            if hook.get("description"):
                lines.append(f"- Description: {hook['description']}")
            if hook.get("command"):
                lines.append(f"- Source command (not auto-wired): `{hook['command']}`")
            lines.append("")
        (bundle_dir / rel).write_text("\n".join(lines))
        files.append(rel)
    return files


def render_target_bundle(pack_name: str, target: str, out_dir: Path) -> Path:
    manifest, pack_dir = load_pack_manifest(pack_name)
    pack_name = manifest.get("name") or pack_name
    if "skillRoot" in manifest and not _valid_skill_root(pack_dir, manifest["skillRoot"]):
        raise AokError(f"Invalid skillRoot in packs/{pack_name}/pack.json")
    content, _ = load_pack_content(pack_name, pack_dir, manifest)
    if manifest.get("skillRoot"):
        for skill in content.get("skills", []):
            guide = skill.get("sourcePath") or f"{manifest['skillRoot']}/{_cursor_slug(str(skill.get('id') or skill.get('name') or 'skill'))}/SKILL.md"
            path = Path(guide)
            if not isinstance(guide, str) or not re.fullmatch(r"[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*", guide) or any(part in (".", "..") for part in guide.split("/")) or not guide.startswith(manifest["skillRoot"] + "/"):
                raise AokError("Unsafe canonical skill guide")
            _reject_source_symlinks(pack_dir, path)
            if not (pack_dir / path).is_file():
                raise AokError("Missing canonical skill guide")
    bundle_dir = out_dir / target / pack_name
    if bundle_dir.exists():
        shutil.rmtree(bundle_dir)
    bundle_dir.mkdir(parents=True, exist_ok=True)

    rendered = render_pack_payload(pack_name, manifest, content, target)
    target_render = manifest.get("targetRender", {}).get(target, {})
    support_level = target_render.get("supportLevel") or target_render.get("status", "generated")
    source_files: list[str] = []
    source_refs = set()
    for refs in (manifest.get("sourceRefs") or {}).values():
        if isinstance(refs, list):
            source_refs.update(ref for ref in refs if isinstance(ref, str))
    for ref in target_render.get("sourceRefs", []) if isinstance(target_render, dict) else []:
        if isinstance(ref, str):
            source_refs.add(ref)
    if manifest.get("skillRoot"):
        source_refs.add(".")
    for ref in sorted(source_refs):
        copy_bundle_source(pack_dir, ref, bundle_dir, source_files)

    sections = {
        "roles": content.get("roles", []),
        "hooks": content.get("hooks", []),
        "skills": content.get("skills", []),
        "templates": content.get("templates", []),
        "task-packets": content.get("taskPackets", []),
    }
    item_files: list[str] = []
    for section, items in sections.items():
        if isinstance(items, list):
            item_files.extend(write_bundle_item_files(bundle_dir, section, items))

    (bundle_dir / "roles.md").write_text(markdown_list("Roles", content.get("roles", []), ("callsign", "responsibilities", "escalation")))
    (bundle_dir / "hooks.md").write_text(markdown_list("Hooks", content.get("hooks", []), ("event", "matcher", "command", "severity", "description")))
    (bundle_dir / "skills.md").write_text(markdown_list("Skills", content.get("skills", []), ("description", "sourcePath", "inputs")))
    (bundle_dir / "tasks.md").write_text(markdown_list("Task Packets", content.get("taskPackets", []), ("title", "phase", "assigneeRole", "verification")))

    native_files: list[str] = []
    if target == "codex":
        plugin = {
            "name": f"aok-{pack_name}",
            "version": manifest.get("version", "0.1.0"),
            "description": manifest.get("description", ""),
            "aokPack": pack_name,
        }
        if manifest.get("skillRoot"):
            plugin["skills"] = f"./sources/packs/{pack_name}/{manifest['skillRoot']}/"
        write_json(
            bundle_dir / ".codex-plugin" / "plugin.json",
            plugin,
        )
    elif target == "claude-code":
        claude_src = pack_dir / "claude-code"
        if claude_src.exists() and not manifest.get("skillRoot"):
            shutil.copytree(claude_src, bundle_dir / "claude-code")
        if manifest.get("skillRoot"):
            native_files.extend(write_skill_reference_wrappers(bundle_dir, pack_name, manifest["skillRoot"], content.get("skills", []), Path("skills")))
            write_json(bundle_dir / ".claude-plugin" / "plugin.json", {"name": pack_name, "version": manifest.get("version", "0.1.0"), "description": manifest.get("description", ""), "skills": ["./skills"]})
    elif target == "cursor":
        write_json(
            bundle_dir / "import.json",
            {
                "kind": "aok-target-import",
                "target": target,
                "pack": pack_name,
                "contract": "aok-bundle.json",
                "readme": "README.md",
            },
        )
        native_files = write_cursor_native_tree(bundle_dir, pack_dir, content)
        if manifest.get("skillRoot"):
            native_files.extend(write_skill_reference_wrappers(bundle_dir, pack_name, manifest["skillRoot"], content.get("skills", []), Path(".cursor") / "skills"))
    else:
        write_json(
            bundle_dir / "import.json",
            {
                "kind": "aok-target-import",
                "target": target,
                "pack": pack_name,
                "contract": "aok-bundle.json",
                "readme": "README.md",
            },
        )

    bundle = {
        "kind": "aok-bundle",
        "version": manifest.get("version", "0.1.0"),
        "pack": pack_name,
        "target": target,
        "supportLevel": support_level,
        "generatedAt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "contract": rendered,
        "files": sorted(["README.md", "roles.md", "hooks.md", "skills.md", "tasks.md", *item_files, *source_files, *native_files]),
        "sourceContentIncluded": True,
    }
    if manifest.get("skillRoot"):
        bundle["resourcePaths"] = {"canonicalSkills": f"sources/packs/{pack_name}/{manifest['skillRoot']}", "claudeSkills": "skills", "cursorSkills": ".cursor/skills"}
    write_json(bundle_dir / "aok-bundle.json", bundle)
    (bundle_dir / "README.md").write_text(bundle_readme(pack_name, target, support_level))
    return bundle_dir


def write_bundle_index(root: Path, bundles: list[Path]) -> Path:
    entries = []
    for bundle in sorted(bundles):
        contract = bundle / "aok-bundle.json"
        if not contract.exists():
            continue
        data = load_json(contract, {})
        entries.append(
            {
                "pack": data.get("pack"),
                "target": data.get("target"),
                "supportLevel": data.get("supportLevel"),
                "path": str(bundle.relative_to(root)),
                "contract": str((bundle / "aok-bundle.json").relative_to(root)),
            }
        )
    index = {
        "kind": "aok-bundle-index",
        "version": plugin_version(),
        "generatedAt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "bundles": entries,
    }
    out = root / "index.json"
    write_json(out, index)
    return out


def cmd_render_bundle(args: argparse.Namespace) -> int:
    targets = resolve_targets(args.target)
    output_root = Path(args.out) if args.out else (KIT_ROOT / "build" / "bundles")
    bundles = []
    for target in targets:
        bundle = render_target_bundle(args.pack, target, output_root)
        bundles.append(bundle)
        print(f"Wrote bundle: {bundle}")
    index = write_bundle_index(output_root, bundles)
    print(f"Wrote bundle index: {index}")
    return 0


def cmd_render_bundles(args: argparse.Namespace) -> int:
    targets = resolve_targets(args.target)
    output_root = Path(args.out) if args.out else (KIT_ROOT / "build" / "bundles")
    bundles = []
    for pack_name in find_pack_dirs():
        if not (KIT_ROOT / "packs" / pack_name / "pack.json").exists():
            continue
        for target in targets:
            bundle = render_target_bundle(pack_name, target, output_root)
            bundles.append(bundle)
            print(f"Wrote bundle: {bundle}")
    index = write_bundle_index(output_root, bundles)
    print(f"Wrote bundle index: {index}")
    return 0


ISSUE_RE = re.compile(r"github\.com/(?P<owner>[^/]+)/(?P<repo>[^/]+)/issues/(?P<num>\d+)")
PR_RE = re.compile(r"github\.com/(?P<owner>[^/]+)/(?P<repo>[^/]+)/pull/(?P<num>\d+)")


def parse_github_ref(ref: str) -> tuple[str, str, str, str] | None:
    for kind, regex in (("issue", ISSUE_RE), ("pr", PR_RE)):
        match = regex.search(ref)
        if match:
            return kind, match.group("owner"), match.group("repo"), match.group("num")
    return None


def gh_view(ref: str) -> dict:
    parsed = parse_github_ref(ref)
    if not parsed:
        raise AokError("Only GitHub issue and PR URLs are supported by this local CLI implementation.")
    kind, owner, repo, num = parsed
    full_repo = f"{owner}/{repo}"
    if kind == "issue":
        cmd = [
            "gh",
            "issue",
            "view",
            num,
            "--repo",
            full_repo,
            "--comments",
            "--json",
            "title,body,labels,state,comments,assignees,milestone,projectItems,url",
        ]
    else:
        cmd = [
            "gh",
            "pr",
            "view",
            num,
            "--repo",
            full_repo,
            "--comments",
            "--json",
            "title,body,state,headRefName,baseRefName,files,commits,checks,reviews,comments,url",
        ]
    result = run(cmd)
    data = json.loads(result.stdout)
    data["_kind"] = kind
    data["_repo"] = full_repo
    data["_number"] = num
    return data


def cmd_task_sync(args: argparse.Namespace) -> int:
    data = gh_view(args.ref)
    print(json.dumps(data, indent=2))
    return 0


def extract_section(body: str, heading: str) -> str:
    pattern = re.compile(rf"^##\s+{re.escape(heading)}\s*$", re.IGNORECASE | re.MULTILINE)
    match = pattern.search(body or "")
    if not match:
        return ""
    start = match.end()
    next_heading = re.search(r"^##\s+", body[start:], re.MULTILINE)
    end = start + next_heading.start() if next_heading else len(body)
    return body[start:end].strip()


def task_packet_markdown(data: dict) -> str:
    body = data.get("body") or ""
    problem = extract_section(body, "Problem") or data.get("title", "")
    scope = extract_section(body, "Scope")
    criteria = extract_section(body, "Acceptance Criteria")
    target_repo = extract_section(body, "Target Repo") or data.get("_repo", "")
    verification = extract_section(body, "Verification")
    risks = extract_section(body, "Risks / Blockers")
    url = data.get("url", "")
    kind = data.get("_kind", "item")
    issue = url if kind == "issue" else ""
    pr = url if kind == "pr" else ""

    return f"""# Agent Task Packet

## Metadata

| Field | Value |
|---|---|
| Project Item | |
| Issue | {issue} |
| Pull Request | {pr} |
| Target Repo | {target_repo} |
| Branch | |
| Status | |
| Phase | |
| Priority | |
| Attempt | 0 |
| Primary Agent | |
| QA Agent | |

## Problem

{problem}

## Scope

{scope or "In scope:\n-\n\nOut of scope:\n-"}

## Acceptance Criteria

{criteria or "- [ ]"}

## Context

Relevant files:
-

Relevant docs:
-

Dependencies:
-

Risks / Blockers:
{risks or "-"}

## Pre-Hook Results

- `pre_project_sync`:
- `pre_scope_check`:
- `pre_agent_select`:
- `pre_worktree`:
- `pre_risk_check`:

## Implementation Notes

## Verification Plan

{verification or "Commands or evidence required:\n-"}

## QA Verdict

Verdict: `PENDING`

Evidence:
-

Failures:
-

## GitHub Update Log

-

## Final Summary
"""


def cmd_task_packet(args: argparse.Namespace) -> int:
    data = gh_view(args.ref)
    packet = task_packet_markdown(data)
    if args.output:
        out = Path(args.output)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(packet)
        print(f"Wrote {out}")
    else:
        print(packet)
    return 0


def read_packet(path: str) -> str:
    packet_path = Path(path)
    if not packet_path.exists():
        raise AokError(f"Task packet not found: {packet_path}")
    return packet_path.read_text()


def section_present(text: str, heading: str) -> bool:
    return re.search(rf"^##\s+{re.escape(heading)}\s*$", text, re.MULTILINE) is not None


def section_has_content(text: str, heading: str) -> bool:
    content = extract_section(text, heading)
    stripped = re.sub(r"[-\[\]\s`:_|]", "", content)
    return bool(stripped)


def cmd_hooks_pre(args: argparse.Namespace) -> int:
    text = read_packet(args.packet)
    checks = {
        "Problem": section_has_content(text, "Problem"),
        "Acceptance Criteria": section_has_content(text, "Acceptance Criteria"),
        "Verification Plan": section_has_content(text, "Verification Plan"),
        "Metadata": section_present(text, "Metadata"),
    }
    target_repo_ok = bool(re.search(r"\|\s*Target Repo\s*\|\s*[^|\s][^|]*\|", text))
    checks["Target Repo"] = target_repo_ok
    failed = [name for name, ok in checks.items() if not ok]
    if failed:
        print("Pre-hooks failed. Missing or incomplete:")
        for name in failed:
            print(f"- {name}")
        return 1
    print("Pre-hooks passed.")
    print("- pre_project_sync: packet present")
    print("- pre_scope_check: required scope fields present")
    print("- pre_agent_select: role fields available")
    print("- pre_worktree: run repo-local git checks before edits")
    print("- pre_risk_check: inspect risks before implementation")
    return 0


def cmd_hooks_after(args: argparse.Namespace) -> int:
    text = read_packet(args.packet)
    has_qa = "Verdict: `PENDING`" not in text and "Verdict:" in text
    has_summary = section_has_content(text, "Final Summary") or section_has_content(text, "Implementation Notes")
    if not has_summary:
        print("After-hooks warning: final summary or implementation notes are still empty.")
    print("## Agent Update")
    print()
    print("Status:")
    print("Agent:")
    print("Summary:")
    print("Verification:")
    print("Evidence:")
    print("Next:")
    print("Blockers:")
    if not has_qa:
        print()
        print("Warning: QA verdict is still pending.", file=sys.stderr)
    return 0


def candidate_history_files(path: Path) -> list[Path]:
    names = []
    for pattern in ("**/*.md", "**/*.txt", "**/*.log"):
        names.extend(path.glob(pattern))
    ignored_parts = {".git", "node_modules", "dist", "build", ".venv", "__pycache__"}
    result = []
    for item in sorted(set(names)):
        if any(part in ignored_parts for part in item.parts):
            continue
        if item.is_file() and item.stat().st_size <= 500_000:
            result.append(item)
    return result


def summarize_history(path: Path) -> str:
    keywords = (
        "Agent Update",
        "Acceptance Criteria",
        "Verification",
        "QA",
        "Verdict:",
        "GitHub Update",
        "Final Summary",
        "Blocker",
        "Escalation",
    )
    lines = ["# Agent History Import", ""]
    lines.append(f"Source: {path}")
    lines.append("")
    files = candidate_history_files(path)
    matched = 0
    for file_path in files:
        text = file_path.read_text(errors="ignore")
        hits = [kw for kw in keywords if kw.lower() in text.lower()]
        if not hits:
            continue
        matched += 1
        rel = file_path.relative_to(path)
        title_match = re.search(r"^#\s+(.+)$", text, re.MULTILINE)
        title = title_match.group(1).strip() if title_match else rel.name
        lines.append(f"## {rel}")
        lines.append("")
        lines.append(f"- Title: {title}")
        lines.append(f"- Signals: {', '.join(hits)}")
        first_update = re.search(r"^##\s+Agent Update\s*$", text, re.IGNORECASE | re.MULTILINE)
        if first_update:
            lines.append("- Contains agent update block")
        final_summary = extract_section(text, "Final Summary")
        if final_summary:
            compact = " ".join(final_summary.split())[:240]
            lines.append(f"- Final summary excerpt: {compact}")
        lines.append("")
    lines.append("## Result")
    lines.append("")
    lines.append(f"- Scanned files: {len(files)}")
    lines.append(f"- Matched files: {matched}")
    lines.append("- Hidden chat/session memory was not used.")
    return "\n".join(lines) + "\n"


def cmd_import_history(args: argparse.Namespace) -> int:
    source = Path(args.path).resolve()
    if not source.exists() or not source.is_dir():
        raise AokError(f"Source is not a directory: {source}")
    report = summarize_history(source)
    if args.output:
        out = Path(args.output)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(report)
        print(f"Wrote {out}")
    else:
        print(report)
    return 0


def enabled_pack_names(raw: list[str]) -> list[str]:
    if not raw or raw == ["all"]:
        return [CLAUDE_ROOT_PLUGIN, *find_pack_dirs()]
    allowed = {CLAUDE_ROOT_PLUGIN, *find_pack_dirs()}
    unknown = sorted(set(raw) - allowed)
    if unknown:
        raise AokError(f"Unknown Claude plugin or pack(s): {', '.join(unknown)}")
    return raw


def cmd_claude_setup(args: argparse.Namespace) -> int:
    home = user_home(getattr(args, "home", None))
    settings_path = Path(args.settings).expanduser() if args.settings else home / ".claude" / "settings.json"
    marketplace_path = (
        Path(args.marketplace_path).expanduser().resolve()
        if args.marketplace_path
        else (KIT_ROOT / "adapters" / "claude-code" / "marketplace").resolve()
    )
    if not marketplace_path.exists():
        raise AokError(f"Claude Code marketplace path does not exist: {marketplace_path}")

    settings_path.parent.mkdir(parents=True, exist_ok=True)
    if settings_path.exists():
        backup = settings_path.with_name(
            f"{settings_path.name}.aok-backup-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}"
        )
        shutil.copy2(settings_path, backup)
    else:
        backup = None

    data = load_json(settings_path, {})
    if not isinstance(data, dict):
        raise AokError(f"Claude Code settings must be a JSON object: {settings_path}")
    marketplaces = data.setdefault("extraKnownMarketplaces", {})
    if not isinstance(marketplaces, dict):
        raise AokError("extraKnownMarketplaces must be an object")
    marketplaces[CLAUDE_MARKETPLACE_NAME] = {
        "source": {
            "source": "directory",
            "path": str(marketplace_path),
        }
    }

    enabled = data.setdefault("enabledPlugins", {})
    if not isinstance(enabled, dict):
        raise AokError("enabledPlugins must be an object")
    for pack in enabled_pack_names(args.enable):
        enabled[f"{pack}@{CLAUDE_MARKETPLACE_NAME}"] = True

    write_json(settings_path, data)
    print(f"Updated Claude Code settings: {settings_path}")
    if backup:
        print(f"Backup: {backup}")
    print(f"Marketplace: {CLAUDE_MARKETPLACE_NAME} -> {marketplace_path}")
    return 0


def require_json(path: Path, errors: list[str]) -> dict | None:
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        errors.append(f"{path.relative_to(KIT_ROOT)}: missing")
    except json.JSONDecodeError as exc:
        errors.append(f"{path.relative_to(KIT_ROOT)}: invalid JSON: {exc}")
    return None


